ClangFormatRequest :: struct {
	filepath:     string;
	src:          string;
	buffer_index: s32;
	buffer_hash:  u32;
}

ClangFormatResponse :: struct {
	src:          string;
	buffer_index: s32;
	buffer_hash:  u32;
}

request_format :: fn (buf: *Buffer) Error {
	if buf.file_type != FileType.C {
		return error("Buffer '%' is not recognized as C/C++ source file.", buf.name);
	}
	if buf.bytes.len == 0 then return OK;

	// set buffer temporarily as readonly
	buf.flags |= BufferFlags.READONLY;
	job_index :: start_async_job(JobKind.CLANG_FORMAT, "clang-format", &worker);

	ctx :: get_job_context(job_index);

	request := make_request(ctx) catch return $;
	request.as.clang_format = .{
		filepath     = str_make(buf.filepath, request.allocator),
		src          = str_make(buf.bytes, request.allocator),
		buffer_index = buf.index,
		buffer_hash  = buf.hash,
	};

	push_request(ctx, &request);
	return OK;
}

apply_format :: fn (job_state: JobContext.state, response: *Response) Error {
	check_main_thread();
	rd :: &response.as.clang_format;

	// If clang-format took long time, it's possible the target buffer was removed or
	// the buffer slot was reused for a different file...
	buf :: &buffers[rd.buffer_index];
	if buf.is_removed             { return OK; }
	if buf.hash != rd.buffer_hash { return OK; }
	clr_flag(&buf.flags, BufferFlags.READONLY);
	if job_state == JobContext.state.DONE then change_content(buf, rd.src);
	return OK;
}

#scope_private

get_clang_format_executable :: fn () string_view {
	if settings.clang_format_executable.len > 0 then return settings.clang_format_executable;
	#if PLATFORM == .WINDOWS {
		return "clang-format.exe";
	} else {
		return "clang-format";
	}
}

worker :: fn (ctx: *JobContext) s32 {
	using JobContext.state;

	// wait for request
	request: Request #noinit;
	loop !pop_request(ctx, &request) {
		os_sleep_ms(10);
	}
	defer terminate_request(ctx, &request);

	set_job_progress_indicator(ctx, true);
	defer set_job_progress_indicator(ctx, false);

	response := make_response(ctx) catch {
		print_err("clang-format: %", $);
		ctx.state = FAILED;
		return 1;
	};

	response.as.clang_format = .{
		buffer_index = request.as.clang_format.buffer_index,
		buffer_hash  = request.as.clang_format.buffer_hash,
		src          = str_make(request.as.clang_format.src.len, response.allocator),
	};

	// We need to unlock the file and do other stuff even in case execution failed...
	defer push_response(ctx, &response);

	executable :: get_clang_format_executable();
	args       :: [_]string_view.{ tprint("--assume-filename=\"%\"", request.as.clang_format.filepath) };
	start_process(ctx, executable, args) catch {
		if $.code == ERR_NOT_FOUND {
			print_err("clang-format: Cannot find '%' executable. Path to the executable must be included in your PATH environment variable.", executable);
		} else {
			print_err("clang-format: Cannot execute '%' with error: %", executable, $);
		}
		ctx.state = FAILED;
		return 1;
	};

	defer stop_process(ctx);

	write_pipe(ctx.stdin, request.as.clang_format.src) catch {
		print_err("clang-format: The '%' failed with error: %", executable, $);
		ctx.state = FAILED;
		return 1;
	};

	// Submit the source to the clang-format.
	close_pipe(&ctx.stdin);

	loop !ctx.kill {
		state :: poll_process(ctx) catch {
			print_err("clang-format: The '%' failed with error: %", executable, $);
			ctx.state = FAILED;
			return 1;
		};

		using PollEvent;
		if is_flag(state, READ) {
			read_pipe(ctx.stdout, &response.as.clang_format.src) catch {
				print_err("clang-format: The '%' failed with error: %", executable, $);
				ctx.state = FAILED;
				return 1;
			};
		}
		if is_flag(state, CLOSED) {
			print_log("Closed");
			ctx.state = DONE;
			return 0;
		}
		os_sleep_ms(10);
	}

	ctx.state = KILLED;
	return 0;
}
