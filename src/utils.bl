// Does not support new lines (might be OK in some cases).
count_unicode_characters :: fn (str: string_view) s32 {
	count: s32;
	loop i := 0; i < str.len; {
		l :: get_character_len(str[i]);
		i += math.max(1, l); // To prevent looping!
		count += 1;
	}
	return count;
}

get_default_line_ending_for_platform :: fn () string_view #inline {
#if PLATFORM == Platform.WINDOWS {
	return "\r\n";
} else {
	return "\n";
}
}

is_under_directory :: fn (directory: string_view, filepath: string_view) bool #inline {
	root :: string_view.{ math.min(filepath.len, directory.len), filepath.ptr };
	return str_match(root, directory);
}

get_timestamp :: fn () s64 {
	c_time :: fn (destTime: *s64) s64 #extern "time";
	return c_time(null);
}

unicode_char_to_utf8_with_fallback :: fn (c: u32, fallback: string_view = "?") string_view #inline {
	tmp :: str_make(4, application_context.temporary_allocator);
	err :: utf32_to_utf8_single_char(c, &tmp);
	if err {
		print_err(err);
		return fallback;
	}
	return tmp;
}

get_file_hash :: fn (filepath: string_view) u32 {
	tmp :: str_make(filepath, application_context.temporary_allocator);
	#if PLATFORM == Platform.WINDOWS {
		str_lower(&tmp);
	}
	str_replace_all(&tmp, '\\', '/');
	return str_hash(tmp);
}

draw_shadow :: fn (x: f32, y: f32, w: f32, h: f32) {
	using draw;
	s := metrics.shadow_size;

	set_shader_color();
	inner_color :: rgba(0x00000040);
	outer_color :: rgba(0x0);

	rect_rounded(x - s, y - s, w + 2.f * s, h + 2.f * s, s*2.f, inner_color, outer_color);
}

compute_command_panel_layout :: fn (prefer_width: s32 = 0) (x: f32, y: f32, w: f32, h: f32, content_start_y: f32, content_max_h: f32) {
	window_h := cast(f32) WINDOW_HEIGHT;
	window_w := cast(f32) WINDOW_WIDTH;

	panel_offset_y :: metrics.command_panel_offset_y;
	max_w          :: if prefer_width > 0 then cast(f32) prefer_width else metrics.list_panel_max_width;
	f              :: metrics.list_panel_factor;
	max_h          :: math.max(math.ceil(window_h - panel_offset_y * 2.f), 0.f);

	_, command_editor_h :: get_command_editor_size();
	notif_area_h        :: command_editor_h;

	w               :: math.ceil(math.min(window_w * f, max_w));
	h               :: command_editor_h + notif_area_h;
	x               :: math.ceil(window_w/2.f - w/2.f);
	y               :: panel_offset_y;
	content_start_y :: y + command_editor_h;
	content_max_h   :: math.clamp(max_h - h, 0.f, max_h);

	return x, y, w, h, content_start_y, content_max_h;
}

draw_simple_command_editor_panel :: fn (cmd_params: DrawCommandEditorParams, hints: []PanelHint = .{}) #inline {
	x, y, w, h, content_start_y :: compute_command_panel_layout();
	draw_command_editor_panel(x, y, w, h);

	cmd_h :: y+h-content_start_y;

	assert(workspace.active_editor == workspace.command_editor);
	draw_command_editor(workspace.command_editor, x, y, w, cmd_h, cmd_params);
	draw_command_panel_hints(x, y+h-cmd_h, w, cmd_h, hints, metrics.command_panel_hints_alpha);
}

draw_panel_body :: fn (x: f32, y: f32, w: f32, h: f32, rounding: f32) {
	using draw;
	border_line_width   :: metrics.border_line_width;
	fg_color            :: colors.panel_outline;
	bg_color            :: colors.background;

	draw_shadow(x, y, w, h);

	set_shader_color();
	rect_rounded(x, y, w, h, rounding, fg_color, fg_color);
	rect_rounded(x+border_line_width, y+border_line_width, w-border_line_width*2.f, h-border_line_width*2.f, rounding, bg_color, bg_color);
}

draw_command_editor_panel :: fn (x: f32, y: f32, w: f32, h: f32, progress_t := 0.f) {
	using draw;

	_, command_editor_h :: get_command_editor_size();
	notif_area_h        :: command_editor_h;
	border_line_width   :: metrics.border_line_width;
	rounding            :: metrics.corner_rounding_panel;
	fg_color            :: colors.panel_outline;

	draw_panel_body(x, y, w, h, rounding);

	set_shader_color();
	// Separator
	elem_y := y + command_editor_h;
	rect(x, elem_y, w, border_line_width, fg_color);

	if progress_t > 0.f { // Progress
		progress_bar_color :: colors.progress_bar;
		progress_w :: w * progress_t;
		rect(x+border_line_width, elem_y-border_line_width, progress_w-border_line_width, border_line_width, progress_bar_color);

		redraw();
	}

	elem_y = y + h - notif_area_h;
	rect(x, elem_y, w, border_line_width, fg_color);
}

calculate_keybind_cell_width :: fn (key_mapping: []string_view) f32 #inline {
	using draw;
	text_padding :: metrics.text_ui_padding;

	total_w := 0.f;
	loop i := 0; i < key_mapping.len; i += 1 {
		text_w :: text_size(key_mapping[i], &font_ui_small);
		cell_w :: text_w + text_padding*2.f;

		total_w += cell_w + text_padding*0.5f;
	}
	return total_w;
}

draw_keybind_cells :: fn (x: f32, y: f32, item_h: f32, key_mapping: []string_view, base_alpha := 1.f) f32 {
	using draw;

	text_padding :: metrics.text_ui_padding;
	rounding     :: metrics.corner_rounding;
	hint_height  :: metrics.line_ui_height * 1.2f;

	hx := x;
	total_w := 0.f;
	loop i := 0; i < key_mapping.len; i += 1 {
		text_w :: text_size(key_mapping[i], &font_ui_small);
		cell_w :: text_w + text_padding*2.f;

		offset_x :: cell_w + text_padding*0.5f;

		box_offset_y  :: item_h / 2.f - hint_height / 2.f;
		text_offset_y :: item_h / 2.f;

		body_color := colors.foreground;
		text_color := colors.foreground;
		body_color.w = math.max(base_alpha - 0.8f, 0.1f);
		text_color.w = math.max(base_alpha, 0.2f);

		set_shader_color();
		rect_rounded(hx, y + box_offset_y, cell_w, hint_height, rounding, body_color, body_color);

		set_shader_font(&font_ui_small);
		text(hx + text_padding, y + text_offset_y, key_mapping[i], text_color);

		hx += offset_x;
		total_w += offset_x;
	}

	return total_w;
}

PanelHint :: struct {
	command: Command;
	info:    string_view;
}

draw_command_panel_hint :: fn (x: f32, y: f32, w: f32, h: f32, hint: PanelHint, base_alpha := 1.f) #inline {
	draw_command_panel_hints(x, y, w, h, [1]PanelHint.{ hint }, base_alpha);
}

draw_command_panel_hints :: fn (x: f32, y: f32, w: f32, h: f32, hints: []PanelHint, base_alpha := 1.f) {
	using draw;

	text_padding :: metrics.text_ui_padding;

	color   := colors.foreground;
	color.w = 0.4f;

	set_scissor(x+text_padding, y, w-text_padding*2.f, h);
	defer clear_scissor();
	defer flush();

	hx := x + text_padding;
	loop i := 0; i < hints.len; i += 1 {
		hint :: &hints[i];
		key_mapping :: get_keybinding_for_command(hint.command);

		cells_w :: draw_keybind_cells(hx, y, h, [_]string_view.{ key_mapping }, base_alpha);
		hx += cells_w;

		set_shader_font(&font_ui_small);
		tw :: text_size(hints[i].info, &font_ui_small);
		text_offset_y :: h / 2.f;

		text(hx, y + text_offset_y, hints[i].info, color);
		hx += tw + text_padding * 2.f;
	}
}

is_ident :: fn (buf: *Buffer, char: string_view) bool #inline {
	NON_IDENT_CHARS :: " ()[]{}.-+:;\"\',!@#$%^&*~`<>/?\t\r\n";

	if char.len == 0              { return false; }
	if is_line_end(buf, char) > 0 { return false; }
	loop i := 0; i < NON_IDENT_CHARS.len; i += 1 {
		if char[0] == NON_IDENT_CHARS[i] { return false; }
	}
	return true;
}

is_number :: fn (buf: *Buffer, char: string_view, base := FmtIntBase.DEC) bool #inline {
	NUMERIC_CHARS := "0123456789";
	using FmtIntBase;
	switch base {
		HEX { NUMERIC_CHARS = "0123456789abcdefABCDEF"; }
		OCT { NUMERIC_CHARS = "012345"; }
		BIN { NUMERIC_CHARS = "01"; }
		default;
	}

	if char.len == 0              { return false; }
	if is_line_end(buf, char) > 0 { return false; }
	loop i := 0; i < NUMERIC_CHARS.len; i += 1 {
		if char[0] == NUMERIC_CHARS[i] then return true;
	}
	return false;
}

is_whitespace :: fn (char: u8) bool #inline {
	WHITESPACE :: " \t\n\r";
	loop i := 0; i < WHITESPACE.len; i += 1 {
		if char == WHITESPACE[i] { return true; }
	}
	return false;
}

is_one_of :: fn (char: u8, other: string_view) bool #inline {
	loop i := 0; i < other.len; i += 1 {
		if char == other[i] then return true;
	}
	return false;
}

insert_all :: fn (tbl: *?T, v: []string_view) #inline {
	loop i := 0; i < v.len; i += 1 {
		tbl_insert(tbl, v[i], 0);
	}
}

str_match_ignore_case :: fn (a: string_view, b: string_view) bool {
	if a.len != b.len { return false; }
	loop i := 0; i < a.len; i += 1 {
		if a[i] == b[i] { continue; }
		if C.tolower(auto a[i]) == C.tolower(auto b[i]) { continue; }
		return false;
	}
	return true;
}

is_point_in_rect :: fn (rx: f32, ry: f32, rw: f32, rh: f32, px: f32, py: f32) bool #inline {
	rxw :: rx + rw;
	ryh :: ry + rh;
	return px > rx && px < rxw && py > ry && py < ryh;
}

get_icon_for_buffer :: fn (buf: *Buffer) string_view {
	if buf.index == shell.buffer_index {
		return icon(ICON_SHELL);
	} else if buf.index == search_buffer_index {
		return icon(ICON_SEARCH);
	} else if buf.index == help_buffer_index {
		return icon(ICON_HELP);
	} else if buf.index == messages_buffer_index {
		return icon(ICON_MESSAGES);
	}
	return get_icon_for_file_type(buf.file_type);
}

expand_position_to_whole_line :: fn (buf: string_view, index: s64, max_distance := 120) string_view {
	begin := index;
	end   := index;
	distance := 0;
	loop i := index; i > 0 && distance < max_distance; i -= 1 {
		c :: buf[i-1];
		if c == '\n' { break; }
		begin    -= 1;
		distance += 1;
	}
	loop i := index; i < buf.len && distance < max_distance; i += 1 {
		c :: buf[i];
		if c == '\n' || c == '\r' { break; }
		end      += 1;
		distance += 1;
	}
	return string_view.{ end - begin, &buf[begin] };
}

get_character_len :: fn (c: u8) s32 #inline {
	if c < 0x80           { return 1; }
	if (c & 0xE0) == 0xC0 { return 2; }
	if (c & 0xE0) == 0xE0 { return 3; }
	if (c & 0xF8) == 0xF0 { return 4; }
	return 0;
}

// Check whether the 'str' content is multiline, might optionaly return the first line of 'str' in 'first_line'.
is_multiline :: fn (str: string_view, first_line: *string_view = null) bool #inline {
	multiline      := false;
	loop index := 0; index < str.len; index += 1 {
		if str[index] == '\n' || str[index] == '\r' {
			multiline = true;
			if first_line {
				(@first_line) = string_view.{ len = index, ptr = str.ptr };
			}
			break;
		}
	}
	if first_line && multiline == false {
		(@first_line) = str;
	}
	return multiline;
}

get_keybinding_for_command :: fn (cmd: Command, primary_only := true) string_view #inline {
	tmp :: str_make(application_context.temporary_allocator);
	loop keymap_index := 0;; keymap_index += 1 {
		keymap_index = lookup_command_keymap_index(cmd, keymap_index);
		if keymap_index == -1 then break;

		if tmp.len > 0 {
			if primary_only then break;
			str_append(&tmp, "\0");
		}
		str_append(&tmp, keymap_entry_to_string(keymap_index));
	}

	if tmp.len == 0 then return tprint("<%>", COMMAND_NAMES[auto cmd]);
	return tmp;
}

unify_line_endings :: fn (data: []u8, line_ending:  LineEnding) string_view {
	if detect_line_ending(data) == line_ending then return data;

	buf: string;
	if line_ending == LineEnding.LF {
		print_log("Convert to LF");
		buf = str_make(data, application_context.temporary_allocator);
		str_replace_all(&buf, '\r');
	} else {
		print_log("Convert to CRLF");
		buf = str_make(data.len, application_context.temporary_allocator);
		loop i := 0; i < data.len; i += 1 {
			c :: data[i];
			if c == '\n' {
				str_append(&buf, "\r\n");
				continue;
			}
			str_append(&buf, string_view.{ 1, &c });
		}
	}

	return buf;
}

// The args might be modified in case some escape characters are present. Resulting array points to original args, so keep
// the args alive as long as parsed version is needed!
split_command_line_arguments :: fn (args: *string, allocator: *Allocator = null)  [..]string_view {
	result: [..]string_view;
	array_init(&result, 0, allocator);

	in_quotes: u8;
	loop i := 0; i < args.len; {
		c :: (@args)[i];
		if is_whitespace(c) {
			i += 1;
			continue;
		}

		len := 0;

		if c == '\"' || c == '\'' {
			in_quotes = c;
			i += 1;
			start_index :: i;

			// Quoted argument.
			loop ;i < args.len && (@args)[i] != in_quotes; i += 1 {
				len += 1;
			}

			array_push(&result, .{ len, &(@args)[start_index] });
		} else {
			start_index := i;
			loop ;i < args.len && !is_whitespace((@args)[i]); {
				if (@args)[i] == '\\' && i+1 < args.len {
					str_erase(args, i);
				}
				len += 1;
				i += 1;
			}
			array_push(&result, .{ len, &(@args)[start_index] });
		}

		i += 1;
	}

	return result;
}

contains_any_of :: fn (str: string_view, chars: string_view) bool #inline {
	loop i := 0; i < str.len; i += 1 {
		loop j := 0; j < chars.len; j += 1 {
			if str[i] == chars[j] then return true;
		}
	}
	return false;
}

absolute_path_to_relative :: fn (path: string_view, prefix: string_view) string_view #inline {
	if !str_match(path, prefix, auto prefix.len) then return path;
	return tprint(".%", string_view.{ path.len - prefix.len, &path[prefix.len] });
}


count_visual_cols_to_position_str :: fn (line: string_view, position: s64) s32 {
	count := 0;
	loop i := 0; i < position; {
		char_len :: get_character_len(line[i]);
		if char_len == 0 then break;
		if char_len == 1 && line[i] == '\t' {
			count += settings.tab_size;
		} else {
			count += 1;
		}
		i += char_len;
	}
	return count;
}

warn_if_no_project_open :: fn () bool {
	if project.filepath.len == 0 {
		print_warn("No project is open. Use [%] command first to open one.", get_keybinding_for_command(.OPEN_PROJECT));
		return true;
	}

	return false;
}

warn_if_modifications_needs_to_be_saved :: fn (buf: *Buffer) bool {
	if buf.saved_top != buf.undo_top {
		print_warn("Buffer has unsaved changes. Force close [%], or save [%].", get_keybinding_for_command(.FORCE_CLOSE_BUFFER), get_keybinding_for_command(.SAVE));
		return true;
	}

	return false;
}

warn_build_command_missing :: fn () bool {
	if settings.build_command.len == 0 {
		print_warn("Build command is not specified in project settings.");
		return true;
	}
	return false;
}

font_centered_in :: fn (h: f32, _: *draw.Font) f32 #inline {
	return math.ceil(h * 0.5f);
}

max_len :: fn (ptrs: *string_view, count: s64) s32 {
	tmp :: []string_view.{ count, ptrs };
	l := 0;
	loop i := 0; i < tmp.len; i += 1 {
		l = math.max(l, auto tmp[i].len);
	}
	return l;
}

expand_and_normalize_path :: fn (path: string_view) (path: string_view, err: Error) {
	tmp :: str_make(path.len, application_context.temporary_allocator);
	if path.len > 1 && path[0] == '~' {
		str_append(&tmp, get_home2());
		if path.len > 2 {
			str_append(&tmp, slice_range(path, 1));
		}
	} else {
		str_append(&tmp, path);
	}

	path_normalize(&tmp) catch return path, $;
	return tmp, OK;
}

find_member_in_struct :: fn (strct: *?TStruct, name: string_view) (ptr: *u8, member_type: *TypeInfo, hash: u32) #inline {
	info :: cast(*TypeInfoStruct) typeinfo(TStruct);
	assert(info.kind == TypeKind.STRUCT);
	loop i := 0; i < info.members.len; i += 1 {
		member :: &info.members[i];
		if str_match(member.name, name) {
			return ptr_shift_bytes(cast(*u8) strct, member.offset_bytes), member.base_type, str_hash(member.name);
		}
	}
	return null, null, 0;
}

lit_hash :: fn (lit: string_view) u32 #comptime {
	return str_hash(lit);
}
