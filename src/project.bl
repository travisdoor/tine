ProjectSection   :: enum { NONE; INCLUDE; EXCLUDE; SETTINGS; COLORS; INCLUDE_FILE_EXTENSIONS; KEYS; };
PROJECT_SECTIONS :: get_enum_variants_as_redable_list(ProjectSection, false);

init_project :: fn () {
	project = .{};
	project.string_cache = pool_make(null, 2048);
	mutex_init(&project.mutex);
}

terminate_project :: fn () {
	clear_project();

	if project.file_link_regex.is_valid then regex_terminate(&project.file_link_regex.expr);
	if project.file_loc_regex.is_valid  then regex_terminate(&project.file_loc_regex.expr);

	mutex_terminate(&project.mutex);
	release_allocator(&project.string_cache);

	array_terminate(&project.included_directories);
	array_terminate(&project.included_extensions);
	array_terminate(&project.excluded_directories);
	array_terminate(&project.indexed_files);
}

load_project_file :: fn (filepath: string_view, is_default := false) Error {
	allocator :: pool_make();
	defer release_allocator(&allocator);

	bytes := read_entire_file(filepath, &allocator) catch return $;

	config_data: ConfigData;
	config_data_init(&config_data, &allocator);

	diag: [..]ErrorLocation;
	array_init(&diag, 0, &allocator);
	load_config_from_memory(&config_data, filepath, bytes, &diag) catch return $;

	orig_version :: config_data.version;
	if config_data_version_upgrade(&config_data, CONFIG_VERSION) {
		// Save original config backup.
		file, ext       :: path_splitext(filepath);
		backup_filepath :: tprint("%.bak%", file, ext);
		write_entire_file(backup_filepath, bytes) catch return $;

		if orig_version == -1 && is_default {
			// Special case wiping out old default settings.
			bytes = USER_PROJECT_FILE_TEMPLATE_DATA;
		} else {
			// Get upgraded file content.
			bytes = config_data_get_bytes(&config_data);
		}

		// Override previous file with upgraded one.
		write_entire_file(filepath, bytes) catch return $;

		// Hot-loading of processed file is removed here, we have to update contents manually.
		buf :: find_buffer_for_file(filepath);
		if buf then change_content(buf, bytes);

		diag.len = 0;
		load_config_from_memory(&config_data, filepath, bytes, &diag) catch return $;

		print_info("Configuration '%' upgraded to version %. Backup saved to '%'.", filepath, CONFIG_VERSION, backup_filepath);
	}

	// Print diagnostics.
	loop i := 0; i < diag.len; i += 1 {
		msg :: &diag[i];
		text :: tprint("%:%:%: %", filepath, msg.line+1, msg.col+1, msg.message);
		switch msg.kind {
			.WARNING { print_warn(text); }
			.ERROR   { print_err(text);  }
		}
	}

	config_data_apply(&config_data);

	if is_default {
		project.name = "Default";
	} else {
		name :: path_splitext(path_split(filepath).tail);
		project.name       = str_make(name, &project.string_cache);
		project.filepath   = str_make(filepath, &project.string_cache);
	}

	return OK;
}

load_default_project_from_template :: fn () {
	allocator :: pool_make();
	defer release_allocator(&allocator);

	config_data: ConfigData;
	config_data_init(&config_data, &allocator);

	bytes :: DEFAULT_PROJECT_FILE_TEMPLATE_DATA;
	load_config_from_memory(&config_data, "TEMPLATE", bytes) catch panic($);

	assert(config_data.diag_reports_num == 0, "Template config data should not produce any errors.");
	assert(config_data.version == CONFIG_VERSION);

	config_data_apply(&config_data);
}

is_default_project_present :: fn () bool #inline {
	return file_exist(DEFAULT_PROJECT_PATH);
}

load_project :: fn (filepath: string_view) Error {
	defer do_the_stuff_after_project_load();

	clear_project();
	load_default_project_from_template();
	load_project_file(DEFAULT_PROJECT_PATH, true) catch {
		// Fallback.
		clear_project();
		load_default_project_from_template();
		return $;
	};

	if filepath.len == 0 then return OK;

	// Actual project file.
	err :: load_project_file(filepath);
	if err {
		// Fallback.
		clear_project();
		load_default_project_from_template();
	}

	return err;
}

setup_after_first_run :: fn () Error {
	defer do_the_stuff_after_project_load();

	load_default_project_from_template();
	write_entire_file(DEFAULT_PROJECT_PATH, USER_PROJECT_FILE_TEMPLATE_DATA) catch {
		return $;
	};
	write_entire_file(tprint("%/%/%", data_dir, PROJECTS_DIRECTORY, EXAMPLE_PROJECT_FILE), EXAMPLE_PROJECT_FILE_DATA) catch {
		return $;
	};
	return OK;
}

reindex_project :: fn () {
	check_main_thread();
	indexed_files_ditry = true;
}

maybe_reindex_current_project :: fn () {
	using Mode;
	if mode == QUICK_OPEN || mode == SEARCH_FILE || mode == SEARCH_IN_PROJECT then return;
	if !indexed_files_ditry then return;
	indexed_files_ditry = false;

	index_included_directories();
}

get_project_main_directory :: fn () string_view #inline {
	if project.included_directories.len > 0 {
		return project.included_directories[0];
	}

	return "";
}

add_include_directory :: fn (dir: string_view) {
	array_push(&project.included_directories, str_make(dir, &project.string_cache));
}

add_exclude_directory :: fn (dir: string_view) {
	array_push(&project.excluded_directories, str_make(dir, &project.string_cache));
}

add_include_file_extension :: fn (ext: string_view) {
	array_push(&project.included_extensions, str_make(ext, &project.string_cache));
}

unmap_binding_for_command :: fn (command_id: Command) {
	loop i := 0; i < key_binding.len; {
		if key_binding[i].cmd == command_id {
			array_erase_keep_order(&key_binding, i);
			continue;
		}
		i += 1;
	}
}

map_key_binding :: fn (command_id: Command, key: u32, mods: u32) {
	assert((cast(s32) command_id) > (cast(s32) Command._PUBLIC));
	// Handle collisions, newer wins...
	loop i := 0; i < key_binding.len; i += 1 {
		other_entry :: key_binding[i];
		if other_entry.key == key && other_entry.mods == mods {
			// We might notify user about this, but the the clean way to use already used key map would require unbinging previous shortuct first, which might be annoying...
			array_erase_keep_order(&key_binding, i);
			break;
		}
	}
	array_push(&key_binding, KeyMapEntry.{
			cmd  = command_id,
			mods = mods,
			key  = key
		});
}

get_project_root_directory :: fn () string_view #inline {
	if project.included_directories.len == 0 then return "";
	return project.included_directories[0];
}

#scope_private

//
// Indexing
//

indexed_files_ditry := false;

IndexWorkerContext :: struct {
	cancel: bool;
}

indexing: struct {
	job: Async(*IndexWorkerContext, s32);
	ctx: IndexWorkerContext;
}

index_included_directories :: fn () {
	check_main_thread();
	cancel_indexing();
	if project.included_directories.len == 0 {
		print_log("Indexing skipped, no directories included in the project.");
		return;
	}

	project.is_indexing = true;
	indexing.ctx = IndexWorkerContext.{};
	async(&indexing.job, &indexing.ctx, &index_worker);
}

cancel_indexing :: fn () {
	if !project.is_indexing { return; }
	indexing.ctx.cancel = true;
	async_wait(&indexing.job);
	project.is_indexing = false;
}

index_worker :: fn (ctx: *IndexWorkerContext) s32 {
	print_log("Indexing started...");

	// List all project files first.
	file_visitor :: fn (info: *FileVisitInfo) Error {
		if info.is_directory {
			if str_match_one_of(info.filename, project.excluded_directories) {
				info.step_into_directory = false;
			}
			return OK;
		}
		_, ext :: path_splitext(info.filename);
		// @Incomplete: Case sensitive!?
		if ext.len == 0 { return OK; }
		if project.included_extensions.len > 0 && str_match_one_of(ext, project.included_extensions) == false {
			return OK;
		}

		filepath :: str_make(info.filepath, &project.string_cache);
		array_push(&project.indexed_files, filepath);
		return OK;
	};

	// Locking must be done here in the indexer thread, otherwise we might get some lags in UI especially when async
	// search is in progress...
	mutex_lock(&project.mutex);
	defer mutex_unlock(&project.mutex);
	project.indexed_files.len = 0;

	loop i := 0; i < project.included_directories.len && ctx.cancel == false; i += 1 {
		dirpath :: project.included_directories[i];
		print_log("Index directory '%'.", dirpath);
		err_visit :: visit_files(dirpath, VisitOpt.{ recursive = true }, &file_visitor);
		if err_visit {
			print_err(err_visit);
			continue;
		}
	}

	project.is_indexing = false;
	print_log("Indexing DONE (indexed % files).", project.indexed_files.len);
	return 0;
};

clear_project :: fn () {
	loop i := 0; i < project.included_directories.len; i += 1 {
		path :: project.included_directories[i];
		if !is_watched(file_watch, path) then continue;
		unwatch_changes(file_watch, path) catch print_err($);
	}

	cancel_indexing();

	if is_watched(file_watch, DEFAULT_PROJECT_PATH) {
		unwatch_changes(file_watch, DEFAULT_PROJECT_PATH) catch {
			print_err($);
		};
	}

	if is_watched(file_watch, project.filepath) {
		unwatch_changes(file_watch, project.filepath) catch {
			print_err($);
		};
	}

	project.name     = "";
	project.filepath = "";
	project.included_directories.len = 0;
	project.included_extensions.len  = 0;
	project.excluded_directories.len = 0;
	project.indexed_files.len        = 0;

	// Clear settings
	info :: cast(*TypeInfoStruct) typeinfo(Settings);
	loop i := 0; i < info.members.len; i += 1 {
		member :: &info.members[i];
		if member.base_type == typeinfo(string) {
			str :: cast(*string) ptr_shift_bytes(&settings, member.offset_bytes);
			str.len = 0;
		}
	}

	reset_allocator(&project.string_cache);
}

do_the_stuff_after_project_load :: fn () {
	// Apply loaded changes, new ones or restored ones.
	rebuild_fonts_next_frame();

	if project.file_link_regex.is_valid then regex_terminate(&project.file_link_regex.expr);
	if project.file_loc_regex.is_valid  then regex_terminate(&project.file_loc_regex.expr);

	project.file_link_regex.is_valid = true;
	regex_init(&project.file_link_regex.expr, settings.file_link_regex) catch {
		print_err($);
		project.file_link_regex.is_valid = false;
	};

	project.file_loc_regex.is_valid = true;
	regex_init(&project.file_loc_regex.expr, settings.file_location_regex) catch {
		print_err($);
		project.file_loc_regex.is_valid = false;
	};

	if settings.search_size_limit_bytes < 1 then settings.search_size_limit_bytes = -1;

	// map color codes for source code syntax
	code_color_table[auto CODE_COLOR_DEFAULT_INDEX  ] = colors.foreground;
	code_color_table[auto CODE_COLOR_CURSOR_INDEX   ] = colors.cursor_foreground;
	code_color_table[auto CODE_COLOR_KEYWORD_INDEX  ] = colors.code_keyword;
	code_color_table[auto CODE_COLOR_COMMENT_INDEX  ] = colors.code_comment;
	code_color_table[auto CODE_COLOR_DIRECTIVE_INDEX] = colors.code_directive;
	code_color_table[auto CODE_COLOR_STRING_INDEX   ] = colors.code_string;
	code_color_table[auto CODE_COLOR_INVALID_INDEX  ] = colors.code_invalid;
	code_color_table[auto CODE_COLOR_NUMBER_INDEX   ] = colors.code_number;
	code_color_table[auto CODE_COLOR_ERROR_INDEX    ] = colors.code_error;
	code_color_table[auto CODE_COLOR_WARNING_INDEX  ] = colors.code_warning;
	code_color_table[auto CODE_COLOR_WARNING_INDEX  ] = colors.code_warning;
	code_color_table[auto CODE_COLOR_FUNCTION_INDEX ] = colors.code_function;

	code_color_table[auto ANSI_COLOR_BLACK_INDEX]   = colors.ansi_black;
	code_color_table[auto ANSI_COLOR_RED_INDEX]     = colors.ansi_red;
	code_color_table[auto ANSI_COLOR_GREEN_INDEX]   = colors.ansi_green;
	code_color_table[auto ANSI_COLOR_YELLOW_INDEX]  = colors.ansi_yellow;
	code_color_table[auto ANSI_COLOR_BLUE_INDEX]    = colors.ansi_blue;
	code_color_table[auto ANSI_COLOR_MAGENTA_INDEX] = colors.ansi_magenta;
	code_color_table[auto ANSI_COLOR_CYAN_INDEX]    = colors.ansi_cyan;
	code_color_table[auto ANSI_COLOR_WHITE_INDEX]   = colors.ansi_white;

	indexed_files_ditry = true;

	loop i := 0; i < project.included_directories.len; i += 1 {
		path :: project.included_directories[i];
		if is_watched(file_watch, path) then continue;
		watch_changes(file_watch, path) catch print_err($);
	}

	if !is_watched(file_watch, DEFAULT_PROJECT_PATH) {
		watch_changes(file_watch, DEFAULT_PROJECT_PATH) catch {
			print_err($);
		};
	}

	if project.filepath.len > 0 && !is_watched(file_watch, project.filepath) {
		watch_changes(file_watch, project.filepath) catch {
			print_err($);
		};
	}

	clear_recent_locations();
}
