open_from_drive_mode_init :: fn (saving := false) {
	activate_command_editor();
	is_saving = saving;

	buf :: get_active_buffer_and_editor();
	clear_buffer(buf);

	input_mode               = InputMode.TEXT;
	notify_changes_to_buffer = buf.index;
	may_override_file        = false;

	base_path = get_cwd();
	list_directory(tprint("%/", base_path)) catch print_err($);
}

open_from_drive_mode_terminate :: fn () {
	activate_command_editor();
	str_terminate(&base_path);
	str_terminate(&save_item_title);
}

draw_open_from_drive_mode :: fn () {
	get_title :: fn () string_view #inline {
		if base_path.len == 0 && PLATFORM == Platform.WINDOWS {
			return "";
		}
		if base_path.len == 1 && PLATFORM != Platform.WINDOWS {
			return "/";
		}

		return tprint("%/", base_path);
	};

	clicked := false;

	search_list_begin(.{}); {
		draw_search_command_editor(.{
				title  = "Search file...",
				prefix = get_title(),
			});

		clicked = draw_search_simple_list();

		draw_search_hints([_]PanelHint.{
				.{
					key_mapping = get_keybinding_for_command(.INSERT_NEW_LINE),
					info        = "open"
				},
				.{
					key_mapping = get_keybinding_for_command(.CANCEL_MODE),
					info        = "cancel"
				},
				.{
					key_mapping = get_keybinding_for_command(.MOVE_DOWN),
					info        = "next",
				},
				.{
					key_mapping = get_keybinding_for_command(.MOVE_UP),
					info        = "prev",
				},
			});

	} search_list_end();

	if clicked then commit();
}

//
// Commands
//

invoke_command_open_from_drive_mode :: fn (buf: *Buffer, cmd: Command) bool {
	assert(workspace.active_editor == workspace.command_editor);
	assert(editors[workspace.active_editor].buffer_index == buf.index);
	editor :: &editors[workspace.active_editor];

	using Command;

	switch cmd {
		INSERT_NEW_LINE { commit(); }

		DELETE_CHAR_LEFT {
			position :: get_cursor_position(buf, editor.cursor_index);
			if position != 0 {
				// Command not handled.
				return false;
			}
			dir_up(&base_path);
		}

		MOVE_UP   { list_item_up();   }
		MOVE_DOWN { list_item_down(); }

		// Not handled.
		default { return false; }
	}

	return true;
}

open_from_drive_cmd_changed :: fn () {
	buf :: get_active_buffer_and_editor();
	user_path :: peek_row(buf, 0);
	head, tail :: parse_path(user_path);

	if head.len > 0 {
		new_base_path: string_view;

		if is_path_absolute(head) {
			new_base_path = head;
		} else {
			if base_path.len == 1 && PLATFORM != Platform.WINDOWS {
				new_base_path = tprint("/%", head);
			} else {
				new_base_path = tprint("%/%", base_path, head);
			}
		}

		is_dir :: is_directory(new_base_path) catch print_err($);

		if is_dir {
			base_path.len = 0;
			str_append(&base_path, new_base_path);
			list_directory(base_path) catch print_err($);

			// 2025-02-17: Changing the buffer content will invoke change notification
			//             invoking this function again. So filtering should be properly
			//             updated.
			clear_buffer(buf);
			if tail.len > 0 then insert_string(buf, 0, tail);
			return;
		}
	}

	if tail.len == 0 {
		clear_list_filters();
		return;
	}

	save_item: *ListItem;
	if is_saving && base_path.len > 0 && !is_directory(tail)._0 && !file_exist(tprint("%/%", base_path, tail)) {
		save_item_title.len = 0;
		str_clear_concat(&save_item_title, "Save as: ", tail);

		save_item_tmp = .{
			title = save_item_title,
			icon  = icon(ICON_SAVE_AS),
			index = SAVE_ITEM_INDEX,
		};
		save_item = &save_item_tmp;
		may_override_file = false;
	}

	filter_list(tail, save_item);
}

#scope_private

is_saving: bool;
base_path: string;
save_item_tmp: ListItem;
save_item_title: string;
may_override_file: bool;

SAVE_ITEM_INDEX :: -1;

commit :: fn () {
	buf :: get_active_buffer_and_editor();

	item :: get_selected_item_in_list();
	if !item { return; }

	path: string_view #noinit;
	filename := if item.index == SAVE_ITEM_INDEX then peek_row(buf, 0).text else item.title;

	if base_path.len == 0 && PLATFORM == Platform.WINDOWS {
		path = tprint(filename);
	} else {
		path = tprint("%/%", base_path, filename);
	}
	clear_buffer(buf);

	if (item.flags & ItemFlags.DIRECTORY) == ItemFlags.DIRECTORY {
		list_directory(tprint("%/", path)) catch {
			print_err($);
			return;
		};

		base_path.len = 0;
		str_append(&base_path, path);

		//set_cwd(base_path);
	} else if is_saving {
		if file_exist(path) && may_override_file == false {
			commit_key_binding :: get_keybinding_for_command(.INSERT_NEW_LINE);
			cancel_key_binding :: get_keybinding_for_command(.CANCEL_MODE);
			print_warn("Press [%] to overwrite file, [%] to cancel or change the file name and try again.", commit_key_binding, cancel_key_binding);
			may_override_file = true;
			return;
		}
		may_override_file = false;

		set_mode(Mode.TEXT_EDIT);
		buf :: get_active_buffer_and_editor();
		save(buf, path) catch print_err($);
	} else {
		set_mode(Mode.TEXT_EDIT);
		open(path) catch print_err($);
	}
}

parse_path :: fn (path: string_view) (head: string_view, tail: string_view) {
	delims: string_view;

	#if PLATFORM == Platform.WINDOWS {
		delims = "\\/";
	} else {
		delims = "/";
	}

	last_delim_index : s64 = -1;
	loop i := path.len-1; i >= 0; i -= 1 {
		loop j := 0; j < delims.len; j += 1 {
			if path[i] == delims[j] {
				last_delim_index = i;
				break;
			}
		}
	}

	if last_delim_index == -1 then return "", path;
	head := string_view.{ last_delim_index, path.ptr };

	if PLATFORM != Platform.WINDOWS && last_delim_index == 0 {
		head = .{ 1, path.ptr };
	}

	tail :: string_view.{ path.len - last_delim_index - 1, &path[last_delim_index+1] };

	return head, tail;
}

is_path_absolute :: fn (path: string_view) bool {
	if path.len < 1 then return false;

	#if PLATFORM == .WINDOWS {
		if path.len < 2 then return false;
		return path[1] == ':';
	} else {
		return path[0] == '/';
	}
}

dir_up :: fn (path: *string) {
	lhs: string_view;
	#if PLATFORM == Platform.WINDOWS {
		if str_split_by_last(@path, '/', &lhs) {
			assert(lhs.len > 0);
			tmp := str_make(lhs, application_context.temporary_allocator);
			path.len = 0;
			str_append(path, tmp);
			list_directory(tprint("%/", @path)) catch print_err($);
		} else {
			list_logical_drives() catch print_err($);
			path.len = 0;
		}
	} else {
		if str_split_by_last(@path, '/', &lhs) {
			err := OK;
			if lhs.len == 0 {
				path.len = 0;
				err = list_directory("/");
			} else {
				tmp := str_make(lhs, application_context.temporary_allocator);
				path.len = 0;
				str_append(path, tmp);
				err = list_directory(tprint("%/", @path));
			}
			if err then print_err(err);
		}
	}
}
