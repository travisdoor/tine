shutdown_mode_init :: fn (closing_buffers := false) {
	is_closing_buffers = closing_buffers;

	has_modified, has_missing :: close_all();
	if !has_modified && !has_missing {
		set_mode(.TEXT_EDIT);
		if !is_closing_buffers then schedule_exit();
		return;
	}

	activate_command_editor();
	buf :: get_active_buffer_and_editor();
	clear_buffer(buf);

	notify_changes_to_buffer = buf.index;

	menu: [..]ListItem;
	array_init(&menu, 3, application_context.temporary_allocator);

	save_all_hint := "";
	if has_missing && has_modified {
		save_all_hint = "Save all buffers and create missing files.";
	} else if has_missing {
		save_all_hint = "Create all missing files.";
	}

	array_push(&menu, .{
			icon       = icon(ICON_SAVE_ALL),
			title      = if is_closing_buffers then "Save All" else "Save All & Quit",
			flags      = .HIGHLIGHT,
			index      = SAVE_ALL_ITEM_INDEX,
			hint       = save_all_hint,
		});

	if has_missing && has_modified {
		array_push(&menu, .{
				icon       = icon(ICON_SAVE),
				title      = if is_closing_buffers then "Save All Existing" else "Save All Existing & Quit",
				flags      = .HIGHLIGHT,
				index      = SAVE_ALL_EXISTING_ITEM_INDEX,
				hint       = "Save only buffers associated with existing files.",
			});

	}

	array_push(&menu, .{
				icon       = icon(ICON_CLOSE_ALL),
				title      = if is_closing_buffers then "Close All" else "Quit",
				flags      = .HIGHLIGHT,
				index      = QUIT_ITEM_INDEX,
				hint       = "Ignore all unsaved changes.",
			});

	list_buffers(true, menu);
	print_warn("Not all files were saved, chose what to do.");
}

shutdown_mode_terminate :: fn () {}

draw_shutdown_mode :: fn () {
	clicked := false;

	search_list_begin(.{}); {
		draw_search_command_editor(.{
				title = "Search unsaved files...",
			});

		clicked = draw_search_simple_list();

		draw_search_hints([_]PanelHint.{
				.{
					command = .INSERT_NEW_LINE,
					info    = "use/open"
				},
				.{
					command = .CANCEL_MODE,
					info    = "cancel"
				},
				.{
					command = .MOVE_DOWN,
					info    = "next",
				},
				.{
					command = .MOVE_UP,
					info    = "prev",
				},
			});

	} search_list_end();

	if clicked then commit();
}

//
// Commands
//

invoke_command_shutdown_mode :: fn (buf: *Buffer #maybe_unused, cmd: Command) bool {
	assert(workspace.active_editor == workspace.command_editor);
	assert(editors[workspace.active_editor].buffer_index == buf.index);

	using Command;

	switch cmd {
		INSERT_NEW_LINE { commit(); }

		MOVE_UP   { list_item_up();   }
		MOVE_DOWN { list_item_down(); }

		// Not handled.
		default { return false; }
	}

	return true;
}

shutdown_cmd_changed :: fn () {
	buf :: get_active_buffer_and_editor();
	user_path :: peek_row(buf, 0);
	if user_path.len == 0 {
		clear_list_filters();
		return;
	}

	filter_list(user_path, .{}, 3);
}

#private

is_closing_buffers := false;

SAVE_ALL_ITEM_INDEX          :: -1;
SAVE_ALL_EXISTING_ITEM_INDEX :: -2;
QUIT_ITEM_INDEX              :: -3;

commit :: fn () {
	item :: get_selected_item_in_list();
	if !item then return;

	set_mode(.TEXT_EDIT);

	switch item.index {
		SAVE_ALL_EXISTING_ITEM_INDEX,
		SAVE_ALL_ITEM_INDEX {
			ignore_missing :: item.index == SAVE_ALL_EXISTING_ITEM_INDEX;
			success, editor_index :: save_all(ignore_missing);
			if success {
				if is_closing_buffers {
					close_all(true);
				} else {
					schedule_exit();
				}
				return;
			}
			if editor_index != -1 {
				activate_editor(editor_index);
			}
		}
		QUIT_ITEM_INDEX {
			if is_closing_buffers {
				close_all(true);
			} else {
				schedule_exit();
			}
		}
		default {
			assert(item.index != 0, "We should operate only on open buffers!");
			activate_buffer_editor(item.index, get_active_split());
		}
	}
}

save_all :: fn (ignore_missing := false) (success: bool, editor_index_for_manual_action: s32) {
	loop i := 0; i < buffers.len; i += 1 {
		buf :: &buffers[i];
		if buf.is_removed then continue;
		if (buf.flags & .NO_UNDO) == .NO_UNDO then continue;

		if !ignore_missing {
			if buf.filepath.len == 0 {
				print_err("Cannot automatically save file '%' which is not associated with any file on disk. Use [%] to save the file.", buf.name, get_keybinding_for_command(.SAVE));
				editor_index :: find_editor_for_buffer(buf.index);
				return false, editor_index;
			}
		} else if buf.missing_on_disk || buf.filepath.len == 0 {
			continue;
		}

		save_buffer_to_file(buf, buf.filepath) catch {
			print_err($);
			return false, -1;
		};
	}

	return true, -1;
}

close_all :: fn (force := false) (has_modified: bool, has_missing: bool) {
	allocator    :: application_context.temporary_allocator;
	open_buffers :: duplicate_slice(buffers, allocator) catch panic($);

	has_modified := false;
	has_missing  := false;

	loop i := 0; i < open_buffers.len; i += 1 {
		buf :: &open_buffers[i];
		if buf.is_removed then continue;
		if (buf.flags & .NO_UNDO) == .NO_UNDO then continue;

		if force {
			close_buffer(buf.index);
			continue;
		}

		if buf.missing_on_disk {
			has_missing  = true;
			continue;
		}
		if buf.saved_top != buf.undo_top {
			has_modified = true;
			continue;
		}

		close_buffer(buf.index);
	}

	return has_modified, has_missing;
}