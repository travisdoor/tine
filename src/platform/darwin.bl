#load "posix.bl"

DEFAULT_SHELL :: "/bin/zsh";

//
// MISC
//

get_fonts_directory :: fn () string {
	return str_make("/System/Library/Fonts");
}

new_url_from_filepath :: fn (filepath: string_view) (filepath: string, err: Error) {
	result: string;

	cf_file_path :: CFStringCreateWithBytes(kCFAllocatorDefault, auto filepath.ptr, filepath.len, CFStringEncoding.UTF8, 0);
	defer CFRelease(cf_file_path);
	if !cf_file_path then return result, error("Failed to create CFString.");

	file_url :: CFURLCreateWithFileSystemPath(kCFAllocatorDefault, cf_file_path, 0, 0);
	defer CFRelease(file_url);
	if !file_url then return result, error("Failed to create CFURL.");

	url_string :: CFURLGetString(file_url);
	if !url_string then return result, error("Failed to get url string.");


	buf: [2048]C.char #noinit;
	if CFStringGetCString(url_string, buf.ptr, buf.len, CFStringEncoding.UTF8) == 0 {
		return result, error("Failed to get url string.");
	}

	str_append(&result, ctostr(buf.ptr));
    return result, OK;
}

new_filepath_from_url :: fn (url: string_view, allocator: *Allocator) (filepath: string, err: Error) {
	result :: str_make(allocator);

	cf_url_string :: CFStringCreateWithBytes(kCFAllocatorDefault, auto url.ptr, url.len, CFStringEncoding.UTF8, 0);
	defer CFRelease(cf_url_string);
	if !cf_url_string then return result, error("Failed to create file path from URL.");

	cf_url :: CFURLCreateWithString(kCFAllocatorDefault, cf_url_string, null);
	defer CFRelease(cf_url);
	if !cf_url then return result, error("Failed to create file path from URL.");

	cf_filepath :: CFURLCopyFileSystemPath(cf_url, 0);
	defer CFRelease(cf_filepath);
	if !cf_filepath then return result, error("Failed to create file path from URL.");

	buf: [2048]C.char #noinit;
	if CFStringGetCString(cf_filepath, buf.ptr, buf.len, CFStringEncoding.UTF8) == 0 {
		return result, error("Failed to create file path from URL.");
	}

	str_append(&result, ctostr(buf.ptr));
    return result, OK;
}

//
// Dock menu
//

// Install "New Window" item into the app icon's Dock menu.
setup_dock_menu :: fn () Error {
	ns_app :: objc_msgSend0(objc_getClass(strtoc("NSApplication")), sel_registerName(strtoc("sharedApplication")));
	if !ns_app {
		return error("Failed to setup macOS dock menu, NSApplication is not available.");
	}

	delegate :: objc_msgSend0(ns_app, sel_registerName(strtoc("delegate")));
	if !delegate {
		return error("Failed to setup macOS dock menu, application delegate is not available.");
	}
	delegate_class :: object_getClass(delegate);

	menu_class      :: objc_getClass(strtoc("NSMenu"));
	menu_item_class :: objc_getClass(strtoc("NSMenuItem"));

	menu :: objc_msgSend0(objc_msgSend0(menu_class, sel_registerName(strtoc("alloc"))), sel_registerName(strtoc("init")));
	if !menu {
		return error("Failed to setup macOS dock menu, cannot create NSMenu.");
	}

	title     :: CFStringCreateWithCString(kCFAllocatorDefault, auto strtoc("New Window"), CFStringEncoding.UTF8);
	key_equiv :: CFStringCreateWithCString(kCFAllocatorDefault, auto strtoc(""), CFStringEncoding.UTF8);

	new_window_sel :: sel_registerName(strtoc("tineDockNewWindow:"));

	item :: objc_msgSend3(
		objc_msgSend0(menu_item_class, sel_registerName(strtoc("alloc"))),
		sel_registerName(strtoc("initWithTitle:action:keyEquivalent:")),
		auto title,
		new_window_sel,
		auto key_equiv,
	);

	objc_msgSend1(item, sel_registerName(strtoc("setTarget:")), delegate);
	objc_msgSend1(menu, sel_registerName(strtoc("addItem:")), item);

	dock_menu = menu;

	if class_addMethod(delegate_class, sel_registerName(strtoc("applicationDockMenu:")), auto &fn (self_: id, cmd_: SEL, sender_: id) id {
		self_; cmd_; sender_;
		return dock_menu;
	}, strtoc("@@:@")) == 0 {
		return error("Failed to setup macOS dock menu, cannot install applicationDockMenu: handler.");
	}

	if class_addMethod(delegate_class, new_window_sel, auto &fn (self_: id, cmd_: SEL, sender_: id) {
		self_; cmd_; sender_;
		spawn_new_window() catch return $;
	}, strtoc("v@:@")) == 0 {
		return error("Failed to setup macOS dock menu, cannot install New Window action handler.");
	}

	return OK;
}

get_file_last_write_time :: fn (filepath: string_view) (t: u64, err: Error) {
	using C;
	file_stat: stat_t #noinit;
	if stat(strtoc(filepath), &file_stat) == -1 {
		return 0, os_get_last_error2();
	}

	s  :: cast(u64) file_stat.st_mtimespec.tv_sec;
	ns :: cast(u64) file_stat.st_mtimespec.tv_nsec;

	return s * 1000 + ns / 1000000, OK;
}

spawn_new_window :: fn () Error {
	pid :: C.fork();
	if pid == -1 {
		return error("Failed to open a new window: %", os_get_last_error2());
	}
	if pid == 0 {
		// child
		exe :: strtoc(EXEC_PATH);
		argv: [2]*C.char #noinit;
		argv[0] = exe;
		argv[1] = null;
		C.execv(exe, argv.ptr);
		C.exit(1);
	}
}

#scope_private
#import "os/macos"

//
// Minimal Objective-C runtime bindings, just enough to install a Dock menu handler on SDL's
// NSApplication delegate. Tine has no other AppKit/Cocoa dependency.
//

id  :: *u8;
SEL :: *u8;

dock_menu: id;

objc_getClass    :: fn (name: *C.char) id #extern "objc_getClass";
sel_registerName :: fn (name: *C.char) SEL #extern "sel_registerName";
object_getClass  :: fn (obj: id) id #extern "object_getClass";
class_addMethod  :: fn (cls: id, name: SEL, imp: *u8, types: *C.char) Boolean #extern "class_addMethod";

objc_msgSend0 :: fn (self_: id, cmd: SEL) id #extern "objc_msgSend";
objc_msgSend1 :: fn (self_: id, cmd: SEL, a1: id) #extern "objc_msgSend";
objc_msgSend3 :: fn (self_: id, cmd: SEL, a1: id, a2: SEL, a3: id) id #extern "objc_msgSend";
