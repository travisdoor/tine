Editor :: struct {
	index:        s32;
	buffer_index: s32;
	cursor_index: s32;
	split:        Split;

	top:           s32;
	visible_lines: s32;

	sliding: struct {
		vertical:          Animation;
		horizontal:        Animation;
		vertical_offset:   f32;
		horizontal_offset: f32;
	};

	prev_frame_cursor_position: s64;
	track_recent_locations:     bool;

	wrap: struct {
		// Buffer Hash | Buffer Version. This is used to identify dirty line wrapping if enabled for buffer.
		last_buffer_hash: u64;
		last_w: s32;

		virtual_lines: VirtualLines;
	};

	is_removed: bool;
}

DEFAULT_ANIMATION_SPEED :: 0.008f;

add_editor :: fn (buffer_index: s32, track_recent_locations := false, split := Split.FLOATING) s32 {
	editor: *Editor;
	check_main_thread();

	// Try to find already existing editor holding same buffer. Note that we must do it before
	// this editor is pushed into the editors array.
	cursor_position : s64 = 0;
	loop i := 0; i < editors.len; i += 1 {
		e :: &editors[i];
		if e.is_removed { continue; }
		if e.buffer_index == buffer_index {
			cursor_position = get_cursor_position(&buffers[buffer_index], e.cursor_index);
		}
	}
	cursor_index :: add_cursor(&buffers[buffer_index], cursor_position);

	// Find the free editor slot in the array first
	loop i := 0; i < editors.len; i += 1 {
		e :: &editors[i];
		if e.is_removed {
			editor            = e;
			editor.is_removed = false;
			assert(editor.buffer_index == -1);
			break;
		}
	}
	if !editor {
		// Create new one
		index :: cast(s32) editors.len;
		editor = zeroinit(array_push(&editors));
		editor.index        = index;
		editor.buffer_index = -1;
	}

	assert(buffer_index != -1);
	assert(!buffers[buffer_index].is_removed);

	editor.buffer_index           = buffer_index;
	editor.split                  = split;
	editor.cursor_index           = cursor_index;
	editor.track_recent_locations = track_recent_locations;

	sliding :: &editor.sliding;
	sliding.vertical.t   = 1.f;
	sliding.horizontal.t = 1.f;
	sliding.horizontal_offset = 0.f;

	return editor.index;
}

remove_editor :: fn (index: s32) {
	assert(index >= 0 && index < editors.len);
	editor :: &editors[index];
	if editor.is_removed { return; }

	if editor.track_recent_locations {
		erase_all_locations_for_editor(editor);
	}

	buf :: get_editor_buffer(editor);
	remove_cursor(buf, editor.cursor_index);

	tbl_terminate(&editor.wrap.virtual_lines);

	zeroinit(editor);

	editor.index        = index;
	editor.buffer_index = -1;
	editor.cursor_index = -1;
	editor.is_removed   = true;
}

set_editor_buffer :: fn (editor: *Editor, buffer_index: s32) {
	editor.buffer_index          = buffer_index;
	editor.wrap.last_buffer_hash = -1;
}

get_editor_buffer :: fn (editor: *Editor) *Buffer {
	assert(editor);
	assert(editor.buffer_index >= 0 && editor.buffer_index < buffers.len);
	buf :: &buffers[editor.buffer_index];
	assert(buf.is_removed == false);
	return buf;
}

duplicate_editor_cursor :: fn (editor: *Editor) s32 {
	buf :: get_editor_buffer(editor);
	cur :: buf.cursors[editor.cursor_index];
	return add_cursor(buf, cur.position, cur.selection_start);
}

draw_text_editor :: fn (index: s32, x: f32, y: f32, w: f32, h: f32, loc := #call_location) {
	using draw;
	using Metric;

	editor :: &editors[index];
	if editor.buffer_index == -1 { return; }
	buf :: &buffers[editor.buffer_index];

	lock_buffer(buf);
	defer unlock_buffer(buf);

	lsp_pull_diagnostics_update(buf);

	title_bar_height :: metrics[auto TITLE_BAR_HEIGHT];
	line_height      :: metrics[auto LINE_HEIGHT ];
	text_padding     :: metrics[auto TEXT_PADDING];
	item_spacing     :: metrics[auto ITEM_SPACING ];

	show_line_numbers := settings.show_line_numbers
	&& buf.index != messages_buffer_index
	&& buf.index != help_buffer_index
	&& buf.index != shell.buffer_index;

	line_number_w: f32;
	if show_line_numbers {
		line_number_w = text_size(tprint("%", get_row_count(buf)), &font).width;
		line_number_w += item_spacing;
	}

	content_x :: x + line_number_w;
	content_w :: w - line_number_w;

	set_scissor(x, y, w, h);
	defer clear_scissor();

	rebuild_coloring_and_indentation_info(buf);
	is_active :: active_editor == editor.index;

	line_w :: content_w - text_padding*2.f;

	rebuild_virtual_lines_if_needed(editor, buf, line_w);
	virtual_lines_count :: get_virtual_lines_count(editor, buf);

	// Draw background
	set_shader_color();
	// rect(x, y, line_number_w, h, colors.background_line_numbers_color);
	rect(content_x, y, content_w, h, colors.background_color);

	sliding :: &editor.sliding;

	cursor :: get_cursor(buf, editor.cursor_index);
	virtual_cursor :: physical_cursor_to_virtual(editor, buf, cursor);

	visible_lines :: cast(s32) math.round(h / line_height);

	first_line_index := editor.top;

	if is_animating(&sliding.vertical) {
		interpolated_y :: animate(&sliding.vertical);

		first_line_index = auto math.floor(interpolated_y / line_height);
		sliding.vertical_offset = (line_height * auto first_line_index) - interpolated_y;
		redraw();
	}

	last_line_index :: first_line_index + visible_lines;

	// Cache some values.
	editor.top           = first_line_index;
	editor.visible_lines = visible_lines;

	// Make cursor visible if position changed
	if editor.prev_frame_cursor_position != virtual_cursor.position || first_line_index > virtual_lines_count {
		top := -1;
		if virtual_cursor.row < first_line_index {
			top = math.max(0, virtual_cursor.row);
		} else if virtual_cursor.row > last_line_index - BOTTOM_SCROLL_TRIGGER {
			top = math.max(0, first_line_index + virtual_cursor.row - last_line_index + BOTTOM_SCROLL_TRIGGER);
		}
		if top != -1 then start_vertical_animation(editor, top);
	}

	// Cursor position and size.
	char_under_cursor :: peek_position(buf, virtual_cursor.position);
	line, start_index :: peek_virtual_row_without_new_line(editor, buf, virtual_cursor.row);

	use_block_caret :: settings.block_caret && !(is_selection_active(buf, editor.cursor_index) && settings.change_caret_on_selection);

	cursor_x := text_size(line, &font, auto (virtual_cursor.position - start_index));
	cursor_w := 2.f;
	if use_block_caret || !is_active {
		cw :: text_size(char_under_cursor, &font);
		cursor_w = cw;
		if cursor_w == 0.f {
			pilot_char_w :: text_size("X", &font);
			cursor_w = math.round(pilot_char_w);
		}
	}

	tx := content_x + text_padding;
	ty :: y + text_padding + sliding.vertical_offset;

	// Adjust text x offset
	update_editor_x_offset(editor, line_w, cursor_x);

	tx -= sliding.horizontal_offset;
	tx = math.round(tx);

	{ // Current line highlight background.
		current_line_num, first_current_line_row :: get_virtual_row_count_in_line(editor, buf, virtual_cursor.row);
		current_line_y :: ty + line_height * auto (first_current_line_row - first_line_index);

		// current line highlight
		rect(x, current_line_y, w, line_height * auto current_line_num, colors.current_line_background_color);
	}

	inline_compilation_error :: get_current_compilation_error();
	has_inline_errors :: settings.show_lsp_inline_diagnostics || inline_compilation_error;

	if has_inline_errors {
		is_peeking :: mode == Mode.PEEK_ERROR;

		line_base_y := ty;
		loop virtual_row_index := first_line_index; virtual_row_index < last_line_index && virtual_row_index < virtual_lines_count; virtual_row_index += 1 {
			physical_row_index :: virtual_row_to_raw(editor, buf, virtual_row_index);

			virtual_line  :: peek_virtual_row(editor, buf, virtual_row_index);
			physical_line :: peek_row(buf, physical_row_index);

			// @Performance 2026-03-22: We might do it only in case the error is captured on current row.
			virtual_count, virtual_first_index :: get_virtual_row_count_in_line(editor, buf, virtual_row_index);

			error_reported_for_line := false;
			highliht_only :: (is_peeking && cursor.row == physical_row_index) || (virtual_first_index + virtual_count-1) != virtual_row_index;

			// Highlight errors and warnings.
			if inline_compilation_error {
				loc :: inline_compilation_error;
				if physical_row_index == loc.line-1 && cursor.row == loc.line-1 && loc.file_hash == buf.hash {
					draw_inline_error(editor, content_x, line_base_y, w, virtual_line, loc, highliht_only);
					error_reported_for_line = true;
				}
			}

			if settings.show_lsp_inline_diagnostics && !error_reported_for_line {
				loc :: get_diagnostic_for_line(buf, physical_row_index);
				if loc && !loc.is_hidden {
					if loc.line_hash != str_hash(physical_line) {
						loc.is_hidden = true;
					}
					draw_inline_error(editor, content_x, line_base_y, w, virtual_line, loc, highliht_only);
				}
			}

			line_base_y += line_height;
		}
	}

	set_shader_color();

	_, first_position :: peek_virtual_row(editor, buf, first_line_index);
	_, last_position  :: peek_virtual_row(editor, buf, math.min(cast(s32) virtual_lines_count-1, last_line_index) );

	// Draw selection.
	{
		start := virtual_cursor.selection_start;
		if start != -1 {
			end := virtual_cursor.position;
			if start > end then swap(&start, &end);
			if end > start {
				color := colors.selection_background_color;
				if !is_active then color = colors.selection_background_inactive_color;
				draw_highlight_range(buf, editor, tx, ty, start, end, first_position, last_position, color);
			}
		}
	}

	// Draw search highlights.
	highlight_last_search_results :: mode == Mode.SEARCH_FILE || mode == Mode.REPLACE;
	if highlight_last_search_results && last_active_text_editor == editor.index {
		drawn_count := 0;
		loop i := 0; i < search.results.len; i += 1 {
			start :: search.results[i].start;
			end   :: search.results[i].end;

			if end   < first_position { continue; }
			if start > last_position  { break;    }

			draw_highlight_range(buf, editor, tx, ty, start, end, first_position, last_position, colors.search_result_background_color);

			drawn_count += 1;
			if drawn_count > MAX_VISIBLE_SEARCH_RESULTS_IN_EDITOR {
				break;
			}
		}
	}

	// Draw file links
	if is_active && !has_selection(buf, editor.cursor_index) && is_flag(buf.flags, BufferFlags.PARSE_FILE_LINKS) {
		// @Pefrormance 2025-02-21: We should probably not do it every frame but link lookup is fast enought now.
		link, found :: get_file_link_under_cursor(buf, virtual_cursor.position);
		if found {
			draw_highlight_range(buf, editor, tx, ty, link.start, link.end, first_position, last_position, colors.selection_background_color);
		}
	}

	{ // Cursor.
		cursor_y :: ty + line_height * auto (virtual_cursor.row - first_line_index);
		if is_active && caret.visible {
			color := colors.cursor_background_color;
			rect(math.round(tx + cursor_x), cursor_y, cursor_w, line_height, color);
		} else if !is_active {
			// Draw just empty box.
			lw :: 2.f;
			cx :: math.round(tx + cursor_x);
			rect(cx, cursor_y, cursor_w, lw, colors.cursor_background_color);
			rect(cx, cursor_y + line_height - lw, cursor_w, lw, colors.cursor_background_color);
			rect(cx, cursor_y, lw, line_height, colors.cursor_background_color);
			rect(cx + cursor_w - lw, cursor_y, lw, line_height, colors.cursor_background_color);
		}
	}

	// Text.
	set_shader_font(&font);
	line_base_y := math.round(ty);
	loop i := first_line_index; i < last_line_index; i += 1 {
		line, row_start_index :: peek_virtual_row(editor, buf, i);
		if line.len == 0 { break; }

		line_colors: [1024]u8 #noinit;
		if buf.colors.len == 0 {
			memset(line_colors.ptr, 0, auto math.min(line.len, line_colors.len));
		} else {
			memcpy(line_colors.ptr, &buf.colors[row_start_index], auto math.min(line.len, line_colors.len));
		}

		if use_block_caret && i == virtual_cursor.row  && is_active && caret.visible {
			cursor_position :: virtual_cursor.position - start_index;
			if cursor_position < line_colors.len {
				line_colors[cursor_position] = CODE_COLOR_CURSOR_INDEX;
			}
		}


		ly :: line_base_y + (line_height * 0.5f - font.height * 0.5f);
		code(tx, ly, line, line_colors, code_color_table);
		line_base_y += line_height;
	}

	// Line numbers
	if show_line_numbers {
		set_shader_color();
		rect(x, y, line_number_w, h, colors.background_line_numbers_color);

		set_shader_font(&font);
		line_base_y = math.round(ty);
		loop i := first_line_index; i < last_line_index && i < virtual_lines_count; {
			physical_row :: virtual_row_to_raw(editor, buf, i);
			count, first :: get_virtual_row_count_in_line(editor, buf, i);

			ly :: line_base_y + (line_height * 0.5f - font.height * 0.5f);
			line_number_str :: tprint("%", math.abs(physical_row+1));
			line_number_x := x + line_number_w - text_size(line_number_str, &font).width - item_spacing * 0.5f;
			text(line_number_x, ly, line_number_str, colors.foreground_line_numbers_color);

			skip :: count - (i - first);

			line_base_y += line_height * auto skip;
			i += skip;
		}
	}

	// shadow
	set_shader_color();
	draw_shadow(x, y + h - title_bar_height, w, title_bar_height, ShadowMode.TOP);

	// file info bar
	has_changes :: buf.saved_top != buf.undo_top;
	line_ending_name := "UNKNOWN";
	using LineEnding;
	switch buf.line_ending {
		CRLF { line_ending_name = "CRLF"; }
		LF   { line_ending_name = "LF";   }
		default;
	}
	title_bar_color := colors.title_bar_color;
	if is_active then title_bar_color = colors.title_bar_active;

	// Status bar background
	set_shader_color();
	rect(x, y + h - title_bar_height, w, title_bar_height, title_bar_color);

	status_x := x + text_padding;
	status_y :: y + h - title_bar_height;

	icon_y :: status_y + (title_bar_height * 0.5f - icons.height * 0.5f);
	text_y :: status_y + (title_bar_height * 0.5f - font_ui.height * 0.5f);
	name_y :: status_y + (title_bar_height * 0.5f - font_ui_b.height * 0.5f);

	// Title bar icons
	set_shader_font(&icons);

	text(status_x, icon_y, get_icon_for_buffer(buf), colors.title_bar_text_color);
	status_x += item_spacing;

	if macros.is_recording && is_active {
		color := colors.macro_record_icon_color;
		color.w = (math.sin(cast(f32) get_ticks() * 6.f) + 1.f) * 0.5f;
		text(status_x, icon_y, icon(ICON_CIRCLE), color);
		status_x += item_spacing;
		redraw();
	}
	if buf.missing_on_disk {
		text(status_x, icon_y, icon(ICON_WARNING), colors.warning_color);
		status_x += item_spacing;

	}
	if has_changes {
		text(status_x, icon_y, icon(ICON_CHANGES), colors.modification_indicator_color);
		status_x += item_spacing;
	}
	if (buf.flags & BufferFlags.READONLY) == BufferFlags.READONLY {
		text(status_x, icon_y, icon(ICON_READONLY), colors.modification_indicator_color);
		status_x += item_spacing;
	}

	// Title bar info
	set_shader_font(&font_ui_b);
	text(status_x, name_y, buf.name, colors.title_bar_text_color);
	set_shader_font(&font_ui);

	title := str_make(256, application_context.temporary_allocator);
	str_concat(&title, "Ln: ", cursor.row+1, "    Col: ", cursor.col+1);

	if is_selection_active(buf, editor.cursor_index) {
		selected_chars, selected_rows :: count_characters_and_rows_in_selection(buf, editor.cursor_index);
		if selected_rows > 0 {
			str_concat(&title, "    Lns: ", selected_rows + 1);
		}
		str_concat(&title, "    Chars: ", selected_chars, "    ");
	} else {
		str_append(&title, "    ");
	}

	str_concat(&title, FILE_TYPE[auto buf.file_type].name, "    ", line_ending_name);

	if buf.lsp.version > 0 {
		str_concat(&title, "    LSP: ", if lsp.server_name.len == 0 then "N/A" else lsp.server_name);
	}

	if buf.is_word_wrap_enabled {
		str_concat(&title, "    WRAP ");
	}

	name_size :: text_size(buf.name, &font_ui_b);
	status_x += name_size + item_spacing;
	text(status_x, text_y, title, colors.title_bar_text_color);

	if is_active {
		draw_last_status_message(status_x, h - title_bar_height, w, ShadowMode.NONE);
	}

	// Mouse input
	if is_point_in_rect(x, y, w, h, mouse.position.x, mouse.position.y) {
		mouse.hover_elem_id = loc.hash;
	}

	set_cursor_under_mouse := false;

	if mouse.last_hover_elem_id == loc.hash {
		if is_point_in_rect(x, y, w, h-title_bar_height, mouse.position.x, mouse.position.y) {
			set_cursor(CursorShape.IBEAM);

			if is_lmb_press() {
				set_mode(Mode.TEXT_EDIT);
				active_editor = index;
				clear_selection(buf, editor.cursor_index);
				set_cursor_under_mouse = true;
			} else if is_lmb_dragging_start() {
				start_selection(buf, editor.cursor_index);
			}

			if math.abs(mouse.scroll) > 0.f {
				top := editor.top - auto (mouse.scroll * 5.f);
				if top < 0 {
					top = 0;
				} else if top+2 >= virtual_lines_count {
					top = auto (virtual_lines_count - 2);
				}
				start_vertical_animation(editor, top, 0.01f);
			}

			if is_lmb_dbl_press() {
				handled := false;
				if !has_selection(buf, editor.cursor_index) && is_flag(buf.flags, BufferFlags.PARSE_FILE_LINKS) {
					// Cursor position is set on press, release should have correct position already.
					link, found :: get_file_link_under_cursor(buf, cursor.position);
					if found {
						handled = true;
						open_file_link_in_other_split(buf, &link);
					}
				}
				if !handled {
					select_word(editor, buf);
					set_cursor_under_mouse = false;
				}
			}
		} else {
			// Title bar area...
			set_cursor();
		}
	}

	if set_cursor_under_mouse || is_lmb_dragging(loc.hash) {
		// Calculate the position of cursor in the text based on the click position.
		virtual_row :: (cast(s32) ((mouse.position.y - ty) / line_height)) + editor.top;
		if virtual_row >= 0 {
			position: s64;
			if virtual_row < virtual_lines_count {
				line        :: peek_virtual_row(editor, buf, virtual_row);
				virtual_col :: get_character_count_to_fit(trim_right(line, "\n\r"), &font, mouse.position.x - tx);
				row, col    :: virtual_row_col_to_raw(editor, buf, virtual_row, virtual_col);

				position = get_closest_cursor_row_col_position(buf, row, col);
			} else {
				position = get_last_position_in_buffer(buf);
			}

			if position != cursor.position {
				set_cursor_position(buf, editor.cursor_index, position);
			}
		}

		reset_caret_blinking();
	}

	editor.prev_frame_cursor_position = virtual_cursor.position;
	#if IS_DEBUG && EDITOR_DEBUG { draw_debug(editor, buf, x, y, w, h); }
}

draw_command_editor :: fn (index: s32, x: f32, y: f32, w: f32, h: f32, title := "", hint := "", loc := #call_location) {
	using draw;
	using Metric;

	editor :: &editors[index];
	if editor.buffer_index == -1 { return; }
	buf :: &buffers[editor.buffer_index];

	use_block_caret :: settings.block_caret && !(is_selection_active(buf, editor.cursor_index) && settings.change_caret_on_selection);

	is_active       :: active_editor == editor.index;
	line_height     :: metrics[auto LINE_HEIGHT ];
	text_padding    :: metrics[auto TEXT_PADDING];

	// Draw background
	set_shader_color();
	// draw_shadow(x, y, w, h, ShadowMode.BOTTOM);
	// rect(x, y, w, h, colors.command_background_color);

	title_size :: text_size(icon(ICON_SEARCH), &icons).width + text_padding;

	title_x :: x + text_padding;
	text_x  := x + text_padding + title_size;
	text_y  :: y + text_padding;

	scissor_x :: text_x;

	line_w :: w-text_padding*2.f-title_size;

	cursor :: get_cursor(buf, editor.cursor_index);
	line   :: peek_row(buf, 0);

	char_under_cursor :: peek_position(buf, cursor.position);

	cursor_x :: text_size(line, &font, auto cursor.position);
	cursor_w := 2.f;
	if use_block_caret {
		cw :: text_size(char_under_cursor, &font);
		cursor_w = cw;
		if cursor_w == 0.f {
			w :: text_size("X", &font);
			cursor_w = w;
		}
	}
	update_editor_x_offset(editor, line_w, cursor_x);
	text_x -= editor.sliding.horizontal_offset;

	text_base_line_y :: text_y + (line_height * 0.5f - font.height * 0.5f);

	// title:

	set_shader_font(&icons);
	text(title_x, text_base_line_y + 2.f, icon(ICON_SEARCH), colors.foreground_color);
	set_shader_font(&font);

	// text(title_x, text_base_line_y, title, colors.command_title_color);
	title_color :: colors.command_foreground_color;
	text(text_x, text_y, title, .{ title_color.x, title_color.y, title_color.z, 0.4f });
	if hint.len > 0 {
		hint_w :: text_size(hint, &font);
		text(x + w - hint_w - text_padding, text_base_line_y, hint, colors.command_title_color);
	}

	set_scissor(scissor_x, y, line_w, h);

	set_shader_color();

	// draw selection
	{
		start, end :: get_selection_range(buf, editor.cursor_index);
		if end > start {
			color := colors.selection_background_color;
			if !is_active { color = colors.selection_background_inactive_color; }

			draw_highlight_range(buf, editor, text_x, text_y, start, end, 0, line.len, color);
		}
	}

	// draw cursor
	if is_active && caret.visible {
		color := colors.cursor_background_color;
		rect(math.round(text_x + cursor_x), text_y, cursor_w, line_height, color);
	}

	set_shader_font(&font);

	{ // Edit line (just current one).
		if line.len > 0 {
			if use_block_caret && caret.visible {
				lhs, rhs: string_view;
				str_split_at_index(line, auto cursor.position, &lhs, &rhs);
				str_split_at_index(rhs, auto char_under_cursor.len, null, &rhs);
				lhs_size :: text_size(lhs, &font);

				text(text_x, text_base_line_y, lhs, colors.command_foreground_color);
				text(text_x + lhs_size, text_base_line_y, char_under_cursor, colors.cursor_foreground_color);
				text(text_x + lhs_size + cursor_w, text_base_line_y, rhs, colors.command_foreground_color);
			} else {
				text(text_x, text_base_line_y, line, colors.command_foreground_color);
			}
		}
	}

	flush();
	clear_scissor();

	// Mouse input
	if is_point_in_rect(x, y, w, h, mouse.position.x, mouse.position.y) {
		mouse.hover_elem_id = loc.hash;
	}
	if mouse.last_hover_elem_id == loc.hash {
		if is_point_in_rect(text_x, y, w, h, mouse.position.x, mouse.position.y) {
			set_cursor(CursorShape.IBEAM);
			if is_lmb_press() {
				// Calculate the position of cursor in the text based on the click position.
				line :: peek_row(buf, 0);
				col  :: get_character_count_to_fit(trim_right(line, "\n\r"), &font, mouse.position.x - text_x);
				try_set_cursor_row_col(buf, editor.cursor_index, 0, col);
				reset_caret_blinking();
			}
		} else {
			// Title bar area...
			set_cursor();
		}
	}
}

draw_last_status_message :: fn (x: f32, y: f32, w: f32, shadow := ShadowMode.BOTTOM) bool {
	using Metric;

	has_one, kind, text :: last_message();
	if !has_one { return false; }

	title_bar_height :: metrics[auto TITLE_BAR_HEIGHT];
	item_spacing     :: metrics[auto ITEM_SPACING    ];
	text_padding     :: metrics[auto TEXT_PADDING    ] * 2.f;
	rounding         :: metrics[auto CORNER_ROUNDING];

	background_color, foreground_color :: get_status_bar_colors(kind);

	draw.set_shader_color();
	draw_shadow(x, y, w, title_bar_height, shadow);
	draw.rect_rounded(x, y, w, title_bar_height, rounding, background_color, background_color);

	draw.set_shader_font(&icons);
	draw.text(x + text_padding, y + (title_bar_height*0.5f - icons.height*0.5f), icon(ICON_BELL), foreground_color);

	draw.set_shader_font(&font_ui);
	draw.text(x + text_padding + item_spacing, y + (title_bar_height*0.5f - font_ui.height*0.5f), text, foreground_color);
	return true;
}

center_view :: fn (editor: *Editor) {
	assert(editor);
	buf :: &buffers[editor.buffer_index];
	assert(!buf.is_removed);

	cursor :: get_virtual_cursor(editor, buf);

	first_row    :: editor.top;
	visible_rows :: editor.visible_lines;
	if visible_rows < 2 { return; }

	top :: math.max(0, first_row + (cursor.row - (first_row + visible_rows / 2)));
	if top != editor.top {
		start_vertical_animation(editor, top);
	}
}

get_file_link_under_cursor :: fn (buf: *Buffer, cursor_position: s64) (FileLink, bool) {
	line, line_start_position :: peek_row_without_new_line(buf, count_rows_to_position(buf, cursor_position));
	link, found := get_file_link_at_position(line, cursor_position - line_start_position);
	if !found then return link, false;
	link.start += line_start_position;
	link.end   += line_start_position;
	return link, true;
}

draw_peek_text_box :: fn (active_editor_x: f32, active_editor_y: f32, active_editor_w: f32, active_editor_h: f32, text: string_view, bg_color: v4, fg_color: v4) {
	using Metric;

	r                :: metrics[auto CORNER_ROUNDING];
	line_height      :: metrics[auto LINE_HEIGHT];
	text_padding     :: metrics[auto TEXT_PADDING];
	shadow_size      :: metrics[auto SHADOW_SIZE];
	title_bar_height :: metrics[auto TITLE_BAR_HEIGHT];

	text_font :: &font;

	px := active_editor_x + shadow_size;
	py := active_editor_y + active_editor_h - title_bar_height - shadow_size * 2.f;
	pw := active_editor_w - shadow_size * 2.f;

	lines :: calculate_line_offsets(text, pw-(text_padding*2.f), text_font);

	ph := (line_height * auto lines.len) + text_padding * 2.f;
	py -= ph;

	draw_shadow(px, py, pw, ph, ShadowMode.ALL);
	draw.rect_rounded(px, py, pw, ph, r, bg_color, bg_color);
	px += text_padding;
	py += text_padding;

	draw.set_shader_font(text_font);

	loop i := 0; i < lines.len; i += 1 {
		line :: string_view.{ lines[i].len, &text[lines[i].start_index] };
		draw.text(px, py, line, fg_color);
		py += line_height;
	}
}

#scope_private

EDITOR_DEBUG :: false;

start_vertical_animation :: fn (editor: *Editor, top: s32, speed := DEFAULT_ANIMATION_SPEED) {
	using AnimationInterpolation;
	using Metric;

	sliding      :: &editor.sliding;
	line_height  :: metrics[auto LINE_HEIGHT ];

	if editor.top == top then return;
	if !settings.smooth_movement {
		editor.top = top;
		return;
	}

	start  :: (line_height * auto editor.top) - sliding.vertical_offset;
	end    :: line_height * auto top;
	// interp :: if is_animating(&sliding.vertical) then LINEAR else SMOOTH_STEP;
	interp :: LINEAR;

	start_animation(&sliding.vertical, start, end, speed, interp);
	redraw();
}

update_editor_x_offset :: fn (editor: *Editor, line_w: f32, cursor_x: f32) {
	sliding :: &editor.sliding;

	result := sliding.horizontal_offset;

	if (editor.wrap.virtual_lines.len > 0) {
		result = 0.f;
	} else if line_w > 0.f {
		c :: cursor_x - result;
		pilot_char_w :: draw.text_size("X", &font);
		t := pilot_char_w * 6.f;
		t = math.min(t, line_w * 0.2f);
		if c < t || c > line_w - t {
			result = cursor_x - line_w * 0.5f;
		}
	}

	result = math.max(0.f, result);
	if !settings.smooth_movement {
		sliding.horizontal_offset = result;
		return;
	}

	if result != sliding.horizontal_offset && !is_animating(&sliding.horizontal) {
		start_animation(&sliding.horizontal, sliding.horizontal_offset, result, DEFAULT_ANIMATION_SPEED);
	}
	sliding.horizontal_offset = animate(&sliding.horizontal);
	if is_animating(&sliding.horizontal) {
		redraw();
	}
}

draw_inline_error :: fn (editor: *Editor, x: f32, y: f32, w: f32, line: string_view, loc: *ErrorLocation, highlight_only: bool) {
	using draw;
	using Metric;

	line_height  :: metrics[auto LINE_HEIGHT ];
	item_spacing :: metrics[auto ITEM_SPACING];
	text_padding :: metrics[auto TEXT_PADDING];

	fg_color := colors.error_color;
	bg_color := colors.inline_error_background_color;
	ic       := icon(ICON_ERROR);

	message: string_view;
	str_split_by_first(loc.message, '\n', &message);
	message = trim_right(message, " \t\r");

	if loc.kind == ErrorLocation.kind.WARNING {
		fg_color = colors.warning_color;
		bg_color = colors.inline_warning_background_color;
		ic       = icon(ICON_WARNING);
	}

	bg_color2 := bg_color;
	bg_color2.w = 0.f;

	set_shader_color();
	rect(x, y, w, line_height, [_]v4.{ bg_color2, bg_color, bg_color2, bg_color });
	if highlight_only then return;

	line_size    := text_size(line, &font);
	message_size := text_size(loc.message, &font_ui);
	err_x :: math.max(x + line_size  - editor.sliding.horizontal_offset + item_spacing * 2.f, x + w - text_padding - message_size - item_spacing);

	set_shader_font(&icons);
	text(err_x, y + (line_height * 0.5f - icons.height * 0.5f), ic, fg_color);

	set_shader_font(&font_ui);
	text(err_x + item_spacing, y + (line_height * 0.5f - font_ui.height * 0.5f), message, fg_color);
	set_shader_font(&font);

}

draw_highlight_range :: fn (
	buf: *Buffer,
	editor: *Editor,
	tx: f32, ty: f32, // True base position of the visible code block.
	start: s64, end: s64, // Hightlight positions in the buffer bytes.
	first_visible_position: s64, last_visible_position: s64, // Visible range of code to limit overdraw.
	color: v4)
{
	using draw;

	assert(end > start);
	line_height :: metrics[auto Metric.LINE_HEIGHT];

	first_line_index := editor.top;

	first_selection_row_index :: find_virtual_row_for_position(editor, buf, start, 0);
	last_selection_row_index  :: find_virtual_row_for_position(editor, buf, end, first_selection_row_index);

	loop row_index := first_selection_row_index; row_index <= last_selection_row_index; row_index += 1 {
		row, row_start_position :: peek_virtual_row(editor, buf, row_index);
		if row_start_position < first_visible_position then continue;
		if row_start_position > last_visible_position {
			print_log("Here!");
			break;
		}

		y :: ty + line_height * auto (row_index - first_line_index);
		if row_index == first_selection_row_index {
			// first line
			x_offset :: text_size(row, &font, auto (start - row_start_position));
			w        :: text_size(string_view.{ math.min(end, auto row_start_position + row.len) - start, &row[start - row_start_position] }, &font);
			rect(tx + x_offset, y, w, line_height, color);
		} else if row_index == last_selection_row_index {
			// last line
			w :: text_size(row, &font, auto (end - row_start_position));
			rect(tx, y, w, line_height, color);
		} else {
			// middle
			w :: text_size(row, &font);
			rect(tx, y, w, line_height, color);
		}
	}
}

get_status_bar_colors :: fn (kind: PrintLogKind) (bg: v4, fg: v4) #inline {
	using PrintLogKind;
	white :: rgb(0xffffff);
	black :: rgb(0x0);
	switch kind {
		INFO    { return colors.message_color, white; }
		WARNING { return colors.warning_color, black; }
		ERROR   { return colors.error_color,   white; }
		default;
	}
	return rgb(0xff00ff), white;
}

//
// Line virtualization
//

// @Note 2026-03-28: In case virtual lines are not present (wrapping is disabled or buffer is empty) all virtual
//                   related functions are redirected to regular buffer API.

VirtualLines :: Table(u64, struct { position: s64; len: s32 });

VIRTUAL_ROW_MASK : u64 : 0xFFFFFFFF << 32;

virtual_line_hash :: fn (row: s32, sub_row: s32) u64 #inline {
	return (cast(u64) row << 32) | cast(u64) sub_row;
}

// @Performace 2026-03-28: Goes over whole buffer content!
rebuild_virtual_lines_if_needed :: fn (editor: *Editor, buf: *Buffer, w: f32) {
	wrap_hash :: (cast(u64)buf.hash << 32) | cast(u64)buf.version;
	if !buf.is_word_wrap_enabled {
		tbl_terminate(&editor.wrap.virtual_lines);
		return;
	}
	if wrap_hash == editor.wrap.last_buffer_hash && cast(s32) w == editor.wrap.last_w {
		return;
	}

	editor.wrap.last_buffer_hash = wrap_hash;
	editor.wrap.last_w           = auto w;

	measure_elapsed_ms_begin();
	defer measure_elapsed_ms_end();

	row_num :: get_row_count(buf);

	virtual_lines :: &editor.wrap.virtual_lines;
	tbl_clear(virtual_lines);

	loop i := 0; i < row_num; i += 1 {
		line, position := peek_row(buf, i);

		sub_line := 0;
		rest := line;
		loop {
			left, right :: draw.split_text_to_fit(rest, &font, w, true);
			rest = right;

			tbl_insert(virtual_lines, virtual_line_hash(i, sub_line), .{
					position = position,
					len      = auto left.len,
				});

			position += left.len;
			sub_line += 1;
			if rest.len == 0 then break;
		}
	}
}

get_virtual_lines_count :: fn (editor: *Editor, buf: *Buffer) s64 #inline {
	rebuild_virtual_lines_if_needed(editor, buf, auto editor.wrap.last_w);

	virtual_lines :: &editor.wrap.virtual_lines;
	if virtual_lines.len > 0 then return virtual_lines.len;
	return get_row_count(buf);
}

#scope_public

physical_cursor_to_virtual :: fn (editor: *Editor, buf: *Buffer, cursor: Cursor) Cursor #inline {
	rebuild_virtual_lines_if_needed(editor, buf, auto editor.wrap.last_w);

	virtual_lines :: &editor.wrap.virtual_lines;
	if virtual_lines.len == 0 then return cursor;

	index := tbl_lookup_index(virtual_lines, virtual_line_hash(cursor.row, 0));
	assert(index != -1);
	index = find_virtual_row_for_position(editor, buf, cursor.position, index);

	virtual_row :: index;

	virtual_line :: virtual_lines.values[index];
	virtual_col := 0;
	p := virtual_line.position;
	loop p < cursor.position {
		char :: peek_position(buf, p);
		if char.len == 0              { break; }
		if is_line_end(buf, char) > 0 { break; }

		virtual_col += 1;
		p += char.len;
	}

	return .{
		position        = cursor.position,
		selection_start = cursor.selection_start,
		row             = virtual_row,
		col             = virtual_col,
	};
}

get_virtual_cursor :: fn (editor: *Editor, buf: *Buffer) Cursor #inline {
	rebuild_virtual_lines_if_needed(editor, buf, auto editor.wrap.last_w);

	cursor :: get_cursor(buf, editor.cursor_index);
	if editor.wrap.virtual_lines.len == 0 then return cursor;
	return physical_cursor_to_virtual(editor, buf, cursor);
}

// Just for consistency.
set_virtual_cursor :: fn (editor: *Editor, buf: *Buffer, cursor: Cursor) #inline {
	set_cursor_position(buf, editor.cursor_index, cursor.position);
}

// Just for consistency.
set_virtual_cursor_position :: fn (editor: *Editor, buf: *Buffer, position: s64) #inline {
	set_cursor_position(buf, editor.cursor_index, position);
}

virtual_cursor_to_physical :: fn (editor: *Editor, buf: *Buffer, cursor: Cursor) Cursor #inline {
	rebuild_virtual_lines_if_needed(editor, buf, auto editor.wrap.last_w);

	if editor.wrap.virtual_lines.len == 0 then return cursor;
	return get_cursor_for_position(buf, cursor.position);
}

virtual_row_to_raw :: fn (editor: *Editor, buf: *Buffer, virtual_row: s32) s32 #inline {
	rebuild_virtual_lines_if_needed(editor, buf, auto editor.wrap.last_w);

	virtual_lines :: &editor.wrap.virtual_lines;
	if virtual_lines.len == 0 then return virtual_row;

	assert(virtual_row >= 0 && virtual_row < virtual_lines.len);
	key :: virtual_lines.keys[virtual_row];
	return cast(s32)((key & VIRTUAL_ROW_MASK) >> 32);
}

virtual_row_col_to_raw :: fn (editor: *Editor, buf: *Buffer, virtual_row: s32, virtual_col: s32) (s32, s32) #inline {
	rebuild_virtual_lines_if_needed(editor, buf, auto editor.wrap.last_w);

	virtual_lines :: &editor.wrap.virtual_lines;
	if virtual_lines.len == 0 then return virtual_row, virtual_col;

	assert(virtual_row >= 0 && virtual_row < virtual_lines.len);
	key :: virtual_lines.keys[virtual_row];

	virtual_line :: virtual_lines.values[virtual_row];
	line :: peek_virtual_row(editor, buf, virtual_row);

	col_offset := 0;
	loop c := 0; c < virtual_col && col_offset < line.len; c += 1 {
		char_len :: get_character_len(line[col_offset]);
		if char_len == 0 then break;
		col_offset += auto char_len;
	}

	physical_row :: cast(s32)((key & VIRTUAL_ROW_MASK) >> 32);
	physical_col :: count_cols_to_position(buf, virtual_line.position + col_offset);

	return physical_row, physical_col;
}

peek_virtual_row :: fn (editor: *Editor, buf: *Buffer, virtual_row_index: s32) (line: string_view, start_position: s64) #inline {
	rebuild_virtual_lines_if_needed(editor, buf, auto editor.wrap.last_w);

	virtual_lines :: &editor.wrap.virtual_lines;
	if virtual_lines.len == 0 then return peek_row(buf, virtual_row_index);

	if virtual_row_index < 0 || virtual_row_index >= virtual_lines.len then return "", 0;
	virtual_line :: virtual_lines.values[virtual_row_index];

	return .{ virtual_line.len, &buf.bytes[virtual_line.position] }, virtual_line.position;
}

peek_virtual_row_without_new_line :: fn (editor: *Editor, buf: *Buffer, virtual_row_index: s32) (text: string_view, start_index: s64, len_with_new_line: s32) #inline {
	row, start_position  := peek_virtual_row(editor, buf, virtual_row_index);
	len_with_new_line :: cast(s32) row.len;
	row  = trim_right(row, "\r\n");
	return row, start_position, len_with_new_line;
}

find_virtual_row_for_position :: fn (editor: *Editor, buf: *Buffer, position: s64, start_row_index: s32 = 0) s32 #inline {
	rebuild_virtual_lines_if_needed(editor, buf, auto editor.wrap.last_w);

	virtual_lines :: &editor.wrap.virtual_lines;
	if virtual_lines.len == 0 then return find_row_for_position(buf, position, start_row_index);

	index := start_row_index;
	loop ; index < virtual_lines.len - 1; index += 1 {
		virtual_line :: virtual_lines.values[index];
		last_position_in_line :: virtual_line.position + virtual_line.len;
		if position < last_position_in_line then break;
	}
	return index;
}

// Returns true in case the line in wrapped at the end.
is_virtual_row_wrapped_down :: fn (editor: *Editor, buf: *Buffer, virtual_row_index: s32) bool #inline {
	rebuild_virtual_lines_if_needed(editor, buf, auto editor.wrap.last_w);

	virtual_lines :: &editor.wrap.virtual_lines;
	if virtual_lines.len == 0 then return false;

	if virtual_row_index < 0 || virtual_row_index >= virtual_lines.len then return false;
	key :: virtual_lines.keys[virtual_row_index] & VIRTUAL_ROW_MASK;
	return virtual_row_index+1 < virtual_lines.len && (virtual_lines.keys[virtual_row_index+1] & VIRTUAL_ROW_MASK) == key;
}

is_virtual_row_wrapped_up :: fn (editor: *Editor, buf: *Buffer, virtual_row_index: s32) bool #inline {
	rebuild_virtual_lines_if_needed(editor, buf, auto editor.wrap.last_w);

	virtual_lines :: &editor.wrap.virtual_lines;
	if virtual_lines.len == 0 then return false;

	if virtual_row_index < 0 || virtual_row_index >= virtual_lines.len then return false;
	key :: virtual_lines.keys[virtual_row_index] & VIRTUAL_ROW_MASK;
	return virtual_row_index-1 >= 0 && (virtual_lines.keys[virtual_row_index-1] & VIRTUAL_ROW_MASK) == key;
}

get_virtual_row_count_in_line :: fn (editor: *Editor, buf: *Buffer, virtual_row_index: s32) (count: s32, first_virtual_row: s32)  #inline {
	rebuild_virtual_lines_if_needed(editor, buf, auto editor.wrap.last_w);

	virtual_lines :: &editor.wrap.virtual_lines;
	if virtual_lines.len == 0 then return 1, virtual_row_index;

	if virtual_row_index < 0 || virtual_row_index >= virtual_lines.len then return 0, 0;
	key :: virtual_lines.keys[virtual_row_index] & VIRTUAL_ROW_MASK;
	first_virtual_row_index := tbl_lookup_index(virtual_lines, key);
	assert(first_virtual_row_index != -1);

	count := 0;
	loop i := first_virtual_row_index; i < virtual_lines.len; i += 1 {
		if (virtual_lines.keys[i] & VIRTUAL_ROW_MASK) != key then break;
		count += 1;
	}

	return count, first_virtual_row_index;
}

#scope_private

draw_debug :: fn (editor: *Editor, buf: *Buffer, x: f32, y: f32, w: f32, _: f32) #maybe_unused {
	using draw;
	set_shader_font(&font);

	ux := x + w - 600.f;
	uy := y + 10.f;
	color := rgb(0xff00ff);

	position :: get_cursor_position(buf, editor.cursor_index);
	notify_buffer_name := "-";
	if notify_changes_to_buffer != -1 {
		notify_buffer_name = buffers[notify_changes_to_buffer].name;
	}

	text(ux, uy, tprint("Position:  %", position), color); uy += font.height;
	text(ux, uy, tprint("Cursor ID: %", editor.cursor_index), color); uy += font.height;
	text(ux, uy, tprint("Undo len:  %", buf.undo.len), color); uy += font.height;
	text(ux, uy, tprint("Undo top:  %", buf.undo_top), color); uy += font.height;
	text(ux, uy, tprint("Rows:      %", get_row_count(buf)), color); uy += font.height;
	text(ux, uy, tprint("Notify:    [%] %", notify_changes_to_buffer, notify_buffer_name), color); uy += font.height;

	uy += 20.f;

	loop i := buf.undo.len-1; i >= 0; i -= 1 {
		if i > buf.undo_top {
			color = rgb(0xbbbbbb);
		} else {
			color = rgb(0xff00ff);
		}

		rec :: &buf.undo[i];
		text(ux, uy, tprint("[%]", rec.kind), color); uy += font.height;
	}

	ux = x + w - 200.f;
	uy = y + 10.f;

	rl  :: &recent_locations;
	text(ux, uy, tprint("Index:  %", rl.index), color); uy += font.height;
	loop i := 0; i < rl.stack.len; i += 1 {
		if i == rl.index {
			color = rgb(0x00ff00);
		} else {
			color = rgb(0xff00ff);
		}

		editor_index :: rl.stack[i];
		buf :: get_editor_buffer(&editors[editor_index]);
		text(ux, uy, tprint("%", buf.name), color); uy += font.height;
	}
}
