//
// Build errors
//

ErrorLocation :: struct {
	kind: enum { ERROR; WARNING; };
	message:   string_view;
	file:      string_view;
	file_hash: u32;
	line_hash: u32;
	line:      s32;
	col:       s32;
	is_hidden: bool;
};

error_list:       [..]ErrorLocation;
error_list_index:     s64;
error_marker_visible: bool;

clear_error_list :: fn () {
	error_list.len   =  0;
	error_list_index = -1;
	error_marker_visible = false;

	if mode == Mode.PEEK_ERROR then set_mode(Mode.TEXT_EDIT);
}

// Compilation errors are in the list and shown only if the line with error is focused and not changed.
get_current_compilation_error :: fn () *ErrorLocation {
	if !error_marker_visible then return null;
	if error_list.len == 0 || error_list_index == -1 then return null;
	return &error_list[error_list_index];
}

//
// Shell links
//

FileLink :: struct {
	start: s64;
	end:   s64;

	filepath: string_view; // Valid until source buffer contains this string.
	ln:       s32;
	cl:       s32;
}

get_file_link_at_position :: fn (subject: string_view, position: s64) (FileLink, bool) {
	// measure_elapsed_ms_begin();
	// defer measure_elapsed_ms_end();

	if !settings.parse_file_links then return .{}, false;

	links :: parse_valid_clang_like_file_link(subject);
	loop i := 0; i < links.len; i += 1 {
		link :: &links[i];
		if link.start <= position && link.end > position {
			return links[i], true;
		}
	}

	return .{}, false;
}

//
// Recent locations
//

RecentLocation :: struct {
	editor_index: s32;
	buffer_index: s32;
	hash:         u32;

	row: s32;
	col: s32;
}

recent_locations: struct {
	stack: [..]RecentLocation;
	index:     s32;

	skip_next_update: bool;
	force_new_record: bool;
};

init_recent_locations :: fn () {
	recent_locations.index = -1;
}

terminate_recent_locations :: fn () {
	array_terminate(&recent_locations.stack);
}

recent_location_force_new_record :: fn () #inline {
	recent_locations.force_new_record = true;
}

update_recent_locations :: fn (editor: *Editor, buf: *Buffer) {
	if editor.index == workspace.command_editor then return;
	if macros.is_replaying then return;
	if recent_locations.skip_next_update {
		recent_locations.skip_next_update = false;
		return;
	}

	cursor :: get_cursor(buf, editor.cursor_index);

	last_location: *RecentLocation;
	if recent_locations.stack.len > 0 {
		index :: recent_locations.stack.len-1;
		last_location = &recent_locations.stack[index];

		if last_location.editor_index != editor.index || last_location.buffer_index != buf.index || last_location.hash != buf.hash || (recent_locations.force_new_record && cursor.row != last_location.row) {
			last_location = null;
		}
	}

	if !last_location {
		recent_locations.stack.len = recent_locations.index+1;
		last_location = array_push(&recent_locations.stack, .{
				editor_index = editor.index,
				buffer_index = buf.index,
				hash         = buf.hash
			});

		recent_locations.index += 1;
	}

	assert(last_location);

	last_location.row = cursor.row;
	last_location.col = cursor.col;

	recent_locations.force_new_record = false;
}

clear_recent_locations :: fn () #inline {
	recent_locations.stack.len        =  0;
	recent_locations.index            = -1;
	recent_locations.skip_next_update = false;
	recent_locations.force_new_record = false;
}

jump_to_previous_location :: fn () bool {
	recent_locations.skip_next_update = true;

	prev_buf, prev_editor :: get_active_buffer_and_editor();
	prev_cursor           :: get_cursor(prev_buf, prev_editor.cursor_index);

	loop recent_locations.index > 0 {
		recent_locations.index -= 1;
		loc :: &recent_locations.stack[recent_locations.index];
		buf :: &buffers[loc.buffer_index];
		if buf.is_removed then continue;
		if buf.hash != loc.hash then continue;


		editor := &editors[loc.editor_index];
		if editor.is_removed || editor.buffer_index != loc.buffer_index {
			_, editor        = activate_buffer_editor(loc.buffer_index, get_active_split());
			loc.editor_index = editor.index;
		}

		if prev_buf.index == buf.index && prev_editor.index == editor.index && loc.row == prev_cursor.row {
			continue;
		}

		activate_editor(loc.editor_index);
		try_set_cursor_row_col(buf, editor.cursor_index, loc.row, loc.col);

		return true;
	}

	print_warn("No previous location.");
	return false;
}

jump_to_next_location :: fn () bool {
	recent_locations.skip_next_update = true;

	prev_buf, prev_editor :: get_active_buffer_and_editor();
	prev_cursor           :: get_cursor(prev_buf, prev_editor.cursor_index);

	loop recent_locations.index < recent_locations.stack.len-1 {
		recent_locations.index += 1;
		loc :: &recent_locations.stack[recent_locations.index];
		buf :: &buffers[loc.buffer_index];
		if buf.is_removed then continue;
		if buf.hash != loc.hash then continue;

		editor := &editors[loc.editor_index];
		if editor.is_removed || editor.buffer_index != loc.buffer_index {
			_, editor        = activate_buffer_editor(loc.buffer_index, get_active_split());
			loc.editor_index = editor.index;
		}

		if prev_buf.index == buf.index && prev_editor.index == editor.index && loc.row == prev_cursor.row {
			continue;
		}

		activate_editor(loc.editor_index);
		try_set_cursor_row_col(buf, editor.cursor_index, loc.row, loc.col);

		return true;
	}

	print_warn("No next location.");
	return false;
}

//
// Macros
//

macros: struct {
	is_recording: bool;
	is_replaying: bool;
	queue: [..]Command;
	text:  [..]string;

	text_pool: PoolAllocator;
};

#scope_private
init_macros :: fn () {
	macros.text_pool = pool_make(null, 2048);
}

terminate_macros :: fn () {
	array_terminate(&macros.queue);
	array_terminate(&macros.text);

	release_allocator(&macros.text_pool);
}
#scope_public

add_macro_record :: fn {
	fn (command: Command) #inline {
		assert(macros.is_recording);
		array_push(&macros.queue, command);
	};

	fn (char: string_view) #inline {
		assert(macros.is_recording);
		array_push(&macros.queue, Command.UNKNOWN);
		array_push(&macros.text, str_make(char, &macros.text_pool));
	};
}

start_macro_recording :: fn () {
	if macros.is_recording then stop_macro_recording();
	macros.is_recording = true;
	macros.queue.len = 0;
	macros.text.len  = 0;
	toggle_binding :: get_keybinding_for_command(Command.TOGGLE_MACRO_RECORDING);
	reset_allocator(&macros.text_pool);

	print_info("Start recording macro. Use [%] to stop recording.", toggle_binding);
}

stop_macro_recording :: fn () {
	if !macros.is_recording then return;
	macros.is_recording = false;
	replay_binding :: get_keybinding_for_command(Command.REPLAY_MACRO);

	print_info("Stop recording macro. Use [%] to replay recording.", replay_binding);
}

replay_macro :: fn () {
	if macros.is_recording then stop_macro_recording();
	char_index := 0;
	macros.is_replaying = true;

	start_time := get_ticks();
	loop i := 0; i < macros.queue.len; i += 1 {
		if get_ticks() - start_time > 5. {
			print_warn("Execution took too long, stopping now.");
			break;
		}

		cmd :: macros.queue[i];
		if cmd == Command.UNKNOWN {
			handle_text_input(macros.text[char_index]);
			char_index += 1;
		} else {
			target_buf, target_editor :: get_active_buffer_and_editor();
			invoke_command(target_editor, target_buf, cmd);
		}
	}
	macros.is_replaying = false;

	loop i := 0; i < buffers.len; i += 1 {
		if buffers[i].is_removed then continue;
		commit_undo(&buffers[i]);
	}

	print_info("Replay macro.");
}

// Points to the directory containing editor executable (does not contain the last path separator).
exec_dir: string_view;

// Path where to store projects folder and default config, same as exec_dir on Windows.
data_dir: string;

main :: fn () s32 {
	print_log("Version: %.%.%", VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH);
	#if IS_EVALUATION {
		print_log("Running evaluation build.");
	}

	// Setup debug allocator in DEBUG mode.
	prev_allocator: *Allocator;
#if IS_DEBUG {
	debug_allocator = debug_allocator_make(application_context.allocator);
	prev_allocator  = set_allocator_allocator(auto &debug_allocator);
}
	defer set_allocator_allocator(prev_allocator);
	defer temporary_release();

	// debug_allocator_break(&debug_allocator, 864);

	MAIN_THREAD_ID = get_thread_id();
	FONT_DIRECTORY = get_fonts_directory();
	defer str_terminate(&FONT_DIRECTORY);

	mutex_init(&message.mutex);
	defer mutex_terminate(&message.mutex);
	defer str_terminate(&message.text);

	init_workspace();
	defer terminate_workspace();

	// Recent location
	init_recent_locations();
	defer terminate_recent_locations();

	// Create command editor.
	workspace.command_editor = add_editor(add_command_buffer());
	// Messages buffer
	messages_buffer_index = add_builtin_buffer("messages", BufferFlags.PARSE_FILE_LINKS);

	default_logger :: set_logger(&logger);
	defer set_logger(default_logger);

	print_log("Font directory: '%'", FONT_DIRECTORY);

	editor_start_time = get_timestamp();
	print_log("Editor start time is %.", editor_start_time);

	// Resolve editor executable path.
	EXEC_PATH = os_get_exec_path();
	defer str_terminate(&EXEC_PATH);

	head :: path_split(EXEC_PATH);
	exec_dir = head;
	if exec_dir.len > 0 && exec_dir[exec_dir.len-1] == '/' {
		exec_dir.len -= 1;
	}

	if exec_dir.len == 0 {
		print_warn("Unable to resolve the root directory of the editor executable.");
	} else {
		print_log("Editor executable directory: '%'", exec_dir);
	}

	#if PLATFORM == .WINDOWS || IS_DEBUG {
		data_dir = str_make(exec_dir);
	} else if PLATFORM == .LINUX {
		data_dir = get_home();
		if file_exist(tprint("%/.config", data_dir)) {
			str_append(&data_dir, "/.config/tine");
		} else {
			str_append(&data_dir, "/.tine");
		}
		if !file_exist(data_dir) {
			create_dir(data_dir) catch panic("Cannot create config directory at '%' with error: %", data_dir, $);
			print_log("Tine directory created at '%'.", data_dir);
		}
	} else {
		data_dir = get_home();
		str_append(&data_dir, "/.tine");
		if !file_exist(data_dir) {
			create_dir(data_dir) catch panic("Cannot create config directory at '%' with error: %", data_dir, $);
			print_log("Tine directory created at '%'.", data_dir);
		}
	}

	defer str_terminate(&data_dir);

	print_log("Editor data directory: '%'", data_dir);

	DEFAULT_PROJECT_PATH = sprint("%/%", data_dir, DEFAULT_CONFIG_FILE);
	defer str_terminate(&DEFAULT_PROJECT_PATH);

	file_watch = new_filewatch() catch panic($);
	defer delete_filewatch(file_watch);

	init_project();
	defer terminate_project();

	init_macros();
	defer terminate_macros();

	defer array_terminate(&key_binding);

	init_window();
	defer terminate_window();

	draw.init(WINDOW_WIDTH, WINDOW_HEIGHT);
	defer draw.terminate();

	project_dir_path :: tprint("%/%", data_dir, PROJECTS_DIRECTORY);
	if !file_exist(project_dir_path) {
		err :: create_dir(project_dir_path);
		if err {
			print_err(err);
		} else {
			print_log("Projects directory created at '%'.", project_dir_path);
		}
	}

	// Initial readme file on the first start.
	show_help := false;

	// Check whether the default project file exists.
	if !is_default_project_present() {
		show_help = true;
		err :: setup_after_first_run();
		if err {
			print_err(err);
		} else {
			print_log("Default project file created.");
		}
	} else {
		// Try to load it, note that in case of fail, we use default setting implicitly (even if the file
		// content is invalid).
		err :: load_project("");
		if err {
			print_err(err);
		} else {
			print_log("Default project file loaded from disk.");
		}
	}

	print_log("Settings: %", settings);

	defer draw.font_terminate(&font);
	defer draw.font_terminate(&font_ui);
	defer draw.font_terminate(&font_ui_b);
	defer draw.font_terminate(&font_ui_small);
	defer draw.font_terminate(&font_ui_mono);
	defer draw.font_terminate(&icons);

	listing_init();
	defer listing_terminate();

	// Initialize async job system.
	jobs_init();

	lsp_init();
	defer lsp_terminate();

	config_server_init();
	defer config_server_terminate();

	shell_init();
	defer shell_terminate();

	// Cleanup error list...
	defer array_terminate(&error_list);

	// Search stuff
	array_init(&search.results, 1024);

	defer str_terminate(&search.last_subject);
	defer str_terminate(&search.last_replacement);
	defer array_terminate(&search.results);

	set_default_working_directory := true;
	loop i := 1; i < command_line_arguments.len; i += 1 {
		filepath :: command_line_arguments[i];
		err :: open(filepath, .LEFT);
		if err {
			print_err(err);
		} else {
			set_default_working_directory = false;
		}
	}

	if set_default_working_directory {
		set_cwd(get_home2());
	}

	if workspace.active_editor == -1 {
		activate_editor(add_scratch());
	}

	assert(workspace.left != -1);
	assert(workspace.active_editor != -1);

	prev_time := get_ticks();
	prev_frame_delta := -1.f #maybe_unused;

	if show_help then help();
	if settings.maximize_on_start then maximize_window();

	prev_active_editor := -1;
	last_focus_index := 0;

	current_window_title: string;
	defer str_terminate(&current_window_title);

	loop is_running() {
		current_time :: get_ticks();
		frame_delta_time = auto ((current_time - prev_time) * 1000.);
		prev_time = current_time;

		handle_window_event_loop();

		if fonts_dirty {
			fonts_dirty = false;
			rebuild_fonts();
		}

		recalculate_metrics();
		update_caret();

		if shell.job_index == -1 {
			removed_num  := 0;
			reloaded_num := 0;

			event: WatchEvent;
			loop poll_file_changes(file_watch, &event) {
				print_log("Event: %", event);

				is_config :: str_match(event.path, DEFAULT_PROJECT_PATH) || str_match(event.path, project.filepath);

				using WatchEvent.kind;
				switch event.kind {
					FILE_CHANGED {
						if is_config {
							print_log("Config changed!");
							// @Hack 2026-07-18: We duplicate the string here because previous project.filepath is freed once we open a project.
							open_project(tprint(project.filepath)) catch {
								print_err($);
							};
						} else {
							buf :: get_buffer_by_filepath(event.path);
							assert(buf);
							if !buf then continue;
							buf.missing_on_disk = false;

							if event.timestamp == buf.last_write_time then continue;

							print_log("Reload '%' due to content changed on disk.", buf.filepath);
							load_buffer_from_file(buf, buf.filepath) catch {
								print_err($);
								continue;
							};

							if config_server_is_supported_document_type(buf) {
								config_server_document_update(buf);
							}

							reloaded_num += 1;
							print_info("Buffer '%' reloaded from disk.", buf.name);
						}
					}

					FILE_REMOVED {
						if is_config {
							print_warn("Project configuration file was removed from disk: %!", event.path);
						} else {
							buf :: get_buffer_by_filepath(event.path);
							assert(buf);
							if !buf then continue;
							buf.missing_on_disk = true;
							removed_num += 1;
							print_warn("File '%' not found on disk.", event.path);
						}
					}

					DIR_CHANGED, DIR_REMOVED {
						reindex_project();
					}

					default;
				}
			}

			if removed_num > 1 {
				print_warn("Multiple opened files no longer exist on disk. Open messages for more info.");
			} else if reloaded_num > 1 {
				print_info("Multiple opened files reloaded from disk. Open messages for more info.");
			}
		}

		maybe_reindex_current_project();

		update_jobs(); // Also process all responses...

		buf :: get_active_buffer_and_editor();
		if prev_active_editor != workspace.active_editor {
			prev_active_editor = workspace.active_editor;
			buf.last_focus_index = last_focus_index;
			last_focus_index += 1;
		}

		if draw_next_frame {
			draw_next_frame = false;
			draw_frame();
		}

		title :: str_make(128, application_context.temporary_allocator);
		if project.filepath.len == 0 {
			str_append(&title, buf.name);
		} else {
			str_concat(&title, project.name, " - ", buf.name);
		}

		#if IS_EVALUATION {
			str_append(&title, " [EVALUATION]");
		}

		#if IS_DEBUG {
			str_append(&title, " [DEBUG]");
		}

		if !str_match(current_window_title, title) {
			current_window_title.len = 0;
			str_append(&current_window_title, title);
			set_window_title(current_window_title);
		}

		prev_frame_delta = frame_delta_time;
		temporary_reset();
	}

	// Terminate any possible active mode.
	set_mode(Mode.TEXT_EDIT);

	// Terminate all pending jobs. After that it's save to remove all buffers and editors.
	jobs_terminate();

	loop i := 0; i < editors.len; i += 1 { remove_editor(i); }
	loop i := 0; i < buffers.len; i += 1 { remove_buffer(i); }

	array_terminate(&editors);
	array_terminate(&buffers);

	info :: cast(*TypeInfoStruct) typeinfo(Settings);
	loop i := 0; i < info.members.len; i += 1 {
		member :: &info.members[i];
		if member.base_type == typeinfo(string) {
			str :: cast(*string) ptr_shift_bytes(&settings, member.offset_bytes);
			str_terminate(str);
		}
	}

	print_log("DONE.");
	return 0;
}

in_bounds :: fn (arr: []?T, v: s64) bool #inline {
	return v >= 0 && v < arr.len;
}

lookup_font :: fn (font_name: string_view) string_view {
	assert(font_name.len > 0);
	if file_exist(font_name) {
		return font_name;
	}
	if FONT_DIRECTORY.len == 0 { return ""; }
	tmp :: tprint("%/%", FONT_DIRECTORY, font_name);
	if file_exist(tmp) {
		return tmp;
	}
	return "";
}

rebuild_fonts_next_frame :: fn () #inline {
	if !fonts_dirty then redraw();
	fonts_dirty = true;
}

rebuild_fonts :: fn () Error {
	custom_font_path := "";

	if settings.font.len > 0 {
		custom_font_path = lookup_font(settings.font);
		if custom_font_path.len == 0 {
			print_err("Custom font '%' not found. Default expected font file location is %. Note that the full path can be used too.", settings.font, FONT_DIRECTORY);
		}
	}

	assert(settings.font_size    >= MIN_FONT_SIZE && settings.font_size    <= MAX_FONT_SIZE);
	assert(settings.font_ui_size >= MIN_FONT_SIZE && settings.font_ui_size <= MAX_FONT_SIZE);
	size    :: cast(s32) math.round(WINDOW_SCALE * auto settings.font_size);
	ui_size :: cast(s32) math.round(WINDOW_SCALE * auto settings.font_ui_size);

	draw.font_terminate(&font);
	draw.font_terminate(&font_ui);
	draw.font_terminate(&font_ui_b);
	draw.font_terminate(&font_ui_small);
	draw.font_terminate(&font_ui_mono);
	draw.font_terminate(&icons);

	// main font
	use_custom_font := custom_font_path.len > 0;
	if use_custom_font {
		print_log("Using custom font: %", custom_font_path);
		err := draw.font_init_at_size(&font, "", custom_font_path, size);
		if !err {
			err = draw.font_init_at_size(&font_ui_mono, "", custom_font_path, ui_size);
		}
		if err {
			print_err(err);
			use_custom_font = false;
		}
	}

	if !use_custom_font {
		// Load defautl bundled font.
		draw.font_init_at_size_from_memory(&font, FONT_DATA, size) catch panic($);
		draw.font_init_at_size_from_memory(&font_ui_mono, FONT_DATA, ui_size) catch panic($);
		current_font_hash = 0;
	}

	draw.font_init_at_size_from_memory(&font_ui, FONT_UI_DATA, ui_size) catch panic($);
	draw.font_init_at_size_from_memory(&font_ui_b, FONT_UI_B_DATA, ui_size) catch panic($);
	draw.font_init_at_size_from_memory(&font_ui_small, FONT_UI_DATA, ui_size - 4) catch panic($);

	// Set tab size!
	font.tab_size = settings.tab_size;

	draw.font_init_at_size_from_memory(&icons, ICON_DATA, ui_size+2, .{}, 0xEB32) catch panic($);
	icons.centering_offset_y = auto (cast(f32)(ui_size + 2) * 0.5f);

	return OK;
}

get_active_buffer_and_editor :: fn () (*Buffer, *Editor) #inline {
	editor :: &editors[workspace.active_editor];
	assert(editor.buffer_index != -1);
	buf :: &buffers[editor.buffer_index];
	assert(!buf.is_removed);

	return buf, editor;
}

get_last_active_buffer_and_editor :: fn () (*Buffer, *Editor) #inline {
	assert(workspace.last_active_text_editor != -1);
	editor :: &editors[workspace.last_active_text_editor];
	assert(editor.buffer_index != -1);
	buf :: &buffers[editor.buffer_index];
	assert(!buf.is_removed);

	return buf, editor;
}

// Returns true in case the mode was changed.
set_mode :: fn (m: Mode) bool #inline {
	using Mode;
	if m == mode then return false;

	notify_changes_to_buffer = -1;

	switch mode {
		GOTO_LINE;
		TEXT_EDIT         { workspace.last_active_text_editor = workspace.active_editor; }
		OPEN_FROM_DRIVE   { open_from_drive_mode_terminate();        }
		QUICK_OPEN        { quick_open_mode_terminate();             }
		SAVE_TO_DRIVE     { open_from_drive_mode_terminate();        }
		RUN_COMMAND       { run_command_mode_terminate();            }
		SEARCH_FILE       { search_mode_terminate();                 }
		OPEN_PROJECT      { open_project_mode_terminate();           }
		SEARCH_IN_PROJECT { search_in_project_mode_terminate();      }
		COMPLETION        { completion_mode_terminate();             }
		REPLACE           { replace_mode_terminate();                }
		PEEK_ERROR        { peek_error_mode_terminate();             }
		LIST_FUNCTIONS    { list_functions_mode_terminate();         }
		SHELL_RUN         { shell_run_mode_terminate();              }
		SHUTDOWN          { shutdown_mode_terminate();               }
		CLOSE             { shutdown_mode_terminate();               }

		default;
	}

	mode = m;

	switch m {
		TEXT_EDIT {
			assert(workspace.last_active_text_editor != -1);
			assert(workspace.last_active_text_editor != workspace.command_editor);
			if editors[workspace.last_active_text_editor].is_removed {
				// Use left as a fallback in case prev active mode removed some editors...
				workspace.active_editor = workspace.left;
			} else {
				workspace.active_editor = workspace.last_active_text_editor;
			}
			assert(workspace.active_editor != -1);

			input_mode = InputMode.TEXT;

			assert(workspace.active_editor >= 0 && workspace.active_editor < editors.len);
		}
		GOTO_LINE         { goto_mode_init();                }
		REPEAT            { repeat_mode_init();              }
		OPEN_FROM_DRIVE   { open_from_drive_mode_init();     }
		QUICK_OPEN        { quick_open_mode_init();          }
		SAVE_TO_DRIVE     { open_from_drive_mode_init(true); }
		RUN_COMMAND       { run_command_mode_init();         }
		SEARCH_FILE       { search_mode_init();              }
		OPEN_PROJECT      { open_project_mode_init();        }
		SEARCH_IN_PROJECT { search_in_project_mode_init();   }
		COMPLETION        { completion_mode_init();          }
		REPLACE           { replace_mode_init();             }
		PEEK_ERROR        { peek_error_mode_init();          }
		LIST_FUNCTIONS    { list_functions_mode_init();      }
		SHELL_RUN         { shell_run_mode_init();           }
		SHUTDOWN          { shutdown_mode_init();            }
		CLOSE             { shutdown_mode_init(true);        }

		default;
	}

	// Note: The log here must be called after the actual mode is changed; in case we're in command-mode
	// and last focused buffer is message buffer, the log here cause text change notification in the command-mode
	// causing reset of the current list.
	print_log("Mode % set.", m);

	redraw();
	return true;
}

// Cancel the current mode (e.g. goto line) and switch the editor back to main text edit mode.
set_default_mode :: fn () bool #inline {
	return set_mode(Mode.TEXT_EDIT);
}

get_command_editor_size :: fn () (w: f32, h: f32) #inline {
	line_height  :: metrics.line_ui_height;
	text_padding :: metrics.text_ui_padding;
	return cast(f32) WINDOW_WIDTH, line_height + text_padding * 2.f;
}

last_message :: fn () (exists: bool, kind: PrintLogKind, text: string_view) {
	mutex_lock(&message.mutex);
	defer mutex_unlock(&message.mutex);

	if message.text.len == 0 {
		return false, PrintLogKind.MESSAGE, "";
	}
	text_dup :: tprint(message.text);
	return true, message.kind, text_dup;
}

clear_message :: fn () {
	mutex_lock(&message.mutex);
	defer mutex_unlock(&message.mutex);
	message.text.len  =  0;
	message.kind = .MESSAGE;
}

close_editor :: fn (editor_index: s32) {
	split, split_index :: find_editor_split(editor_index);
	assert(split != .FLOATING, "Cannot close floating editor.");
	assert(split_index != -1, "Cannot close edditor not existing in any split.");

	split_editors :: get_split_editors(split);
	array_erase_keep_order(split_editors, split_index);

	// should_activate := workspace.active_editor == editor_index;
	activate_editor_index := -1;

	if split_editors.len == 0 {
		// Last editor in the split.
		switch split {
			.LEFT  {
				swap(&workspace.left_editors, &workspace.right_editors);
				activate_editor_index = workspace.right;
				workspace.right = -1;
			}

			.RIGHT {
				activate_editor_index = workspace.left;
				workspace.right = -1;
			}

			default;
		}
	} else {
		prev_split_index :: if split_index == 0 then split_editors.len-1 else split_index-1;
		activate_editor_index = (@split_editors)[prev_split_index];
	}

	assert(activate_editor_index != editor_index);

	remove_editor(editor_index);
	if activate_editor_index == -1 {
		// When we end up without any editor, create or reuse scratch.
		assert(workspace.left_editors.len == 0);
		activate_editor_index = add_scratch();
		// should_activate = true;
	}

	assert(activate_editor_index != -1);
	activate_editor(activate_editor_index);
}

// Close the split and leaves the other always as the left one (if we close LEFT all editors
// from left are removed and RIGHT split is used as left one -> right one is left empty).
close_all_in_split :: fn (split: Split) {
	// @Note 2026-06-29: close_editor will modify split editors, so we duplicate.
	allocator :: application_context.temporary_allocator;
	split_editors :: duplicate_slice(get_split_editors_slice(split), allocator) catch {
		panic($);
	};
	loop i := 0; i < split_editors.len; i += 1 {
		close_editor(split_editors[i]);
	}
}

close_buffer :: fn (buffer_index: s32) bool {
	assert(buffer_index >= 0 && buffer_index < buffers.len);
	assert(!buffers[buffer_index].is_removed);
	assert(buffer_index != editors[workspace.command_editor].buffer_index);

	if buffer_index == shell.buffer_index {
		shell.buffer_index = -1;
		// reset error list, we refer to the original buffer strings.
		clear_error_list();
	} else if buffer_index == help_buffer_index {
		help_buffer_index = -1;
	} else if buffer_index == conf_buffer_index {
		conf_buffer_index = -1;
	} else if buffer_index == search_buffer_index {
		search_buffer_index = -1;
	} else if buffer_index == scratch_buffer_index {
		scratch_buffer_index = -1;
	}

	loop i := 0; i < editors.len; i += 1 {
		e :: &editors[i];
		if e.is_removed then continue;
		if e.buffer_index == buffer_index {
			close_editor(e.index);
		}
	}

	// We should not remove buffer for messages.
	if buffer_index == messages_buffer_index then return false;

	buf :: &buffers[buffer_index];
	if buf.lsp.version > 0 {
		lsp_close_document(buf) catch print_err("LSP: %", $);
	}
	remove_buffer(buffer_index);
	return true;
}

// Path must be normalized!
get_buffer_by_filepath :: fn (filepath: string_view) *Buffer {
	hash :: get_file_hash(filepath);

	// resolve buffer
	buffer_index := -1;
	loop i := 0; i < buffers.len; i += 1 {
		buf :: &buffers[i];
		if buf.is_removed { continue; }
		if buf.hash == hash {
			buffer_index = i;
			break;
		}
	}
	if buffer_index == -1 { return null; }
	return &buffers[buffer_index];
}

open :: fn (filepath: string_view, split: Split) Error {
	normalized_path :: normalize_path(filepath) catch return error("Invalid file path: '%'.", filepath);
	print_log("Open from: '%'.", normalized_path);
	buf := get_buffer_by_filepath(normalized_path);
	if !buf {
		buf = &buffers[add_buffer()];
		buf_error :: load_buffer_from_file(buf, normalized_path);
		if buf_error {
			return buf_error;
		}
		if is_lsp_running() && lsp_is_supported_document_type(buf) {
			lsp_open_document(buf) catch print_err("LSP: %", $);
		}
		if config_server_is_supported_document_type(buf) {
			config_server_document_update(buf) catch print_err("CS: %", $);
		}
	}

	assert_buffer(buf.index);
	activate_buffer_editor(buf.index, split);
	return OK;
}

save :: fn (buf: *Buffer, filepath: string_view) Error {
	assert(filepath.len > 0);
	normalized_path :: normalize_path_no_check(filepath) catch return $;
	create_all_dir(path_split(normalized_path).head) catch return $;

	print_log("Saving to: '%'.", normalized_path);
	other_buf :: get_buffer_by_filepath(normalized_path);
	if other_buf {
		// We might have already open file with the same name, so we have to close it to
		// prevent creation of duplicit buffers.
		close_buffer(other_buf.index);
	}
	return save_buffer_to_file(buf, normalized_path);
}

// Open file in the buffer or switch to already existing one and move the cursor to line and col.
open_location :: fn (filepath: string_view, line: s32, col: s32, split: Split) Error {
	err :: open(filepath, split);
	if err { return err; }

	target_buf, target_editor :: get_active_buffer_and_editor();

	goto_line(target_editor, target_buf, line);
	if col >= 0 {
		move_right_by_num_characters(target_editor, target_buf, col);
	} else {
		jump_line_end(target_editor, target_buf);
	}
	// center_view(target_editor);

	recent_location_force_new_record();
	return OK;
}

open_project :: fn (filepath: string_view) Error {
	kill_async_jobs();
	cancel_async_search();

	load_project(filepath) catch return $;

	// Use the first path in the included directories as a working directory since it's supposed to be
	// a project root.
	if project.included_directories.len > 0 {
		set_cwd(project.included_directories[0]);
	}

	print_info("Project % loaded.", project.name);

	if settings.use_lsp {
		start_lsp_server() catch print_err($);
	}

	return OK;
}

detect_filetype :: fn (filename: string_view) FileType {
	using FileType;
	_, ext :: path_splitext(filename);
	extension :: str_make(ext, application_context.temporary_allocator);
	str_lower(&extension);

	allocator :: application_context.temporary_allocator;

	if str_match_one_of(extension, str_split_by(settings.c_extensions, ' ', allocator)) {
		return C;
	}
	if str_match(extension, ".bl") {
		return BL;
	}
	if str_match(extension, ".proj") {
		return PROJ;
	}
	if str_match(extension, ".md") {
		return MD;
	}
	if str_match_one_of(extension, str_split_by(settings.glsl_extensions, ' ', allocator)) {
		return GLSL;
	}
	if str_match_one_of(extension, str_split_by(settings.asm_extensions, ' ', allocator)) {
		return ASM;
	}
	if str_match(extension, ".cs") {
		return CSHARP;
	}
	if str_match(extension, ".blm") {
		return BLM;
	}
	if str_match(extension, ".zig") {
		return ZIG;
	}
	if str_match(extension, ".jai") {
		return JAI;
	}
	return .TEXT;
}

get_icon_for_file_type :: fn (file_type: FileType) string_view {
	using FileType;
	switch file_type {
		PROJ {
			return icon(ICON_PROJECT);
		}
		C, CSHARP, BL, BLM, ZIG {
			return icon(ICON_FILE_CODE);
		}
		default;
	}
	return icon(ICON_FILE);
}

//
// Jobs
//

JobContext :: struct {
	state: enum { RUNNING; DONE; FAILED; KILLED; };
	kind: JobKind;
	name: string_view;

	pid: Pid;

	// Extra shit needed only on Windows.
	win_job_handle:     *u8;
	win_process_handle: *u8;

	stdin:  IoStream;
	stdout: IoStream;
	stderr: IoStream; // Most of the time mirrored to stdout.

	pending:  [..]Request;
	complete: [..]Response;
	mutex:    Mutex;

	kill: bool;
	is_removed: bool;

	exit_code: s32;
	show_progress: bool;
}

Request :: struct {
	job_kind:    JobKind;
	is_pending:  bool;
	allocator:  *Allocator;

	as: union {
		clang_format: ClangFormatRequest;
		shell:        ShellRequest;
		lsp:          LspRequest;
		cs:           ConfigServerRequest;
	}
}

Response :: struct {
	job_kind:   JobKind;
	allocator: *Allocator;
	as: union {
		clang_format: ClangFormatResponse;
		shell:        ShellResponse;
		lsp:          LspResponse;
		cs:           ConfigServerResponse;
	}
}

JobKind :: enum {
	UNKNOWN = 0;
	CLANG_FORMAT;
	SHELL;
	LSP;
	CONFIG_SERVER;
}

Job :: Async2(JobContext, s32);

jobs: [..]Job;
jobs_pools: struct {
	pools:          BucketArray(PoolAllocator);
	available: [..]*Allocator;
	mutex:          Mutex;
};

background_job_indicator: struct {
	active_last_frame: bool;
	t: f32;
};

jobs_init :: fn () {
	mutex_init(&jobs_pools.mutex);
}

jobs_terminate :: fn () {
	kill_async_jobs();

	loop it := bucket_array_begin(&jobs_pools.pools); it; it = bucket_array_iter_next(&jobs_pools.pools, it) {
		release_allocator(&it.value);
	}

	bucket_array_terminate(&jobs_pools.pools);
	array_terminate(&jobs_pools.available);
	mutex_terminate(&jobs_pools.mutex);
}

start_async_job :: fn (kind: JobKind, name: string_view, worker: *fn (ctx: *JobContext) s32) s32 {
	ctx := JobContext.{
		state = JobContext.state.RUNNING,
		name  = name,
		kind  = kind,
	};
	mutex_init(&ctx.mutex, MutexKind.RECURSIVE);

	job: *Job;
	index := -1;
	loop i := 0; i < jobs.len; i += 1 {
		if jobs[i].worker_context.is_removed {
			job   = zeroinit(&jobs[i]);
			index = i;
		}
	}

	if !job {
		index = auto jobs.len;
		job   = zeroinit(array_push(&jobs));
	}

	async2(job, ctx, worker);

	assert(index >= 0);
	return index;
}

remove_async_job :: fn (index: s32) {
	using JobContext.state;

	job :: &jobs[index];
	ctx :: &job.worker_context;

	assert(!ctx.is_removed);

	ctx.kill = true;
	async_wait(job);

	consume_job_results(job, true);

	if ctx.kind == .SHELL {
		shell.job_index = -1;
		if shell.buffer_index != -1 && !buffers[shell.buffer_index].is_removed {
			// @Hack 2026-06-20: We need this in case build output is not automatically focused to parse compilation errors.
			rebuild_coloring_and_indentation_info(&buffers[shell.buffer_index]);
		}
	} else if ctx.kind == .LSP {
		remove_all_buffers_from_lsp();
		lsp.job_index = -1;
	} else if ctx.kind == .CONFIG_SERVER {
		config_server.job_index = -1;
	}

	switch ctx.state {
		DONE   {
			open_shell_command_binding :: get_keybinding_for_command(.OPEN_SHELL);
			show_shell_hint :: ctx.kind == .SHELL && (get_visible_editor_for_buffer(shell.buffer_index) == -1);
			msg :: tprint("Job '%' finished with exit code: %.%",  ctx.name, ctx.exit_code, if show_shell_hint then tprint(" Use [%] to see the output.", open_shell_command_binding) else "");
			if ctx.exit_code == 0 {
				print_info(msg);
			} else {
				print_err(msg);
			}
		}
		KILLED { print_info("Job '%' killed.", ctx.name); }
		FAILED;

		default { panic(); }
	}

	array_terminate(&ctx.pending);
	array_terminate(&ctx.complete);

	mutex_terminate(&ctx.mutex);
	ctx.is_removed = true;
}

kill_async_jobs :: fn () {
	using JobContext.state;

	loop i := 0; i < jobs.len; i += 1 {
		job :: &jobs[i];
		if job.worker_context.is_removed { continue; }
		remove_async_job(i);
	}
	array_terminate(&jobs);
	zeroinit(&jobs);
}

consume_job_results :: fn (job: *Job, is_blocking := false) {
	using JobContext.state;
	using JobKind;

	ctx :: &job.worker_context;
	assert(!ctx.is_removed);

	locked := false;
	if is_blocking {
		locked = true;
		mutex_lock(&ctx.mutex);
	} else {
		locked = mutex_try_lock(&ctx.mutex) catch {
			print_err($);
		};
	}

	if !locked then return;
	defer mutex_unlock(&ctx.mutex);

	response: Response #noinit;
	loop pop_response(ctx, &response) {
		assert(response.job_kind == ctx.kind);
		err: Error;
		switch ctx.kind {
			CLANG_FORMAT  { err = apply_format(ctx.state, &response);        }
			SHELL         { err = apply_shell(ctx.state, &response);         }
			LSP           { err = apply_lsp(ctx.state, &response);           }
			CONFIG_SERVER { err = apply_config_server(ctx.state, &response); }
			default { panic(); }
		}

		if err then print_err(err);

		terminate_response(&response);
		redraw();
	}
}

update_jobs :: fn () {
	using JobContext.state;
	using JobKind;

	loop i := 0; i < jobs.len; i += 1 {
		job :: &jobs[i];
		ctx :: &job.worker_context;
		if ctx.is_removed { continue; }

		consume_job_results(job);

		if ctx.state != RUNNING {
			remove_async_job(i);
		}
	}
}

get_job_context :: fn (index: s32) *JobContext #inline {
	assert(index >= 0 && index < jobs.len);
	return &jobs[index].worker_context;
}

#scope_private
get_allocator :: fn () *Allocator #inline {
	mutex_lock(&jobs_pools.mutex);
	defer mutex_unlock(&jobs_pools.mutex);

	allocator: *Allocator;
	if !array_pop(&jobs_pools.available, &allocator) {
		pool :: pool_make();
		allocator = bucket_array_push(&jobs_pools.pools, pool);
	}
	assert(allocator);
	return allocator;
}

put_allocator :: fn (allocator: *Allocator)  #inline {
	assert(allocator);
	mutex_lock(&jobs_pools.mutex);
	defer mutex_unlock(&jobs_pools.mutex);

	reset_allocator(allocator);
	array_push(&jobs_pools.available, auto allocator);
}
#scope_public

make_request :: fn (ctx: *JobContext) (request: Request, err: Error) {
	assert(ctx);
	allocator :: get_allocator();
	if !allocator then return .{}, error("Cannot create request, queue is full, restart LSP server or try again later.");

	return .{
		job_kind  = ctx.kind,
		allocator = allocator,
	}, OK;
}

push_request :: fn (ctx: *JobContext, request: *Request) {
	assert(request.job_kind == ctx.kind);
	mutex_lock(&ctx.mutex);
	defer mutex_unlock(&ctx.mutex);

	r :: array_push(&ctx.pending);
	memcpy(auto r, auto request, sizeof(@request));
	r.is_pending = true;
}

pop_request :: fn (ctx: *JobContext, request: *Request) bool {
	mutex_lock(&ctx.mutex);
	defer mutex_unlock(&ctx.mutex);
	if array_pop_first(&ctx.pending, request) {
		assert(request.job_kind == ctx.kind);
		return true;
	}
	return false;
}

has_pending_request :: fn (ctx: *JobContext) bool #inline {
	mutex_lock(&ctx.mutex);
	defer mutex_unlock(&ctx.mutex);
	return ctx.pending.len > 0;
}

make_response :: fn (ctx: *JobContext) (response: Response, err: Error) {
	assert(ctx);
	allocator :: get_allocator();
	if !allocator then return .{}, error("Cannot create response, queue is full, restart LSP server or try again later.");

	return .{
		job_kind  = ctx.kind,
		allocator = allocator,
	}, OK;
}

// Consume the 'request' data; meaning they are zero initialized in case the request is pushed
// this way we prevent possible double-free of request data strings.
push_response :: fn (ctx: *JobContext, response: *Response) {
	assert(response.job_kind == ctx.kind);
	mutex_lock(&ctx.mutex);
	defer mutex_unlock(&ctx.mutex);

	r :: array_push(&ctx.complete);
	memcpy(auto r, auto response, sizeof(@response));
	zeroinit(&response.as);
}

// ctx.mutex should be locked before this is called
pop_response :: fn (ctx: *JobContext, response: *Response) bool {
	if array_pop_first(&ctx.complete, response) {
		assert(response.job_kind == ctx.kind);
		return true;
	}
	return false;
}

set_job_progress_indicator :: fn (ctx: *JobContext, v: bool) #inline {
	// @Hack 2026-02-11: This is set from worker thread and read from main thread,
	//                   but it should be fine without locking since we use it only to
	//                   draw indicator.
	ctx.show_progress = v;
}

terminate_request :: fn (request: *Request) {
	put_allocator(request.allocator);
	zeroinit(request);
}

terminate_response :: fn (response: *Response) {
	put_allocator(response.allocator);
	zeroinit(response);
}


check_main_thread :: fn (loc := #call_location) #enable_if IS_DEBUG {
	if MAIN_THREAD_ID != get_thread_id() {
		panic("Location: %:% is expected to be reached only from the main thread!", loc.file, loc.line);
	}
}

is_lmb_down :: fn () bool #inline {
	return is_flag(mouse.state, MouseState.LB_DOWN);
}

is_lmb_press :: fn () bool #inline {
	return is_flag(mouse.state, MouseState.LB_PRESS);
}

is_lmb_dbl_press :: fn () bool #inline {
	return is_flag(mouse.state, MouseState.LB_DBL_PRESS);
}

is_lmb_release :: fn () bool #inline {
	return is_flag(mouse.state, MouseState.LB_RELEASE);
}

is_lmb_dragging_start :: fn () bool #inline {
	return is_flag(mouse.state, MouseState.LB_DRAGGING_START);
}

is_lmb_dragging :: fn {
	fn  (elem_id: u32) bool #inline {
		return mouse.drag_target_elem_id == elem_id && is_flag(mouse.state, MouseState.LB_DRAGGING);
	};
	fn () bool #inline {
		return is_flag(mouse.state, MouseState.LB_DRAGGING);
	};
}

caret: struct {
	visible:    bool;
	blink_t:    f32;
};

reset_caret_blinking :: fn () #inline {
	caret.blink_t    = 0.f;
	caret.visible    = true;
}

TextLine :: struct {
	start_index: s32;
	len: s32;
}

calculate_line_offsets :: fn (text: string_view, fit_to_width: f32, font: *draw.Font) []TextLine {
	acc_width             := 0.f;
	last_whitespace_index := -1;
	last_whitespace_width := 0.f;
	start_index           := 0;

	lines: [..]TextLine;
	array_init(&lines, 32, application_context.temporary_allocator);

	loop index := 0; index < text.len; {
		if text[index] == ' ' || text[index] == '\t' {
			last_whitespace_index = index;
			last_whitespace_width = acc_width;
		} else if text[index] == '\n' {
			array_push(&lines, TextLine.{ start_index = start_index, len = index - start_index + 1 });
			start_index           = index + 1;
			acc_width             = 0.f;
			last_whitespace_index = -1;
			index += 1;
			continue;
		}

		char_len :: get_character_len(text[index]);

		w :: draw.text_size(string_view.{ char_len, &text[index] }, font, -1);
		acc_width += w;

		if acc_width < (fit_to_width/* * WINDOW_SCALE*/){
			index += char_len;
			continue;
		}

		if last_whitespace_index != -1 {
			len :: last_whitespace_index - start_index + 1;
			array_push(&lines, TextLine.{ start_index = start_index, len = len });
			start_index += len;
			acc_width   -= last_whitespace_width;
		} else {
			array_push(&lines, TextLine.{ start_index = start_index, len = index - start_index });
			start_index = index;
			acc_width   = 0.f;
		}
		last_whitespace_index = -1;
		index += char_len;
	}

	if start_index < text.len {
		array_push(&lines, TextLine.{ start_index = start_index, len = auto (text.len - start_index) });
	}

	if lines.len == 0 {
		array_push(&lines, TextLine.{});
	}
	return lines;
}

redraw :: fn () {
	if is_minimized() then return;
	draw_next_frame = true;
}

redraw_immediatelly :: fn () #maybe_unused {
	draw_frame();
}

#scope_private

MAIN_THREAD_ID: u64;

message: Message;
debug_allocator: DebugAllocator;

draw_frame :: fn () {
	using draw;

	begin_frame();
	defer end_frame();

	clear_color(colors.panel_outline);

	{
		active_x, last_active_x: f32;
		x :: 0.f;
		y := 0.f;

		h := cast(f32) WINDOW_HEIGHT;
		w := cast(f32) WINDOW_WIDTH;

		assert(workspace.left != -1);
		if workspace.right != -1 {
			gap :: 2.f;
			w = (0.5f * cast(f32) WINDOW_WIDTH) - gap * 0.5f;

			lx :: x;
			rx :: w + gap;

			draw_text_editor(workspace.left,  lx, y, w, h);
			draw_text_editor(workspace.right, rx, y, w, h);

			if workspace.active_editor == workspace.left {
				active_x = lx;
			} else if workspace.active_editor == workspace.right {
				active_x = rx;
			}

			if workspace.last_active_text_editor == workspace.left {
				last_active_x = lx;
			} else if workspace.last_active_text_editor == workspace.right {
				last_active_x = rx;
			}
		} else {
			draw_text_editor(workspace.left, x, y, w, h);
		}

		PROGRESS_BAR_HEIGHT :: 3.f;
		draw_background_progress_bar(0.f, h - PROGRESS_BAR_HEIGHT, auto WINDOW_WIDTH, PROGRESS_BAR_HEIGHT);

		using Mode;
		switch mode {
			TEXT_EDIT;
			GOTO_LINE         { draw_goto_mode();                          }
			REPEAT            { draw_repeat_mode();                        }
			OPEN_FROM_DRIVE   { draw_open_from_drive_mode();               }
			QUICK_OPEN        { draw_quick_open_mode();                    }
			SAVE_TO_DRIVE     { draw_open_from_drive_mode();               }
			RUN_COMMAND       { draw_run_command_mode();                   }
			SEARCH_FILE       { draw_search_mode(last_active_x, y, w, h);  }
			OPEN_PROJECT      { draw_open_project_mode();                  }
			SEARCH_IN_PROJECT { draw_search_in_project_mode();             }
			REPLACE           { draw_replace_mode(last_active_x, y, w, h); }
			LIST_FUNCTIONS    { draw_list_functions_mode();                }
			SHELL_RUN         { draw_shell_run_mode();                     }
			CHEAT_SHEET       { draw_cheat_sheet_mode();                   }
			SHUTDOWN          { draw_shutdown_mode();                      }
			CLOSE             { draw_shutdown_mode();                      }
			PEEK_ERROR        {
				draw_peek_error_mode(active_x, y, w, h);
			}
			COMPLETION        {
				draw_completion_mode(active_x, y, w, h);
			}

			default;
		}
	}

	flush();
}

recalculate_metrics :: fn () {
	using math;
	line_spacing :: min(max(0.8f, cast(f32)settings.line_spacing / 100.f), 2.f);

	metrics.title_bar_height          = round(font_ui.height * 1.7f);
	metrics.line_height               = round(font.height * line_spacing * 1.2f);
	metrics.line_ui_height            = round(font_ui.height * 1.2f);
	metrics.item_spacing              = round(icons.height * 1.3f);
	metrics.text_padding              = round(font.height  * 0.5f);
	metrics.text_ui_padding           = round(font_ui.height  * 0.5f);
	metrics.title_max_size            = round(font.height  * 25.f);
	metrics.shadow_size               = round(WINDOW_SCALE * 8.f);
	metrics.corner_rounding           = round(WINDOW_SCALE * 4.f);
	metrics.corner_rounding_panel     = round(WINDOW_SCALE * 10.f);
	metrics.list_panel_max_width      = round(WINDOW_SCALE * 1024.f);
	metrics.list_panel_factor         = 0.8f;
	metrics.line_item_height          = round(font_ui.height * 1.6f);
	metrics.command_panel_hints_alpha = 0.5f;
	metrics.command_panel_offset_y    = 50.f;
	metrics.border_line_width         = 2.f;
	metrics.completion_list_width     = round(WINDOW_SCALE * 300.f);
}

file_to_stack :: fn (filepath: string_view) []u8 #comptime {
	bytes :: read_entire_file(filepath) catch panic($);
	return bytes;
}

config_to_stack :: fn (filepath: string_view) []u8 #comptime {
	version :: tprint("%\n\n", VERSION_TEXT);

	bytes := read_entire_file(filepath) catch panic($);
	bytes  = join_slices(version, bytes) catch panic($);

	return bytes;
}

help_to_stack :: fn (filepath: string_view) []u8 #comptime {
	version :: tprint("# Tine Code Editor - %.%.%\n\n", VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH);

	bytes := read_entire_file(filepath) catch panic($);
	bytes  = join_slices(version, bytes) catch panic($);

	return bytes;
}

set_allocator_allocator :: fn (allocator: *Allocator) *Allocator {
	if !allocator { return null; }
	prev_allocator :: application_context.allocator;
	if prev_allocator == &debug_allocator {
		if dump_memory_leaks(auto prev_allocator) > 0 {
			debugbreak;
		}
		debug_allocator_release(auto prev_allocator);
	}
	application_context.allocator = allocator;
	return prev_allocator;
}

set_logger :: fn (func: PrintLogFn) PrintLogFn {
	prev_func :: application_context.print_log_fn;
	application_context.print_log_fn = func;
	return prev_func;
}

// Use this to prevent recursive looping when log is reported while we report logs...
log_reported := false;

logger :: fn (kind: PrintLogKind, file: string_view #maybe_unused, line: s32 #maybe_unused, format: string_view, args: ...) {
	get_message_prefix :: fn (kind: PrintLogKind) string_view {
		using PrintLogKind;
		switch kind {
			WARNING { return "warning: "; }
			ERROR   { return "error: ";   }
			default;
		}
		return "";
	};

	// Prevent looping.
	if log_reported { return; }
	log_reported = true;

	defer fn () {
		log_reported = false;
	}();

	using PrintLogKind;
	switch kind {
		INFO, WARNING, ERROR {
			mutex_lock(&message.mutex);
			defer mutex_unlock(&message.mutex);

			prev_priority :: cast(s32) message.kind;
			next_priority :: cast(s32) kind;

			if next_priority >= prev_priority {
				message.kind     = kind;
				message.text.len = 0;
				str_append(&message.text, tprint(format, args));
			}
		}
		MESSAGE {
			#if !IS_DEBUG { return; }
		}
		default;
	}

	switch kind {
		INFO, WARNING, ERROR { // @Note 2026-06-23: We do not print log messages, they might cause deadlocks.
			index :: messages_buffer_index;
			if index >= 0 && index < buffers.len {
				buf :: &buffers[index];
				if !buf.is_removed {
					msg :: tprint(format, args);
					lock_buffer(buf);
					defer unlock_buffer(buf);
					append_readonly_buffer(buf, tprint("%%\n", get_message_prefix(kind), msg));
					set_all_cursors_position_to_buffer_end(buf);
				}
			}
		}
		default;
	}

	// @Incomplete: We need concept of log file in case we're in release mode. On Windows we don't have
	// a console so there is no stdio initialized and we get the last error notification which is in
	// case of failiure invalid stream error.
	// We also might have some way how to show more than last one message to report all errors without
	// need of log file archeology.
	#if (IS_DEBUG && PLATFORM == Platform.WINDOWS) || PLATFORM != Platform.WINDOWS {
		__print_log_default(kind, file, line, format, args);
	}
}

update_caret :: fn () {
	if !is_focused() {
		caret.visible = true;
		return;
	}

	caret.blink_t += frame_delta_time;
	if caret.blink_t > CARET_BLINK_MS {
		caret.blink_t = 0.f;
		caret.visible = !caret.visible;
		redraw();
	}
}

draw_background_progress_bar :: fn (x: f32, y: f32, w: f32, h: f32) {
	using draw;

	active := false;
	loop i := 0; i < jobs.len; i += 1 {
		ctx :: get_job_context(i);
		if ctx.state != .RUNNING then continue;
		if ctx.show_progress {
			active = true;
			break;
		}
	}

	if !active {
		background_job_indicator.active_last_frame = false;
		return;
	}


	background_job_indicator.t += frame_delta_time;
	if background_job_indicator.t > 2000.f || !background_job_indicator.active_last_frame {
		background_job_indicator.t = w * -0.1f;
	}

	set_shader_color();
	progress_bar_color :: colors.progress_bar;
	rect(x + w * background_job_indicator.t * 0.0005f, y, w * 0.1f, h, progress_bar_color);
	redraw();

	background_job_indicator.active_last_frame = true;
}

//
// Workspace
//

#scope_public

Split :: enum { LEFT; RIGHT; FLOATING; }

workspace: struct {
	left_editors:  [..]s32;
	right_editors: [..]s32;

	left:  s32;
	right: s32;

	active_editor:  s32;
	command_editor: s32;

	// Points to previous active text editor, this might be used in interactive modes where we need the text buffer
	// as context (e.g. search mode).
	last_active_text_editor: s32;
};

#scope_private
init_workspace :: fn () {
	workspace.left                    = -1;
	workspace.right                   = -1;
	workspace.active_editor           = -1;
	workspace.command_editor          = -1;
	workspace.last_active_text_editor = -1;
}

terminate_workspace :: fn () {
	array_terminate(&workspace.left_editors);
	array_terminate(&workspace.right_editors);
}
#scope_public

get_split_editors_slice :: fn (split: Split) []s32 #inline {
	switch split {
		.LEFT  { return workspace.left_editors;  }
		.RIGHT { return workspace.right_editors; }
		default;
	}

	unreachable;
	return .{};
}

get_split_editors :: fn (split: Split) *[..]s32 #inline {
	switch split {
		.LEFT  { return &workspace.left_editors;  }
		.RIGHT { return &workspace.right_editors; }
		default;
	}

	unreachable;
	return .{};
}

find_editor_in_split :: fn (split: Split, editor_index: s32) s32 {
	split_editors :: get_split_editors_slice(split);
	loop i := 0; i < split_editors.len; i += 1 {
		if split_editors[i] == editor_index then return i;
	}

	return -1;
}

find_editor_for_buffer_in_split :: fn (split: Split, buffer_index: s32) s32 {
	assert(buffer_index != -1);
	split_editors :: get_split_editors_slice(split);
	loop i := 0; i < split_editors.len; i += 1 {
		editor_index :: split_editors[i];
		assert(editor_index >= 0 && editor_index < editors.len);
		editor :: &editors[editor_index];
		assert(!editor.is_removed);
		if editor.buffer_index == buffer_index then return editor_index;
	}

	return -1;
}

add_editor_to_split :: fn (split: Split, editor_index: s32) s32 {
	assert(find_editor_in_split(split, editor_index) == -1);
	editors :: get_split_editors(split);
	array_push(editors, editor_index);
	return editor_index;
}

find_editor_split :: fn (editor_index: s32) (split: Split, index: s32) #inline {
	index := find_editor_in_split(.LEFT, editor_index);
	if index != -1 then return .LEFT, index;
	index = find_editor_in_split(.RIGHT, editor_index);
	if index != -1 then return .RIGHT, index;

	return .FLOATING, -1;
}

find_editor_for_buffer :: fn (buffer_index: s32) s32 {
	loop i := 0; i < editors.len; i += 1 {
		editor :: &editors[i];
		if editor.is_removed then continue;
		if editor.buffer_index == buffer_index then return i;
	}
	return -1;
}

has_split :: fn () bool #inline {
	assert(workspace.left != -1);
	return workspace.right != -1;
}

get_active_split :: fn () Split #inline {
	assert(workspace.active_editor != -1);
	if workspace.left == workspace.active_editor {
		return .LEFT;
	} else if workspace.right == workspace.active_editor {
		return .RIGHT;
	}
	assert(false);
	return .FLOATING;
}

get_other_split :: fn () Split #inline {
	if get_active_split() == .LEFT {
		return .RIGHT;
	}
	return .LEFT;
}

// Tries to resolve user-facing editor index for buffer.
get_visible_editor_for_buffer :: fn (buffer_index: s32) s32 {
	assert(workspace.left != -1);
	editor_index := -1;
	if editors[workspace.left].buffer_index == buffer_index {
		editor_index = workspace.left;
	} else if workspace.right != -1 && editors[workspace.right].buffer_index == buffer_index {
		editor_index = workspace.right;
	} else {
		return -1;
	}

	assert_editor(editor_index);
	return editor_index;
}

// Activate existing editor it it's split.
activate_editor :: fn (editor_index: s32) (*Buffer, *Editor) {
	assert_editor(editor_index);

	editor :: &editors[editor_index];
	assert(!editor.is_removed);

	buf   :: &buffers[editor.buffer_index];
	split :: find_editor_split(editor_index);
	switch split {
		.LEFT    { workspace.left  = editor_index; }
		.RIGHT   { workspace.right = editor_index; }
		default;
	}

	// @Incomplete 2026-06-27: Set last active editor here?
	workspace.active_editor = editor_index;
	return buf, editor;
}

activate_command_editor :: fn () (*Buffer, *Editor) #inline {
	return activate_editor(workspace.command_editor);
}

activate_search_editor :: fn () (*Buffer, *Editor) {
	if search_buffer_index == -1 {
		search_buffer_index = add_builtin_buffer("search", BufferFlags.PARSE_FILE_LINKS);
	}
	return activate_buffer_editor(search_buffer_index);
}

activate_buffer_editor :: fn {
	fn (buffer_index: s32, split: Split) (*Buffer, *Editor) {
		assert_buffer(buffer_index);

		editor_index := find_editor_for_buffer_in_split(split, buffer_index);
		if editor_index == -1 {
			editor_index = add_editor_to_split(split, add_editor(buffer_index));
		}

		activate_editor(editor_index);
		return &buffers[buffer_index], &editors[editor_index];
	};

	fn (buffer_index: s32) (*Buffer, *Editor) {
		assert_buffer(buffer_index);
		editor_index := get_visible_editor_for_buffer(buffer_index);
		if editor_index == -1 {
			split := Split.LEFT;
			if has_split() {
				split = get_other_split();
			}
			_, editor :: activate_buffer_editor(buffer_index, split);
			editor_index = editor.index;
		} else {
			activate_editor(editor_index);
		}
		activate_editor(editor_index);
		return &buffers[buffer_index], &editors[editor_index];
	};
}

is_command_editor_buffer :: fn (buf: *Buffer) bool #inline {
	return buf.index == editors[workspace.command_editor].buffer_index;
}

// Returns editor index.
add_scratch :: fn () s32 {
	if scratch_buffer_index == -1 {
		scratch_buffer_index = add_buffer();
	}
	return add_editor_to_split(.LEFT, add_editor(scratch_buffer_index));
}
