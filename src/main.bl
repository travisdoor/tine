FileTypeInfo :: struct {
	name:         string_view;
	comment_with: string_view;
	reindent_on:  string_view;

	// Related to align_assignments command. Each character is treated separately.
	align_on:        string_view;
	lsp_language_id: string_view;
}

FILE_TYPE :: [type_utils.enum_variant_count(FileType)]FileTypeInfo.{
	// Text
	.{
		name = "Text",
	},

	// BL
	.{
		name         = "BL",
		comment_with = "//",
		reindent_on  = "}",
		align_on     = ":=",
	},

	// C/C++
	.{
		name            = "C/C++",
		comment_with    = "//",
		reindent_on     = "}",
		align_on        = "=",
		lsp_language_id = "c",
	},

	// PROJ
	.{
		name         = "Configuration",
		comment_with = "#",
	},

	// Markdown
	.{
		name = "Markdown",
	},

	// GLSL
	.{
		name         = "GLSL",
		comment_with = "//",
		reindent_on  = "}",
		align_on     = "=",
	},

	// ASM
	.{
		name         = "ASM",
		comment_with = ";",
		reindent_on  = ":",
	},

	// C#
	.{
		name            = "C#",
		comment_with    = "//",
		reindent_on     = "}",
		align_on        = "=",
		lsp_language_id = "csharp",
	},

	// BLM
	.{
		name         = "BLM",
		comment_with = ";",
	},

	// zig
	.{
		name            = "Zig",
		comment_with    = "//",
		reindent_on     = "}",
		align_on        = "=",
		lsp_language_id = "zig",
