ListItem :: struct {
	score:      s32;
	base_score: s32;

	icon:    string_view;
	title:   string_view;
	preview: string_view;
	hint:    string_view;
	flags:   ItemFlags;

	index:   s32;
	row:     s32;
	col:     s32;
}

ItemFlags :: enum #flags {
	NONE;
	DIRECTORY;
	HIGHLIGHT;
	MODIFIED;
	MISSING;
}

listing_init :: fn () {
	string_cache[0] = pool_make(null, 2048);
	string_cache[1] = pool_make(null, 2048);

	array_reserve(&list[DEFAULT_LIST_INDEX], 1024*4);
	array_reserve(&list[FILTER_LIST_INDEX],  1024*4);

	mutex_init(&async_search.mutex);
	mutex_init(&visible_list_mutex);
}

listing_terminate :: fn () {
	cancel_async_search();
	mutex_terminate(&async_search.mutex);

	release_allocator(&string_cache[0]);
	release_allocator(&string_cache[1]);
	array_terminate(&list[DEFAULT_LIST_INDEX]);
	array_terminate(&list[FILTER_LIST_INDEX]);
	mutex_terminate(&visible_list_mutex);
}

// @Duplicate 2026-06-20: compute_list_height
get_list_height :: fn (double_line := false, max_item_count := math.S32_MAX) (h: f32, visible_lines: s32) {
	line_height     :: if double_line then metrics.line_ui_height * 2.f else metrics.line_ui_height;
	text_padding    :: metrics.text_ui_padding;

	visible_lines := math.min(cast(s32) (cast(f32) WINDOW_HEIGHT / line_height), max_item_count);
	visible_lines = math.min(visible_lines, auto list[visible_list_index].len);

	return text_padding * 2.f + line_height * auto visible_lines, visible_lines;
}

#scope_private
list_ui_ctx: struct {
	x: f32; y: f32;
	w: f32; h: f32;

	// command editor
	cmd_y: f32;
	cmd_h: f32;

	// list
	list_y: f32;
	list_h: f32;
	item_height:   f32;
	visible_items: s32;

	// hints
	hints_y: f32;
	hints_h: f32;


	is_active: bool;
};
#scope_public

search_list_begin :: fn (two_row_item := false, progress_t := 0.f, prefer_width := 0) {

	compute_list_height :: fn (item_h: f32, list_max_h: f32) (height: f32, visible_items: s32) #inline {
		text_padding :: metrics.text_ui_padding;

		list_h :: math.min(item_h * cast(f32) list[visible_list_index].len, list_max_h-text_padding*2.f);
		visible_items :: cast(s32) (list_h/item_h);
		return item_h * cast(f32) visible_items, visible_items;
	};

	mutex_lock(&visible_list_mutex);
	x, y, w, h, list_y, list_max_h := compute_command_panel_layout(prefer_width);

	item_h :: if two_row_item then math.ceil(metrics.line_item_height*2.5f) else metrics.line_item_height;
	cmd_h  :: math.max(list_y - y, 0.f);

	list_h, visible_items :: compute_list_height(item_h, list_max_h);
	h += list_h;

	draw_command_editor_panel(x, y, w, h, progress_t);

	list_ui_ctx = .{
		x, y,
		w, h,

		// command editor
		y,
		cmd_h,

		// list
		list_y,
		list_h,
		item_h,
		visible_items,

		// hints
		y+h-cmd_h,
		cmd_h,

		is_active = true
	};
}

search_list_end :: fn () {
	mutex_unlock(&visible_list_mutex);
	list_ui_ctx = .{};
}

draw_search_command_editor :: fn (cmd_params: DrawCommandEditorParams) {
	assert(list_ui_ctx.is_active);

	x :: list_ui_ctx.x;
	y :: list_ui_ctx.cmd_y;
	w :: list_ui_ctx.w;
	h :: list_ui_ctx.cmd_h;

	assert(workspace.active_editor == workspace.command_editor);
	draw_command_editor(workspace.command_editor, x, y, w, h, cmd_params);
}

draw_search_hints :: fn (hints: []PanelHint) #inline {
	assert(list_ui_ctx.is_active);

	x :: list_ui_ctx.x;
	y :: list_ui_ctx.hints_y;
	w :: list_ui_ctx.w;
	h :: list_ui_ctx.hints_h;

	draw_command_panel_hints(x, y, w, h, hints, metrics.command_panel_hints_alpha);
}

draw_search_command_list :: fn (loc := #call_location) bool {
	using draw;
	allocator :: application_context.temporary_allocator;

	ctx :: &list_ui_ctx;
	assert(ctx.is_active);

	if ctx.visible_items == 0 then return false;

	text_padding      :: metrics.text_ui_padding;
	item_spacing      :: metrics.item_spacing;
	border_line_width :: metrics.border_line_width;

	item_h :: ctx.item_height;

	// scrolling
	if top_index + ctx.visible_items >= list[visible_list_index].len {
		top_index = math.max(list[visible_list_index].len - ctx.visible_items, 0);
	}

	if last_selected_index != selected_index {
		if selected_index >= top_index + ctx.visible_items {
			top_index = selected_index - ctx.visible_items + 1;
		}
		if selected_index < top_index {
			top_index = selected_index;
		}
	}
	start_index = top_index;

	end_index :: start_index + ctx.visible_items;

	tx := ctx.x + text_padding;
	ty :: ctx.list_y;

	hover_index : s64 = -1;
	{ // Selected line
		set_shader_color();

		if selected_index >= start_index && selected_index < start_index + ctx.visible_items {
			selected_y :: ty + item_h * auto (selected_index - start_index);
			rect(ctx.x+border_line_width, selected_y, ctx.w-border_line_width*2.f, item_h, colors.command_select);
		}

		if mouse.last_hover_elem_id == loc.hash {
			ly := ty;
			loop i := start_index; i < end_index; i += 1 {
				if is_point_in_rect(ctx.x, ly, ctx.w, item_h, mouse.position.x, mouse.position.y) {
					rect(ctx.x+border_line_width, ly, ctx.w-border_line_width*2.f, item_h, colors.selection_background_inactive);
					hover_index = i;
					break;
				}
				ly += item_h;
			}
		}
	}

	item_y := ty;
	loop i := start_index; i < end_index; i += 1 {
		item :: &list[visible_list_index][i];
		item_x := tx;

		available_w := ctx.w - text_padding * 2.f;

		{ // Separator
			set_shader_color();
			border_line_width :: metrics.border_line_width;
			rect(ctx.x+border_line_width, item_y, ctx.w-border_line_width*2.f, border_line_width, colors.panel_outline);
		}


		{ // Icon
			set_shader_font(&icons);

			color := colors.foreground;
			if (item.flags & ItemFlags.HIGHLIGHT) == ItemFlags.HIGHLIGHT {
				color = colors.open_indicator;
			}

			ly :: item_y + font_centered_in(item_h, &icons);
			text(item_x, ly, item.icon, color);

			item_x     += item_spacing;
			available_w -= item_spacing;
		}

		{ // Keymap
			key_mapping :: str_split_by(item.hint, '\0', allocator);

			hw :: calculate_keybind_cell_width(key_mapping) + text_padding;
			hx := ctx.x + ctx.w - hw;
			available_w -= hw;

			draw_keybind_cells(hx, item_y, item_h, key_mapping);
		}

		{ // Commands
			set_shader_font(&font_ui);

			title_w := available_w;
			title_w  = math.clamp(title_w, 0.f, available_w);
			set_scissor(item_x, ctx.list_y, title_w, ctx.h);
			defer clear_scissor();
			defer flush();

			help_color := colors.foreground;
			help_color.w = 0.4f;

			ly :: item_y + font_centered_in(item_h, &font_ui);

			item_row_h :: item_h / 5.f;

			item :: &list[visible_list_index][i];
			text(item_x, ly-item_row_h, item.title, colors.foreground);
			text(item_x, ly+item_row_h, item.preview, help_color);
		}

		item_y += item_h;
	}

	// Mouse input
	if is_point_in_rect(ctx.x, ctx.list_y, ctx.w, ctx.h, mouse.position.x, mouse.position.y) {
		mouse.hover_elem_id = loc.hash;
	}

	clicked := false;
	if mouse.last_hover_elem_id == loc.hash {
		set_cursor();
		if is_lmb_press() && hover_index != -1 {
			clicked        = true;
			selected_index = hover_index;
		}
		if math.abs(mouse.scroll) > 0.f {
			top_index -= auto (mouse.scroll * 3.f);
			if top_index < 0 {
				top_index = 0;
			}
			else if top_index >= list[visible_list_index].len {
				top_index = list[visible_list_index].len - 1;
			}
		}
	}

	last_selected_index = selected_index;
	return clicked;
}

draw_search_simple_list :: fn (loc := #call_location) bool {
	using draw;

	ctx :: &list_ui_ctx;
	assert(ctx.is_active);

	if ctx.visible_items == 0 then return false;

	text_padding      :: metrics.text_ui_padding;
	item_spacing      :: metrics.item_spacing;
	border_line_width :: metrics.border_line_width;

	root_dir :: get_project_root_directory();

	item_h :: ctx.item_height;

	// scrolling
	if top_index + ctx.visible_items >= list[visible_list_index].len {
		top_index = math.max(list[visible_list_index].len - ctx.visible_items, 0);
	}

	if last_selected_index != selected_index {
		if selected_index >= top_index + ctx.visible_items {
			top_index = selected_index - ctx.visible_items + 1;
		}
		if selected_index < top_index {
			top_index = selected_index;
		}
	}
	start_index = top_index;

	end_index :: start_index + ctx.visible_items;

	tx := ctx.x + text_padding;
	ty :: ctx.list_y;

	hover_index : s64 = -1;
	{ // Selected line
		set_shader_color();

		if selected_index >= start_index && selected_index < start_index + ctx.visible_items {
			selected_y :: ty + item_h * auto (selected_index - start_index);
			rect(ctx.x+border_line_width, selected_y, ctx.w-border_line_width*2.f, item_h, colors.command_select);
		}

		if mouse.last_hover_elem_id == loc.hash {
			ly := ty;
			loop i := start_index; i < end_index; i += 1 {
				if is_point_in_rect(ctx.x, ly, ctx.w, item_h, mouse.position.x, mouse.position.y) {
					rect(ctx.x+border_line_width, ly, ctx.w-border_line_width*2.f, item_h, colors.selection_background_inactive);
					hover_index = i;
					break;
				}
				ly += item_h;
			}
		}
	}

	content_w :: ctx.w - text_padding * 2.f;
	item_y := ty;
	loop i := start_index; i < end_index; i += 1 {
		item :: &list[visible_list_index][i];
		item_x := tx;

		{ // Separator
			set_shader_color();
			border_line_width :: metrics.border_line_width;
			rect(ctx.x+border_line_width, item_y, ctx.w-border_line_width*2.f, border_line_width, colors.panel_outline);
		}

		icon_y :: item_y + font_centered_in(item_h, &icons);
		text_y :: item_y + font_centered_in(item_h, &font_ui);

		{ // Icon
			set_shader_font(&icons);

			color := colors.foreground;
			ic    := item.icon;

			if (item.flags & ItemFlags.MISSING) == ItemFlags.MISSING {
				ic    = icon(ICON_WARNING);
				color = colors.warning;
			} else if (item.flags & ItemFlags.HIGHLIGHT) == ItemFlags.HIGHLIGHT {
				color = colors.open_indicator;
			}
			text(item_x, icon_y, ic, color);

			item_x += item_spacing;
		}

		show_preview :: item.preview.len > 0;

		{ // Commands

			PREVIEW_FACTOR :: 0.3f;

			set_scissor(ctx.x, item_y, if show_preview then content_w * PREVIEW_FACTOR - item_spacing else content_w, item_h);
			set_shader_font(&font_ui);

			item_title : string_view = item.title;
			if (item.flags & ItemFlags.MODIFIED) == ItemFlags.MODIFIED {
				item_title = tprint("%*", item_title);
			}

			text(item_x, text_y, item_title, colors.foreground);
			if item.hint.len > 0 {
				item_x += text_size(item_title, &font_ui).width + text_padding;

				hint_color := colors.foreground;
				hint_color.w = 0.4f;

				set_shader_font(&icons);
				text(item_x, icon_y, icon(ICON_ARROW_EAST), hint_color);
				item_x += text_size(icon(ICON_ARROW_EAST), &icons).width + text_padding;

				set_shader_font(&font_ui);

				hit_path := item.hint;
				if settings.chop_root_dir_from_search_paths && str_match(root_dir, hit_path, auto root_dir.len) {
					if hit_path.len == root_dir.len {
						hit_path = ".";
					} else if hit_path.len > root_dir.len {
						chopped_path :: slice_range(hit_path, root_dir.len);
						if chopped_path.len < 1 || chopped_path[0] != '/' {
							hit_path = item.hint;
						} else {
							hit_path = tprint(".%", chopped_path);
						}
					}
				}

				text(item_x, text_y, hit_path, hint_color);

			}
			flush();

			if show_preview {

				// set_shader_color();
				// rect(0.f, item_y, preview_w, item_h, v4.{ y = 1.f, w = 0.2f });

				set_scissor(ctx.x, item_y, content_w, item_h); {
					set_shader_font(&font_ui_mono);
					item_x = ctx.x + content_w * PREVIEW_FACTOR;

					preview_color :: colors.foreground;
					text(item_x, text_y, item.preview, preview_color);
				}
				flush();
			}

			clear_scissor();
		}

		item_y += item_h;
	}

	// Mouse input
	if is_point_in_rect(ctx.x, ctx.list_y, ctx.w, ctx.h, mouse.position.x, mouse.position.y) {
		mouse.hover_elem_id = loc.hash;
	}

	clicked := false;
	if mouse.last_hover_elem_id == loc.hash {
		set_cursor();
		if is_lmb_press() && hover_index != -1 {
			clicked        = true;
			selected_index = hover_index;
		}
		if math.abs(mouse.scroll) > 0.f {
			top_index -= auto (mouse.scroll * 3.f);
			if top_index < 0 {
				top_index = 0;
			}
			else if top_index >= list[visible_list_index].len {
				top_index = list[visible_list_index].len - 1;
			}
		}
	}

	last_selected_index = selected_index;
	return clicked;
}

draw_simple_floating_list :: fn (x: f32, y: f32, w: f32, max_item_count: s32, loc := #call_location) bool {
	using draw;

	mutex_lock(&visible_list_mutex);
	defer mutex_unlock(&visible_list_mutex);
	if list[visible_list_index].len == 0 then return false;

	line_height     :: metrics.line_ui_height;
	text_padding    :: metrics.text_ui_padding;
	item_spacing    :: metrics.item_spacing;
	rounding        :: metrics.corner_rounding;

	h, visible_lines :: get_list_height(false, max_item_count);
	list_w := w;

	// scrolling
	if top_index + visible_lines >= list[visible_list_index].len {
		top_index = math.max(list[visible_list_index].len - visible_lines, 0);
	}

	if last_selected_index != selected_index {
		if selected_index >= top_index + visible_lines {
			top_index = selected_index - visible_lines + 1;
		}
		if selected_index < top_index {
			top_index = selected_index;
		}
	}
	start_index = top_index;

	end_index :: start_index + visible_lines;

	tx := x + text_padding;
	ty :: y + text_padding;

	loop i := start_index; i < end_index; i += 1 {
		item :: &list[visible_list_index][i];
		preview_w :: text_size(item.preview, &font_ui_mono);
		list_w = math.max(list_w, preview_w + item_spacing*2.f);
	}

	available_w := list_w - text_padding * 2.f;

	draw_panel_body(x, y, list_w, h, rounding);

	// Selected line
	if selected_index >= start_index && selected_index < start_index + visible_lines {
		selected_y :: ty + line_height * auto (selected_index - start_index);
		rect_rounded(x, selected_y, list_w, line_height, rounding, colors.command_select, colors.command_select);
	}

	hover_index : s64 = -1;
	if mouse.last_hover_elem_id == loc.hash {
		ly := ty;
		loop i := start_index; i < end_index; i += 1 {
			if is_point_in_rect(x, ly, list_w, line_height, mouse.position.x, mouse.position.y) {
				rect_rounded(x, ly, list_w, line_height, rounding, colors.selection_background_inactive, colors.selection_background_inactive);
				hover_index = i;
				break;
			}
			ly += line_height;
		}
	}

	{ // Icon
		set_shader_font(&icons);
		line_base_y := ty;
		loop i := start_index; i < end_index; i += 1 {
			ly :: line_base_y + font_centered_in(line_height, &icons);
			item :: &list[visible_list_index][i];
			text(tx, ly, item.icon, colors.foreground);
			line_base_y += line_height;
		}
		tx         += item_spacing;
		available_w -= item_spacing;
	}


	{ // Text
		set_shader_font(&font_ui);

		set_scissor(tx, y, available_w, h);
		defer clear_scissor();
		defer flush();

		line_base_y := ty;
		loop i := start_index; i < end_index; i += 1 {
			ly :: line_base_y + font_centered_in(line_height, &font_ui);
			item :: &list[visible_list_index][i];
			text(tx, ly, item.preview, colors.foreground);
			line_base_y += line_height;
		}
	}

	// Mouse input
	if is_point_in_rect(x, y, list_w, h, mouse.position.x, mouse.position.y) {
		mouse.hover_elem_id = loc.hash;
	}

	clicked := false;
	if mouse.last_hover_elem_id == loc.hash {
		set_cursor();
		if is_lmb_press() && hover_index != -1 {
			clicked        = true;
			selected_index = hover_index;
		}
		if math.abs(mouse.scroll) > 0.f {
			top_index -= auto (mouse.scroll * 3.f);
			if top_index < 0 {
				top_index = 0;
			}
			else if top_index >= list[visible_list_index].len {
				top_index = list[visible_list_index].len - 1;
			}
		}
	}

	last_selected_index = selected_index;
	return clicked;
}

CompletionItem :: struct {
	symbol: string_view;
	kind:   s32;
}

list_completion :: fn (items: []CompletionItem, subject: string_view = "") {
	reset_listing();
	loop i := 0; i < items.len; i += 1 {
		array_push(&list[DEFAULT_LIST_INDEX], ListItem.{
				preview = str_make(items[i].symbol, &string_cache[DEFAULT_CACHE_INDEX]),
				icon = get_icon_for_lsp_completion_kind(items[i].kind),
				index = i,
			});
	}

	if subject.len < 1 then return;
	filter_list(subject);
}

list_commands :: fn (repeatable_only := false) {
	reset_listing();

	loop i := 0; i < COMMAND_NAMES.len; i += 1 {
		if !is_command_available(auto i) then continue;
		if repeatable_only && !is_command_valid_for_repeating(auto i) then continue;

		command_name : string_view : COMMAND_NAMES[i];
		if command_name[0] == '_' then continue;
		title :: str_make(command_name, &string_cache[DEFAULT_CACHE_INDEX]);
		hint  :: str_make(&string_cache[DEFAULT_CACHE_INDEX]);

		flags: ItemFlags;

		loop keymap_index := 0;; keymap_index += 1 {
			keymap_index = lookup_command_keymap_index(auto i, keymap_index);
			if keymap_index == -1 { break; }

			if hint.len > 0 {
				str_append(&hint, "\0");
			}
			str_append(&hint, keymap_entry_to_string(keymap_index));

			flags = .HIGHLIGHT;
		}

		array_push(&list[DEFAULT_LIST_INDEX], ListItem.{
				title   = title,
				hint    = hint,
				preview = COMMAND_HELP[i],
				index   = i,
				icon    = icon(ICON_COMMAND),
				flags   = flags,
			});
	}

	quick_sort_by_title(list[DEFAULT_LIST_INDEX], 0, auto (list[DEFAULT_LIST_INDEX].len - 1));
}

list_shell_entries :: fn () {
	reset_listing();

	get_cmd_icon :: fn (cmd: string_view) string_view #inline {
		ic := icon(ICON_ANY_SHELL);
		if str_match(cmd, "git", auto "git".len) || str_match(cmd, "svn", auto "svn".len) {
			ic = icon(ICON_GIT);
		} else if str_match(cmd, "rg", auto "rg".len) || str_match(cmd, "grep", auto "grep".len) || str_match(cmd, "find", auto "find".len){
			ic = icon(ICON_SEARCH);
		}
		return ic;
	};

	loop i := 0; i < project.shell_entries.len; i += 1 {
		entry :: &project.shell_entries[i];
		array_push(&list[DEFAULT_LIST_INDEX], ListItem.{
				title = entry.cmd,
				icon  = get_cmd_icon(entry.cmd),
				score = entry.priority,
				flags = if entry.is_preset then ItemFlags.HIGHLIGHT else ItemFlags.NONE,
			});
	}

	quick_sort_by_score(list[DEFAULT_LIST_INDEX], 0, auto (list[DEFAULT_LIST_INDEX].len - 1));
}

list_directory :: fn (dirpath: string_view, file_extension_filter := []string_view.{}, dirs_only := false, as_projects := false) Error {
	file_visitor :: fn (info: *FileVisitInfo, ctx: *FileVisitorContext) Error {

		if !info.is_directory {
			if ctx.dirs_only then return OK;
			head, ext :: path_splitext(info.filename);
			// @Incomplete: Case sensitive!?
			if ext.len == 0 then return OK;
			if ctx.file_extension_filter.len > 0 && str_match_one_of(ext, ctx.file_extension_filter) == false { return OK; }
			if ctx.as_projects {
				_, ext2 :: path_splitext(head);
				if str_match(ext2, ".bak") then return OK;
			}
		}

		title := str_make(info.filename, &string_cache[DEFAULT_CACHE_INDEX]);
		the_icon: string_view;

		if ctx.as_projects {
			// strip the extension
			title.len -= 5;
			assert(title.len > 0);
			the_icon  = icon(ICON_PROJECT);
		} else {
			the_icon = get_icon_for_file_info(info);
		}

		flags := ItemFlags.NONE;
		if info.is_directory {
			flags = ItemFlags.DIRECTORY;
		}
		array_push(ctx.list, ListItem.{
			title = title,
			icon  = the_icon,
			flags = flags
		});
		return OK;
	};

	// Check the directory first.
	valid, err1 :: is_directory(dirpath);
	if err1 { return err1; }
	if !valid { return error("Not directory."); }

	reset_listing();

	ctx :: FileVisitorContext.{
		list                  = &list[DEFAULT_LIST_INDEX],
		dirs_only             = dirs_only,
		as_projects           = as_projects,
		file_extension_filter = file_extension_filter,
	};

	err2 :: visit_files(dirpath, VisitOpt.{}, &ctx, &file_visitor);
	if err2 { return err2; }

	quick_sort_by_title(list[DEFAULT_LIST_INDEX], 0, auto (list[DEFAULT_LIST_INDEX].len - 1));

	return OK;
}

list_projects :: fn () Error #inline {
	projects_dir :: tprint("%/%", data_dir, PROJECTS_DIRECTORY);
	return list_directory(projects_dir, [1]string_view.{ ".proj" }, false, true);
}

list_logical_drives :: fn () Error {
	drives: u32;
	#if PLATFORM == Platform.WINDOWS {
		drives = GetLogicalDrives();
	} else {
		panic("Not implemented.");
	}

	if drives == 0 {
		return os_get_last_error2();
	}

	reset_listing();

	DRIVE_LETTERS :: "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	loop i := 0; i < DRIVE_LETTERS.len; i += 1 {
		if (drives & (1 << cast(u32) i)) > 0 {
			title :: str_make(2, &string_cache[DEFAULT_CACHE_INDEX]);
			str_append(&title, string_view.{ 1, &DRIVE_LETTERS[i] });
			str_append(&title, ":");
			array_push(&list[DEFAULT_LIST_INDEX], ListItem.{
				title = title,
				flags = ItemFlags.DIRECTORY,
				icon  = icon(ICON_DRIVE),
			});
		}
	}

	return OK;
}

// Note the index of each list entry is index into the project included directory list, this might be used
// to resolve te full file path.
list_project :: fn () {
	reset_listing();

	is_locked, err_lock :: mutex_try_lock(&project.mutex);
	if err_lock { panic(err_lock); }
	if !is_locked {
		print_warn(PROJECT_IS_INDEXING_MESSAGE);
		return;
	}
	defer mutex_unlock(&project.mutex);

	list_buffers();

	{ // listing
		array_reserve(&list[DEFAULT_LIST_INDEX], project.indexed_files.len);
		loop i := 0; i < project.indexed_files.len; i += 1 {
			filepath :: project.indexed_files[i];
			if find_buffer_for_file(filepath) { continue; }
			dirpath, filename := path_split(filepath);
			if dirpath.len > 0 && dirpath[dirpath.len-1] == '/' { dirpath.len -= 1; }
			file_type :: detect_filetype(filename);
			array_push(&list[DEFAULT_LIST_INDEX], ListItem.{
				title = filename,
				hint  = dirpath,
				icon  = get_icon_for_file_type(file_type),
			});
		}
	}

	quick_sort_by_title(list[DEFAULT_LIST_INDEX], auto (list[DEFAULT_LIST_INDEX].len - 1), auto (list[DEFAULT_LIST_INDEX].len - 1));
}

list_buffers :: fn (modified_only := false, implicit_items: []ListItem = .{}) {
	reset_listing();
	implicit_item_num :: implicit_items.len;

	loop i := 0; i < implicit_items.len; i += 1 {
		array_push(&list[DEFAULT_LIST_INDEX], implicit_items[i]);
	}

	loop i := 0; i < buffers.len; i += 1 {
		buf :: &buffers[i];
		if buf.is_removed then continue;
		if is_command_editor_buffer(buf) then continue;
		if modified_only && (buf.flags & .NO_UNDO) == .NO_UNDO then continue;

		modified :: buf.saved_top != buf.undo_top;
		missing  :: buf.missing_on_disk;

		if modified_only && !modified && !missing then continue;

		dirpath := path_split(buf.filepath);
		if dirpath.len > 0 && dirpath[dirpath.len-1] == '/' { dirpath.len -= 1; }

		ic :: get_icon_for_buffer(buf);

		flags: ItemFlags;
		if !modified_only then flags |= .HIGHLIGHT;
		if missing        then flags |= .MISSING;
		if modified       then flags |= .MODIFIED;

		array_push(&list[DEFAULT_LIST_INDEX], ListItem.{
			title = buf.name,
			hint  = dirpath,
			icon  = ic,
			index = buf.index,
			flags = flags,
			score = buf.last_focus_index,
			base_score = 100,
		});
	}

	quick_sort_by_score(list[DEFAULT_LIST_INDEX], auto implicit_item_num, auto (list[DEFAULT_LIST_INDEX].len - 1));
}

// Returns false in case there are no functions available for the buffer.
list_functions :: fn (buf: *Buffer) bool {
	reset_listing();
	functions : []SearchLocation : buf.functions;
	if functions.len == 0 then return false;

	loop i := 0; i < functions.len; i += 1 {
		function_location := &functions[i];
		row :: find_row_for_position(buf, function_location.start);
		preview :: peek_row_without_new_line(buf, row);

		array_push(&list[DEFAULT_LIST_INDEX], ListItem.{
				title = peek_range(buf, function_location.start, function_location.end),
				icon  = get_icon_for_lsp_completion_kind(LSP_COMPLETION_ITEM_KIND_FUNCTION),
				preview = preview,
				index = function_location.start,
			});
	}

	quick_sort_by_score(list[DEFAULT_LIST_INDEX], 0, auto (list[DEFAULT_LIST_INDEX].len - 1));
	return true;
}

clear_list_filters :: fn () {
	visible_list_index = DEFAULT_LIST_INDEX;
}

filter_list :: fn (filter: string_view, implicit_item: *ListItem = null, exclude_first_n := 0) {
	assert(filter.len > 0);
	selected_index = 0;
	start_index    = 0;
	list[FILTER_LIST_INDEX].len = 0;

	if implicit_item {
		array_push(&list[FILTER_LIST_INDEX], @implicit_item);
	}

	loop i := exclude_first_n; i < list[DEFAULT_LIST_INDEX].len; i += 1 {
		item :: &list[DEFAULT_LIST_INDEX][i];
		search_for := item.title;
		if search_for.len == 0 {
			search_for = item.preview;
		}
		// trim just filename
		_, tail :: path_split(search_for);
		if tail.len > 0 {
			search_for = tail;
		}

		item.score = fuzzy_cmp(search_for, filter) + item.base_score;
		if item.score >= 0 {
			// Copy valid item into filtered list.
			array_push(&list[FILTER_LIST_INDEX], @item);
		}
	}

	sort_from_index :: if implicit_item then 1 else 0;
	quick_sort_by_score(list[FILTER_LIST_INDEX], sort_from_index, auto (list[FILTER_LIST_INDEX].len - 1));

	visible_list_index = FILTER_LIST_INDEX;
}

get_selected_item_in_list :: fn () *ListItem #inline {
	if list[visible_list_index].len == 0 { return null; }
	assert(selected_index >= 0 && selected_index < list[visible_list_index].len);
	return &list[visible_list_index][selected_index];
}

list_item_up :: fn () {
	selected_index -= 1;
	if selected_index < 0 { selected_index = list[visible_list_index].len - 1; }
}

list_item_down :: fn () {
	selected_index += 1;
	if selected_index >= list[visible_list_index].len { selected_index = 0; }
}

// Do the cleanup of the current vidible list in case the first_call is true. We use both list buffers as double-buffers
// one is visible, other one is filled with a new data; when new data is ready we just swap them.
list_async_search :: fn (subject: string_view, first_call := false) Error {
	if first_call || subject.len < 2 {
		list[visible_list_index].len = 0;
		selected_index               = 0;
		start_index                  = 0;
		release_allocator(&string_cache[visible_list_index]);

		if subject.len < 2 {
			return OK;
		}
	}

	// Also waits for all threads to finish.
	cancel_async_search();

	is_locked, err_lock :: mutex_try_lock(&project.mutex);
	if err_lock { panic(err_lock); }
	if !is_locked {
		print_warn(PROJECT_IS_INDEXING_MESSAGE);
		return OK;
	}

	// We have to keep the mutex locked through the whole search process, and unlock it when search is done to prevent
	// the indexer override data we're working with. Anyway the indexing might be started again (e.g. in case of directory
	// content changes) but it will not block the main thread even if we're in middle of search here, because the wait for
	// project mutex is done in indexer thread.

	if project.indexed_files.len == 0 {
		mutex_unlock(&project.mutex);
		return OK;
	}


	// Fire up searching in multiple threads...
	job_count := MAX_JOB_COUNT;
	loop job_count > 1 {
		batch_count := project.indexed_files.len / job_count;
		if batch_count > 1 { break; }
		job_count -= 1;
	}

	files_per_job :: project.indexed_files.len / job_count;
	print_log("Found % files will be processed in % threads.", project.indexed_files.len, job_count);

	async_search.jobs_started    = job_count;
	async_search.jobs_running    = job_count;
	async_search.total_files     = auto project.indexed_files.len;
	async_search.processed_files = 0;
	async_search.start_time      = os_ftick_ms();

	// cleanup
	list_index :: (visible_list_index + 1) % 2;
	list[list_index].len = 0;
	selected_index       = 0;
	start_index          = 0;
	release_allocator(&string_cache[list_index]);
	async_search.dest_list_index = list_index;

	first_in_batch: s64;
	loop i := 0; i < job_count; i += 1 {
		len := files_per_job;
		if i + 1 == job_count {
			// The last one includes the rest of files.
			len = project.indexed_files.len - first_in_batch;
		}
		async_search.jobs_data[i] = WorkerContext.{
			subject      = subject,
			files        = []string_view.{ len, &project.indexed_files[first_in_batch] },
		};

		async(&async_search.jobs[i], &async_search.jobs_data[i], &search_worker);
		first_in_batch += files_per_job;
	}
	return OK;
}

format_listing_results_to_string :: fn (str: *string) {
	cancel_async_search();

	cwd :: get_cwd();
	defer str_terminate(&cwd);

	loop i := 0; i < list[visible_list_index].len; i += 1 {
		item :: &list[visible_list_index][i];
		dirpath :: absolute_path_to_relative(item.hint, cwd);
		str_append(str, tprint("%/%:%:%:\t%\n", dirpath, item.title, item.row+1, item.col+1, item.preview));
	}
}

cancel_async_search :: fn () {
	loop i := 0; i < async_search.jobs_started; i += 1 {
		async_search.jobs_data[i].cancel = true;
	}
	loop i := 0; i < async_search.jobs_started; i += 1 {
		async_wait(&async_search.jobs[i]);
	}
	assert(async_search.jobs_started == 0);
	assert(async_search.jobs_running == 0);
}

get_async_search_progress :: fn () (is_running: bool, progress: f32) #inline {
	// This might be dirty, but whatever...
	//mutex_lock(&async_search.mutex);
	//defer mutex_unlock(&async_search.mutex);
	if async_search.jobs_started == 0 {
		return false, 0.f;
	}
	return true, cast(f32) async_search.processed_files / cast(f32) async_search.total_files;
}

#scope_private

MAX_JOB_COUNT :: 32;

WorkerContext :: struct {
	subject: string_view;
	files:   []string_view;
	cancel:  bool;

	result: [..]ListItem;
}

async_search: struct {
	jobs:         [MAX_JOB_COUNT]Async(*WorkerContext, s32);
	jobs_data:    [MAX_JOB_COUNT]WorkerContext;
	jobs_started: s32;
	jobs_running: s32;

	start_time:      f64;
	dest_list_index: s32;

	total_files:     s32;
	processed_files: s32;

	mutex: Mutex;
};

on_worker_done :: fn (ctx: *WorkerContext) {
	mutex_lock(&async_search.mutex);
	defer mutex_unlock(&async_search.mutex);

	if !ctx.cancel {
		// Copy results.
		list_index :: async_search.dest_list_index;
		dest :: &list[list_index];
		array_reserve(dest, ctx.result.len);
		loop i := 0; i < ctx.result.len; i += 1 {
			item :: array_push(dest, ctx.result[i]);
			item.preview = str_make(item.preview, &string_cache[list_index]);
		}
	}

	array_terminate(&ctx.result);

	async_search.jobs_running -= 1;
	assert(async_search.jobs_running >= 0);
	if async_search.jobs_running > 0 {
		return;
	}
	err_unlock :: mutex_unlock(&project.mutex);
	if err_unlock { panic(err_unlock); }

	async_search.jobs_started = 0;

	{
		mutex_lock(&visible_list_mutex);
		visible_list_index = async_search.dest_list_index;
		selected_index     = 0;
		start_index        = 0;
		mutex_unlock(&visible_list_mutex);

		async_search.dest_list_index = -1;
	}

	print_log("Search done in %ms.", os_ftick_ms() - async_search.start_time);
}

search_worker :: fn (ctx: *WorkerContext) s32 {
	assert(ctx.subject.len > 0);

	file_buffer: [..]u8;
	array_reserve(&file_buffer, 1024 * 64);
	defer array_terminate(&file_buffer);

	array_reserve(&ctx.result, 1024);

	subject_cols :: count_unicode_characters(ctx.subject);

	loop i := 0; i < ctx.files.len && ctx.cancel == false; i += 1 {
		filepath :: ctx.files[i];
		stream, err_open :: open_file(filepath, OpenFileMode.READ);
		if err_open {
			close_file(&stream);
			print_log("File '%' excluded from indexed list due to error: %", filepath, err_open.msg);
			continue;
		}

		file_buffer.len = 0;
		err_read :: load_whole_file(&file_buffer, &stream, settings.search_size_limit_bytes);
		close_file(&stream);
		if err_read {
			if err_read.code == -1 {
				print_warn("File '%' excluded from search: %", filepath, err_read.msg);
				//print_warn("File '%' skipped with error: %", filepath, err_read.msg);
			} else {
				print_err(err_read);
			}
			continue;
		}

		// search file
		start_index : s64 = 0;
		row, col: s32;
		loop ctx.cancel == false {
			hit_position :: find_matching_subject_in_data(file_buffer, ctx.subject, start_index, &row, &col);
			if hit_position == -1 { break; }

			// File name is valid until the list of all files is valid!
			dirpath, filename := path_split(filepath);
			if dirpath.len > 0 && dirpath[dirpath.len-1] == '/' { dirpath.len -= 1; }
			line :: expand_position_to_whole_line(file_buffer, hit_position);

			array_push(&ctx.result, ListItem.{
				title    = filename,
				icon     = icon(ICON_FILE),
				index    = auto hit_position,
				preview  = tprint("%", line),
				hint     = dirpath,
				row      = row,
				col      = col
			});
			start_index = hit_position + ctx.subject.len;
			col += subject_cols;
		}

		async_search.processed_files += 1;
	}
	on_worker_done(ctx);
	return 0;
}

FileVisitorContext :: struct {
	// Index to the current project included directories used to resolve the root path for each entry.
	// We also use it to strip the path shown to user in the list.
	project_include_directory_index: s32;
	list:                           *[..]ListItem;
	dirs_only:                       bool;
	as_projects:                     bool;
	file_extension_filter:           []string_view;
}

DEFAULT_LIST_INDEX :: 0;
FILTER_LIST_INDEX  :: 1;

// We have two lists 0 contains raw sorted items directly from disk. 1 contains filtered items in case some fuzzy search
// was applied.
list:                [2][..]ListItem;
visible_list_index:  s32;
start_index:         s64;
selected_index:      s64;
top_index:           s64;
last_selected_index: s64;

DEFAULT_CACHE_INDEX :: 0;

// We have two caches, for single threaded simple lists we use just the first one, but in case of
// multithreaded (async search) we need two. We show previous results untile we have a new ones
// so it's kind of double buffer approach.
string_cache: [2]PoolAllocator;

visible_list_mutex: Mutex;

get_icon_for_file_info :: fn (file_info: *FileVisitInfo) string_view #inline {
	if file_info.is_directory { return icon(ICON_FOLDER); }
	file_type :: detect_filetype(file_info.filename);
	return get_icon_for_file_type(file_type);
}

#scope_public
reset_listing :: fn () {
	list[DEFAULT_LIST_INDEX].len = 0;
	list[FILTER_LIST_INDEX].len  = 0;

	reset_allocator(&string_cache[0]);
	reset_allocator(&string_cache[1]);
	visible_list_index  =  DEFAULT_LIST_INDEX;
	selected_index      =  0;
	start_index         =  0;
	top_index           =  0;
	last_selected_index = -1;
}
#scope_private

// utf8 version?
first_from_left_in_path :: fn (str: string_view, c: u8, start: s64) s64 {
	if start >= str.len { return -1; }
	loop i := start; i < str.len; i += 1 {
		if C.toupper(auto str[i]) == C.toupper(auto c) { return i; }
	}
	return -1;
}

/*
fuzzy_cmp :: fn (str: string_view, pattern: string_view) s32 {
	if pattern.len == 0 { return 0; }
	MAX :: 256;
	score: s32;
	loop i := 0; i < pattern.len; i += 1 {
		pos :: cast(s32) first_from_left_in_path(str, pattern[i], i);
		if pos < 0 { return -1; }
		score += MAX - pos;
		// score -= cast(s32) str.len;

		// exact case bonus
		if str[pos] == pattern[i] {
			score += 10;
		}
	}
	return score;
}
*/

fuzzy_cmp :: fn (str: string_view, pattern: string_view) s32 {
	if pattern.len == 0 { return 0; }
	MAX :: 256;

	score:    s32;
	last_pos: s64;

	loop i := 0; i < pattern.len; i += 1 {
		pos :: first_from_left_in_path(str, pattern[i], last_pos);
		if pos < 0 { return -1; }

		// consecutive bonus — most important scoring factor
		if pos == last_pos {
			score += 20;
		}

		// word boundary bonus — match after _ . / - space
		if pos == 0 {
			score += 15;
		} else {
			prev :: str[pos - 1];
			if prev == '_' || prev == '.' || prev == '/' || prev == '-' || prev == ' ' {
				score += 15;
			}
		}

		// earlier in string is better
		score += cast(s32)(MAX - pos);

		// exact case bonus
		if str[pos] == pattern[i] {
			score += 10;
		}

		last_pos = pos + 1;
	}

	// penalize longer strings — shorter match = more specific
	score -= cast(s32) str.len;

	return score;
}

// We have two almost identical sorts here, but we can gain some speed by not using pointer to comparator callbacks.
quick_sort_by_title :: fn (arr: []ListItem, low: s32, high: s32) {
	partition :: fn (arr: []ListItem, low: s32, high: s32) s32 {
		pivot :: &arr[high];
		i := low - 1;
		loop j := low; j <= high - 1; j += 1 {
			if str_compare(arr[j].title, pivot.title) > 0 {
				i += 1;
				swap(&arr[i], &arr[j]);
			}
		}
		swap(&arr[i + 1], &arr[high]);
		return i + 1;
	};

	if low < high {
		pi :: partition (arr, low, high);
		quick_sort_by_title(arr, low, pi - 1);
		quick_sort_by_title(arr, pi + 1, high);
	}
}

quick_sort_by_score :: fn (arr: []ListItem, low: s32, high: s32) {
	partition :: fn (arr: []ListItem, low: s32, high: s32) s32 {
		pivot :: &arr[high];
		i := low - 1;
		loop j := low; j <= high - 1; j += 1 {
			if arr[j].score > pivot.score {
				i += 1;
				swap(&arr[i], &arr[j]);
			}
		}
		swap(&arr[i + 1], &arr[high]);
		return i + 1;
	};

	if low < high {
		pi :: partition (arr, low, high);
		quick_sort_by_score(arr, low, pi - 1);
		quick_sort_by_score(arr, pi + 1, high);
	}
}

