ConfigServerRequest :: struct #base msq.Message {
	data: Variant(union {
		document_update: struct {
			filepath: string;
			src:      string;
		};
		completion: struct {
			filepath:     string;
			src:          string;
			cursor:       Cursor;
			buffer_index: s32;
		};
	});
}

ConfigServerResponse :: struct #base msq.Message {
	data: Variant(union {
		publish_diagnostics: struct {
			filepath:     string;
			items:    [..]ErrorLocation;
		};
		completion: struct {
			buffer_index: s32;
			cursor:       Cursor;
			items:      []CompletionItem;
		};
	});
}

config_server: struct {
	job_index: s32;
}

config_server_init :: fn () {
	config_server.job_index = -1;
}

config_server_terminate :: fn () {
}

start_config_server :: fn () Error {
	print_log("CS: Starting server.");
	config_server.job_index = start_async_job(.CONFIG_SERVER, "config server", &worker);
	return OK;
}

config_server_is_supported_document_type :: fn (buf: *Buffer) bool #inline {
	return buf.file_type == .PROJ;
}

config_server_document_update :: fn (buf: *Buffer) Error {
	using msq;

	if config_server.job_index == -1 {
		start_config_server();
	}
	assert(config_server_is_supported_document_type(buf));

	print_log("CS: Add file '%'.", buf.name);
	job :: get_job(config_server.job_index);

	request :: make_message(ConfigServerRequest, &job.main_to_worker);
	set_variant(&request.data, .document_update, .{
			filepath = str_make(buf.filepath, request.allocator),
			src      = str_make(buf.bytes, request.allocator), // @Performance
		});

	post(request) catch {
		terminate_message(request);
		return error("Failed to post config server message.");
	};
	return OK;
}

config_server_completion :: fn (editor: *Editor, buf: *Buffer) Error {
	using msq;

	if config_server.job_index == -1 {
		start_config_server();
	}
	assert(config_server_is_supported_document_type(buf));

	job :: get_job(config_server.job_index);

	request :: make_message(ConfigServerRequest, &job.main_to_worker);
	set_variant(&request.data, .completion, .{
			filepath     = str_make(buf.filepath, request.allocator),
			src          = str_make(buf.bytes, request.allocator), // @Performance
			cursor       = get_cursor(buf, editor.cursor_index),
			buffer_index = buf.index,
		});

	post(request) catch {
		terminate_message(request);
		return error("Failed to post config server message.");
	};
	return OK;
}

apply_config_server :: fn (response: *ConfigServerResponse) Error {
	check_main_thread();

	switch response.data.kind {
		.publish_diagnostics {
			data :: &response.data.publish_diagnostics;

			buf :: get_buffer_by_filepath(data.filepath);
			if !buf then return OK;

			reset_buffer_diagnostics(buf);

			loop i := 0; i < data.items.len; i += 1 {
				add_buffer_dia_entry(buf, &data.items[i]);
			}
		}
		.completion {
			data :: &response.data.completion;

			buf, editor :: get_active_buffer_and_editor();
			if data.buffer_index != buf.index then return OK;
			current_position :: get_cursor_position(buf, editor.cursor_index);
			if data.cursor.position != current_position then return OK;

			items :: data.items;
			if items.len == 0 {
				print_warn("No completion available.");
			} else {
				show_completion_popup_for_active_editor(items, true);
			}
		}
	}

	return OK;
}

#private

worker :: fn (job: *Job) s32 {
	using msq;

	request: *ConfigServerRequest;
	loop poll_as(&job.main_to_worker, &request, true) {
		defer terminate_message(request);
		defer temporary_reset();

		switch request.data.kind {
			.document_update {
				data :: &request.data.document_update;
				response :: make_message(ConfigServerResponse, job.worker_to_main);

				config_data: ConfigData;
				config_data_init(&config_data, application_context.temporary_allocator);

				diag: [..]ErrorLocation;
				array_init(&diag, LSP_MAX_DIAG_MESSAGE_COUNT, response.allocator);
				load_config_from_memory(&config_data, data.filepath, data.src, &diag, true);

				set_variant(&response.data, .publish_diagnostics, .{
						filepath = str_make(config_data.filepath, response.allocator),
						items    = diag,
					});

				post(response) catch {
					terminate_message(request);
					job_error(job, "Failed to post config server message.");
					return 1;
				};
			}

			.completion {
				data :: &request.data.completion;
				response :: make_message(ConfigServerResponse, job.worker_to_main);

				config_data: ConfigData;
				config_data_init(&config_data, application_context.temporary_allocator);
				load_config_from_memory(&config_data, data.filepath, data.src, null, true);

				items :: config_data_get_completion(&config_data, data.cursor, response.allocator);

				set_variant(&response.data, .completion, .{
						buffer_index = data.buffer_index,
						cursor       = data.cursor,
						items        = items,
					});

				post(response) catch {
					terminate_message(request);
					job_error(job, "Failed to post config server message.");
					return 1;
				};
			}
		}

	}

	atomic.store(&job.state, .KILLED);
	return 0;
}