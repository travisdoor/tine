#load "syntax/asm.bl"
#load "syntax/bl.bl"
#load "syntax/blm.bl"
#load "syntax/build.bl"
#load "syntax/cpp.bl"
#load "syntax/csharp.bl"
#load "syntax/glsl.bl"
#load "syntax/jai.bl"
#load "syntax/md.bl"
#load "syntax/messages.bl"
#load "syntax/project.bl"
#load "syntax/search.bl"
#load "syntax/zig.bl"

reset_buffer_syntax :: fn (buf: *Buffer) {
	assert(buf.dirty_syntax == true, "This should be called only if syntax is dirty!");

	buf.colors.len = 0;
	array_resize(&buf.colors, buf.bytes.len);
	zero_slice(buf.colors);

	buf.indent.len    = 0;
	buf.functions.len = 0;
}

parse_block :: fn (ctx: *TokenizerBase, t: *?TToken, c: u8, kind: TToken.kind) bool {
	if ctx.bytes[ctx.index] != c then return false;
	ctx.index += 1;
	t.kind = kind;
	t.len  = 1;
	return true;
}

parse_c_like_string :: fn (ctx: *TokenizerBase, t: *?TToken, quote: u8) bool {
	if ctx.bytes[ctx.index] != quote then return false;

	t.kind     = TToken.kind.STRING;
	t.len     += 1; // "
	ctx.index += 1;

	escape_quotes := 0;

	in_string := true;
	loop in_string && ctx.index < ctx.bytes.len {
		c :: ctx.bytes[ctx.index];
		if c == '\\' {
			escape_quotes += 1;
		} else if c == quote && ((escape_quotes % 2) == 0) {
			in_string = false;
		} else {
			escape_quotes = 0;
		}
		t.len     += 1;
		ctx.index += 1;
	}

	return true;
}

parse_c_like_comment :: fn (ctx: *TokenizerBase, t: *?TToken) bool {
	if ctx.bytes[ctx.index] != '/' then return false;
	ctx.index += 1;

	c := ctx.bytes[ctx.index];
	switch c {
		'/' {
			ctx.index += 1;
			loop ctx.index < ctx.bytes.len {
				c = ctx.bytes[ctx.index];
				if c == '\n' || c == 0 { break; }
				t.len     += 1;
				ctx.index += 1;
			}
			t.len += 2; // '//'
		}
		'*' {
			ctx.index += 1;
			t.len     += 2;
			loop ctx.index < ctx.bytes.len {
				c = ctx.bytes[ctx.index];
				if c == 0 { break; }
				if c == '*' && ctx.index+1 < ctx.bytes.len {
					ctx.index += 1;
					if ctx.bytes[ctx.index] == '/' {
						t.len += 2; // /**/
						break;
					}
					ctx.index -= 1;
				}
				t.len     += 1;
				ctx.index += 1;
			}
		}
		default {
			ctx.index -= 1;
			return false;
		}
	}

	t.kind = TToken.kind.COMMENT;
	return true;
}

parse_c_like_directive :: fn (ctx: *TokenizerBase, t: *?TToken, prefix: u8, lookup: *Table(string_view, u8), lookup_max_len: s32, hit_kind: TToken.kind, miss_kind: TToken.kind) bool {
	if ctx.bytes[ctx.index] != prefix then return false;
	ctx.index += 1;
	t.len     += 1;
	t.kind     = miss_kind;

	parse_c_like_keyword(ctx, t, lookup, lookup_max_len, hit_kind, miss_kind);
	return true;
}

parse_c_like_keyword :: fn (ctx: *TokenizerBase, t: *?TToken, lookup: *Table(string_view, u8), lookup_max_len: s32, hit_kind: TToken.kind, miss_kind: TToken.kind) bool {
	len   := 0;
	index := ctx.index;
	loop index < ctx.bytes.len {
		c :: ctx.bytes[index];
		if c == '_' || is_alpha(c) || (len > 0 && is_digit(c)) {
			len   += 1;
			index += 1;
		} else {
			break;
		}
	}

	if len == 0 then return false;

	subject :: string_view.{ len, &ctx.bytes[ctx.index] };

	t.len    += len;
	ctx.index = index;

	if subject.len <= lookup_max_len && tbl_contains(lookup, subject) {
		t.kind = hit_kind;
	} else {
		t.kind = miss_kind;
	}

	return true;
}

parse_c_like_number :: fn (ctx: *TokenizerBase, t: *?TToken) bool {
	dot  := false;
	base := FmtIntBase.DEC;

	c := ctx.bytes[ctx.index];
	if c != '-' && !is_digit(c) then return false;

	if c == '-' {
		if ctx.index+1 >= ctx.bytes.len {
			return false;
		}
		if !is_digit(ctx.bytes[ctx.index+1]) {
			return false;
		}
		t.len     += 1;
		ctx.index += 1;

	}

	t.kind = TToken.kind.NUMBER;

	c = ctx.bytes[ctx.index];
	if c == '0' {
		base = FmtIntBase.OCT;

		ctx.index += 1;
		t.len     += 1;

		if ctx.index < ctx.bytes.len {
			c = ctx.bytes[ctx.index];
			switch c {
				'b' { base = FmtIntBase.BIN;  ctx.index += 1; t.len += 1; }
				'x' { base = FmtIntBase.HEX; ctx.index += 1; t.len += 1; }
				default;
			}
		}
	}

	loop ; ctx.index < ctx.bytes.len; ctx.index += 1 {
		c = ctx.bytes[ctx.index];
		if dot && c == 'f' {
			ctx.index += 1;
			t.len += 1;
			break;
		}

		if dot == false && c == '.' {
			dot = true;
			t.len += 1;
			continue;
		}

		if c == '\'' {
			t.len += 1;
			continue;
		}

		if !is_digit(c, base) {
			break;
		}
		t.len += 1;
	}

	return true;
}
