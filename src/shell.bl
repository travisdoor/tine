ShellRequest :: struct {
	args: string_view;
}

ShellResponse :: struct {
	text:  string;
}

ShellFlavor :: enum { CMD; BUILD; }

shell: struct {
	job_index:       s32;
	buffer_index:    s32;
	last_ansi_color: u8;
	flavor:          ShellFlavor;

	in_tmp:  string;
};

shell_init :: fn () {
	shell.job_index    = -1;
	shell.buffer_index = -1;
}

shell_terminate :: fn () {
	str_terminate(&shell.in_tmp);
}

request_shell_execute :: fn (cmd: string_view, flavor := ShellFlavor.CMD) Error {
	clear_error_list();

	if shell.job_index != -1 {
		return error("Shell execution is already in progress. Use [%] for interruption and try again.", get_keybinding_for_command(.SHELL_KILL));
	}

	// _, initial_editor :: get_active_buffer_and_editor();

	if shell.buffer_index == -1 {
		shell.buffer_index = add_builtin_buffer("shell", BufferFlags.PARSE_FILE_LINKS);
	}

	if flavor != .BUILD || settings.focus_shell_on_build {
		activate_buffer_editor(shell.buffer_index);
	}

	assert_buffer(shell.buffer_index);
	buf :: &buffers[shell.buffer_index];

	clear_buffer(buf);
	shell.last_ansi_color = 0;
	shell.flavor          = flavor;

	job_index :: start_async_job(JobKind.SHELL, "shell", &worker);
	shell.job_index = job_index;

	ctx :: get_job_context(job_index);

	request := make_request(ctx) catch return $;
	request.as.shell = .{
		args = parse_cmd(cmd, request.allocator),
	};

	push_request(ctx, &request);
	return OK;
}

apply_shell :: fn (_: JobContext.state, response: *Response) Error {
	if shell.buffer_index == -1 then return OK;
	assert(shell.buffer_index >= 0 && shell.buffer_index < buffers.len);
	buf :: &buffers[shell.buffer_index];

	measure_elapsed_ms_begin();
	defer measure_elapsed_ms_end();

	if buf.is_removed {
		kill_shell();
	} else {
		response_data :: &response.as.shell;

		text: string_view;
		if shell.in_tmp.len > 0 {
			str_append(&shell.in_tmp, response_data.text);
			text = shell.in_tmp;
			shell.in_tmp.len = 0;
		} else {
			text = response_data.text;
		}

		batch_begin(buf);
		defer batch_end(buf);

		append :: fn (buf: *Buffer, text: string_view, color: u8) #inline {
			start_index :: array_resize(&buf.colors, buf.colors.len + text.len);
			memset(&buf.colors[start_index], color, auto text.len);
			append_readonly_buffer(buf, text);
		};

		allocator :: application_context.temporary_allocator;
		append_start_index, append_len := 0;

		// ANSI color codes...
		loop i := 0; i < text.len; {
			if text[i] == 27 { // Escape character
				esc_seq_start_index :: i;
				i += 1;

				MAX_ESCAPE_SEQ_LEN :: 8;
				is_complete, is_unsupported := false;

				if append_len > 0 {
					append(buf, .{ append_len, &text[append_start_index] }, shell.last_ansi_color);
					append_len = 0;
				}

				if i < text.len && text[i] == '[' {
					i += 1;
					start_colors :: i;
					len := 0;
					loop ;i < text.len && len <= MAX_ESCAPE_SEQ_LEN; i += 1 {
						c :: text[i];
						if is_digit(c) || c == ';' {
							len += 1;
							continue;
						} else if c == 'm' {
							is_complete = true;
							break;
						} else {
							is_unsupported = true;
							break;
						}

						len += 1;
					}

					if is_unsupported {
						i += 1;
						continue;
					}

					if is_complete && len <= MAX_ESCAPE_SEQ_LEN {
						text_style :: str_split_by(string_view.{ len, &text[start_colors] }, ';', allocator);
						foreground_color : s32 = -1;
						loop i := 0; i < text_style.len; i += 1 {
							n, err :: strtos64(text_style[i]);
							if err then continue;
							if n >= 30 && n <= 37 then foreground_color = auto n;
						}

						if foreground_color == -1 {
							shell.last_ansi_color = 0;
						} else if settings.shell_enable_ansi_colors {
							shell.last_ansi_color = get_ansi_color_index_from_code(foreground_color);
						}
					} else {
						shell.last_ansi_color = 0;
					}
				}

				if !is_complete {
					len :: i - esc_seq_start_index;
					assert(len > 0, "We expect at least escape character here!");
					str_append(&shell.in_tmp, string_view.{ len, &text[esc_seq_start_index] });
					return OK;
				}
			} else {
				if append_len == 0 then append_start_index = i;
				append_len += 1;
			}
			i += 1;
		}

		if append_len > 0 then append(buf, .{ append_len, &text[append_start_index] }, shell.last_ansi_color);
	}
	return OK;
}

kill_shell :: fn () {
	if shell.job_index == -1 {
		print_warn("Shell is not running.");
		return;
	}
	assert(shell.job_index >= 0 && shell.job_index < jobs.len);
	assert(!jobs[shell.job_index].worker_context.is_removed);
	assert(jobs[shell.job_index].worker_context.kind == JobKind.SHELL);
	remove_async_job(shell.job_index);
}

#scope_private

worker :: fn (ctx: *JobContext) s32 {
	using JobContext.state;

	report_error_and_fail :: fn (ctx: *JobContext, err: Error) {
		print_err(err);
		ctx.state = .FAILED;
	};

	// wait for request
	request: Request #noinit;
	loop !pop_request(ctx, &request) {
		os_sleep_ms(10);
	}
	request_data :: &request.as.shell;
	defer terminate_request(&request);

	set_job_progress_indicator(ctx, true);
	defer set_job_progress_indicator(ctx, false);

	allocator :: application_context.temporary_allocator;

	shell_command :: str_make(if settings.shell.len == 0 then DEFAULT_SHELL else settings.shell, allocator);
	args_with_executable :: split_command_line_arguments(&shell_command, allocator);

	if args_with_executable.len == 0 {
		report_error_and_fail(ctx, error("Cannot resolve shell executable name."));
		return 0;
	}

	executable :: args_with_executable[0];
	args       :: []string_view.{ args_with_executable.len-1, &args_with_executable[1] };

	start_process(ctx, executable, args) catch {
		report_error_and_fail(ctx, $);
		return 1;
	};
	defer stop_process(ctx);

	{
		response := make_response(ctx) catch {
			report_error_and_fail(ctx, $);
			return 1;
		};
		response.as.shell.text = sprint_with_allocator(response.allocator, "Execute: %\n", request_data.args);
		push_response(ctx, &response);
	}

	write_pipe(ctx.stdin, request_data.args);
	write_pipe(ctx.stdin, "\n");
	close_pipe(&ctx.stdin);

	loop !ctx.kill {
		state :: poll_process(ctx) catch {
			report_error_and_fail(ctx, $);
			return 1;
		};

		using PollEvent;
		if is_flag(state, READ) {
			response := make_response(ctx) catch {
				report_error_and_fail(ctx, $);
				return 1;
			};
			response.as.shell.text = str_make(response.allocator);
			defer push_response(ctx, &response);

			read_pipe(ctx.stdout, &response.as.shell.text) catch {
				report_error_and_fail(ctx, $);
				return 1;
			};
		}
		if is_flag(state, CLOSED) {
			ctx.state = DONE;
			break;
		}

		os_sleep_ms(10);
	}

	if ctx.state == DONE {
		response := make_response(ctx) catch {
			report_error_and_fail(ctx, $);
			return 1;
		};
		response.as.shell.text = sprint_with_allocator(response.allocator, "\nProcess exited with status %.\n", ctx.exit_code);
		push_response(ctx, &response);
		return 0;
	}

	{
		response := make_response(ctx) catch {
			report_error_and_fail(ctx, $);
			return 1;
		};
		response.as.shell.text = str_make("\nProcess killed.\n", response.allocator);
		push_response(ctx, &response);
	}

	ctx.state = KILLED;
	return 0;
}

get_ansi_color_index_from_code :: fn (n: s32) u8 #inline {
	switch n {
		30 { return ANSI_COLOR_BLACK_INDEX;   }
		31 { return ANSI_COLOR_RED_INDEX;     }
		32 { return ANSI_COLOR_GREEN_INDEX;   }
		33 { return ANSI_COLOR_YELLOW_INDEX;  }
		34 { return ANSI_COLOR_BLUE_INDEX;    }
		35 { return ANSI_COLOR_MAGENTA_INDEX; }
		36 { return ANSI_COLOR_CYAN_INDEX;    }
		37 { return ANSI_COLOR_WHITE_INDEX;   }
		default;
	}
	return CODE_COLOR_DEFAULT_INDEX;
}

parse_cmd :: fn (cmd: string_view, allocator: *Allocator) string_view {
	result := str_make(cmd.len, allocator);

	target_buf :: get_last_active_buffer_and_editor();

	loop i := 0; i < cmd.len; {
		if cmd[i] == '{' && i+1 < cmd.len && cmd[i+1] == '{' {
			str_append(&result, "{");
			i += 2;
			continue;
		}

		if cmd[i] == '}' && i+1 < cmd.len && cmd[i+1] == '}' {
			str_append(&result, "}");
			i += 2;
			continue;
		}

		if cmd[i] == '{' {
			subject :: string_view.{ cmd.len - i, &cmd[i] };

			print_log(subject);
			substitutes :: [_]string_view.{
				"{filepath}", target_buf.filepath
			};

			hit := false;
			loop j := 0; j < substitutes.len; j += 2 {
				if str_match(subject, substitutes[j+0], auto substitutes[j+0].len) {
					str_append(&result, "\"");
					str_append(&result, substitutes[j+1]);
					str_append(&result, "\"");
					i += cast(s32) substitutes[j+0].len;
					hit = true;
					break;
				}
			}

			if hit then continue;
		}

		str_append(&result, string_view.{ 1, &cmd[i] });
		i += 1;
	}

	return result;
}