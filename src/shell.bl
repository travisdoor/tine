ShellRequest :: struct #base msq.Message {
	args: string_view;
}

ShellResponse :: struct #base msq.Message {
	text:  string;
}

ShellEntry :: struct {
	cmd:       string_view;
	priority:  s32;
	is_preset: bool;
}

ShellFlavor :: enum { CMD; BUILD; }

shell: struct {
	job_index:       s32;
	buffer_index:    s32;
	last_ansi_color: u8;
	flavor:          ShellFlavor;

	in_tmp:  string;
};

shell_init :: fn () {
	shell.job_index    = -1;
	shell.buffer_index = -1;
}

shell_terminate :: fn () {
	str_terminate(&shell.in_tmp);
}

request_shell_execute :: fn (cmd: string_view, flavor := ShellFlavor.CMD) Error {
	using msq;
	clear_error_list();

	if shell.job_index != -1 {
		return error("Shell execution is already in progress. Use [%] for interruption and try again.", get_keybinding_for_command(.SHELL_KILL));
	}

	_, initial_editor :: get_active_buffer_and_editor();

	if shell.buffer_index == -1 {
		shell.buffer_index = add_builtin_buffer("shell", BufferFlags.PARSE_FILE_LINKS);
	}

	if flavor != .BUILD || settings.focus_shell_on_build {
		_, editor :: activate_buffer_editor(shell.buffer_index);
		editor.top = 0;
		if has_split() then activate_editor(initial_editor.index);
	}

	assert_buffer(shell.buffer_index);
	buf :: &buffers[shell.buffer_index];

	clear_buffer(buf);
	shell.last_ansi_color = 0;
	shell.flavor          = flavor;

	job_index :: start_async_job(JobKind.SHELL, "shell", &worker);
	shell.job_index = job_index;

	job :: get_job(job_index);

	request :: make_message(ShellRequest, &job.main_to_worker);
	request.args = str_make(cmd, request.allocator);

	post(request) catch {
		terminate_message(request);
		return error("Failed to post shell message.");
	};
	return OK;
}

apply_shell :: fn (response: *ShellResponse) Error {
	if shell.buffer_index == -1 then return OK;
	assert(shell.buffer_index >= 0 && shell.buffer_index < buffers.len);
	buf :: &buffers[shell.buffer_index];

	measure_elapsed_ms_begin();
	defer measure_elapsed_ms_end();

	if buf.is_removed {
		kill_shell();
	} else {
		text: string_view;
		if shell.in_tmp.len > 0 {
			str_append(&shell.in_tmp, response.text);
			text = shell.in_tmp;
			shell.in_tmp.len = 0;
		} else {
			text = response.text;
		}

		batch_begin(buf);
		defer batch_end(buf);

		append :: fn (buf: *Buffer, text: string_view, color: u8) #inline {
			start_index :: array_resize(&buf.colors, buf.colors.len + text.len);
			memset(&buf.colors[start_index], color, auto text.len);
			append_readonly_buffer(buf, text);
		};

		allocator :: application_context.temporary_allocator;
		append_start_index, append_len := 0;

		// ANSI color codes...
		loop i := 0; i < text.len; {
			if text[i] == 27 { // Escape character
				esc_seq_start_index :: i;
				i += 1;

				MAX_ESCAPE_SEQ_LEN :: 8;
				is_complete, is_unsupported := false;

				if append_len > 0 {
					append(buf, .{ append_len, &text[append_start_index] }, shell.last_ansi_color);
					append_len = 0;
				}

				if i < text.len && text[i] == '[' {
					i += 1;
					start_colors :: i;
					len := 0;
					loop ;i < text.len && len <= MAX_ESCAPE_SEQ_LEN; i += 1 {
						c :: text[i];
						if is_digit(c) || c == ';' {
							len += 1;
							continue;
						} else if c == 'm' {
							is_complete = true;
							break;
						} else {
							is_unsupported = true;
							break;
						}

						len += 1;
					}

					if is_unsupported {
						i += 1;
						continue;
					}

					if is_complete && len <= MAX_ESCAPE_SEQ_LEN {
						text_style :: str_split_by(string_view.{ len, &text[start_colors] }, ';', allocator);
						foreground_color : s32 = -1;
						loop i := 0; i < text_style.len; i += 1 {
							n, err :: strtos64(text_style[i]);
							if err then continue;
							if n >= 30 && n <= 37 then foreground_color = auto n;
						}

						if foreground_color == -1 {
							shell.last_ansi_color = 0;
						} else if settings.shell_enable_ansi_colors {
							shell.last_ansi_color = get_ansi_color_index_from_code(foreground_color);
						}
					} else {
						shell.last_ansi_color = 0;
					}
				}

				if !is_complete {
					len :: i - esc_seq_start_index;
					assert(len > 0, "We expect at least escape character here!");
					str_append(&shell.in_tmp, string_view.{ len, &text[esc_seq_start_index] });
					return OK;
				}
			} else {
				if append_len == 0 then append_start_index = i;
				append_len += 1;
			}
			i += 1;
		}

		if append_len > 0 then append(buf, .{ append_len, &text[append_start_index] }, shell.last_ansi_color);
	}
	return OK;
}

kill_shell :: fn () {
	if shell.job_index == -1 {
		print_warn("Shell is not running.");
		return;
	}
	assert(shell.job_index >= 0 && shell.job_index < jobs.len);
	assert(jobs[shell.job_index].kind == JobKind.SHELL);
	remove_async_job(shell.job_index);
}

get_shell :: fn () string_view #inline {
	return if settings.shell.len == 0 then DEFAULT_SHELL else settings.shell;
}

#scope_private

worker :: fn (job: *Job) s32 {
	using msq;

	request: *ShellRequest #noinit;
	if poll_as(&job.main_to_worker, &request, true) {
		defer terminate_message(request);

		set_job_progress_indicator(job, true);
		defer set_job_progress_indicator(job, false);

		allocator :: application_context.temporary_allocator;

		shell_command :: str_make(get_shell(), allocator);
		args_with_executable :: split_command_line_arguments(&shell_command, allocator);

		if args_with_executable.len == 0 {
			job_error(job, error("Cannot resolve shell executable name."));
			return 1;
		}

		executable :: args_with_executable[0];
		args       := []string_view.{ args_with_executable.len-1, &args_with_executable[1] };

		shell_kind :: get_shell_kind(executable);
		print_log("Shell: '%' -> % [%]", executable, shell_kind, args);

		// Handle shell specific prelude only in case there was nothing explicitly specified by user.
		if args.len == 0 {
			// Windows BS specific garbage needed for their shells to accept stdin.
			switch shell_kind {
				.CMD {
					args = [_]string_view.{ "/Q", "/K", "prompt", "$" };
				}
				.POWERSHELL {
					args = [_]string_view.{ "-c", "-" };
				}
				default;
			}
		}

		start_process(job, executable, args) catch {
			job_error(job, $);
			return 1;
		};
		defer stop_process(job);

		{ // Prologue
			response :: make_message(ShellResponse, job.worker_to_main);
			response.text = sprint_with_allocator(response.allocator, "Execute: %\n", request.args);
			post(response) catch {
				terminate_message(response);
				job_error(job, "Failed to post shell message.");
				return 1;
			};
		}

		write_pipe(job.stdin, request.args);
		write_pipe(job.stdin, if PLATFORM == .WINDOWS then "\r\n" else "\n");

		switch shell_kind {
			// Yet again Windows garbage to let the shell propagate exit value.
			.CMD {
				write_pipe(job.stdin, "exit %ERRORLEVEL%\r\n");
			}
			.POWERSHELL {
				write_pipe(job.stdin, "exit $LASTEXITCODE\r\n");
			}
			default;
		}

		close_pipe(&job.stdin);

		loop !atomic.load(&job.kill) {
			state :: poll_process(job) catch {
				job_error(job, $);
				return 1;
			};

			using PollEvent;
			if is_flag(state, READ) {
				response :: make_message(ShellResponse, job.worker_to_main);
				response.text = str_make(response.allocator);

				read_pipe(job.stdout, &response.text) catch {
					terminate_message(response);
					job_error(job, $);
					return 1;
				};

				post(response) catch {
					terminate_message(response);
					job_error(job, "Failed to post shell message.");
					return 1;
				};
			}
			if is_flag(state, CLOSED) {
				atomic.store(&job.state, .DONE);
				break;
			}

			os_sleep_ms(16);
		}

		// Epilogue
		if atomic.load(&job.state) == .DONE {
			response :: make_message(ShellResponse, job.worker_to_main);
			response.text = sprint_with_allocator(response.allocator, "\nProcess exited with status %.\n", job.exit_code);
			post(response) catch {
				terminate_message(response);
				job_error(job, "Failed to post shell message.");
				return 1;
			};
			return 0;
		}
	}

	// Killed
	response :: make_message(ShellResponse, job.worker_to_main);
	response.text = str_make("\nProcess killed.\n", response.allocator);
	post(response) catch {
		terminate_message(response);
		job_error(job, "Failed to post shell message.");
		return 1;
	};

	atomic.store(&job.state, .KILLED);
	return 0;
}

get_ansi_color_index_from_code :: fn (n: s32) u8 #inline {
	switch n {
		30 { return ANSI_COLOR_BLACK_INDEX;   }
		31 { return ANSI_COLOR_RED_INDEX;     }
		32 { return ANSI_COLOR_GREEN_INDEX;   }
		33 { return ANSI_COLOR_YELLOW_INDEX;  }
		34 { return ANSI_COLOR_BLUE_INDEX;    }
		35 { return ANSI_COLOR_MAGENTA_INDEX; }
		36 { return ANSI_COLOR_CYAN_INDEX;    }
		37 { return ANSI_COLOR_WHITE_INDEX;   }
		default;
	}
	return CODE_COLOR_DEFAULT_INDEX;
}