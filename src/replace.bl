replace_mode_init :: fn () {
	activate_command_editor();

	buf, editor :: get_active_buffer_and_editor();
	clear_buffer(buf);

	input_mode                = InputMode.TEXT;
	notify_changes_to_buffer  = buf.index;
	is_replacing              = false;
	last_replacement_position = -1;

	// Show last search in the command buffer.
	if search.last_replacement.len > 0 {
		insert_string(buf, 0, search.last_replacement);
		select_all(editor, buf);
	}

	// @Incomplete: use search.last_replacement
	target_buf, target_editor :: get_last_active_buffer_and_editor();
	assert(search.last_subject.len > 0);
	if !focus_current_search_result() {
		closest_match(target_buf, target_editor);
	}
}

replace_mode_terminate :: fn () {
	if last_replacement_position != -1 {
		target_buf, target_editor :: get_last_active_buffer_and_editor();
		set_cursor_position(target_buf, target_editor.cursor_index, last_replacement_position);
	}
}

draw_replace_mode :: fn (active_editor_x: f32, active_editor_y: f32, active_editor_w: f32, active_editor_h: f32) {
	assert(workspace.active_editor == workspace.command_editor);
	assert(search.last_subject.len > 0);
	target_buf :: get_last_active_buffer_and_editor();

	text_padding     :: metrics.text_padding;
	title_bar_height :: metrics.title_bar_height;

	_, _, _, h :: compute_command_panel_layout();
	w :: search_panel_width(active_editor_w);
	x :: active_editor_x + active_editor_w - text_padding - w;
	y :: active_editor_y + active_editor_h - text_padding - h - title_bar_height;
	draw_command_editor_panel(x, y, w, h);

	cmd_h :: h/2.f;

	if is_replacing {
		using draw;

		title :: tprint("Replacing '%' with '%'.", search.last_subject, search.last_replacement);

		line_height  :: metrics.line_height;
		text_padding :: metrics.text_padding;
		item_spacing :: metrics.item_spacing;

		title_x := x + text_padding;
		title_y :: y + text_padding + font_centered_in(line_height, &font_ui);
		icon_y  :: y + text_padding + font_centered_in(line_height, &icons);

		set_shader_font(&icons);
		text(title_x, icon_y, icon(ICON_REPLACE), colors.foreground);

		title_x += item_spacing;

		set_shader_font(&font_ui);
		text(title_x, title_y, title, colors.foreground);
	} else {
		title :: tprint("Replace '%' in '%' with...", search.last_subject, target_buf.name);

		assert(workspace.active_editor == workspace.command_editor);
		draw_command_editor(workspace.command_editor, x, y, w, cmd_h, .{
				title = title,
				icon  = icon(ICON_REPLACE),
			});
	}

	draw_command_panel_hints(x, y+cmd_h, w, cmd_h, [_]PanelHint.{
			.{
				key_mapping = get_keybinding_for_command(.INSERT_NEW_LINE),
				info        = "replace"
			},
			.{
				key_mapping = get_keybinding_for_command(.CANCEL_MODE),
				info        = "cancel"
			},
			.{
				key_mapping = get_keybinding_for_command(.MOVE_DOWN),
				info        = "next match",
			},
			.{
				key_mapping = get_keybinding_for_command(.MOVE_UP),
				info        = "prev match",
			},
			.{
				key_mapping = get_keybinding_for_command(.SELECT_ALL),
				info        = "all",
			},
		}, metrics.command_panel_hints_alpha);
}

invoke_command_replace_mode :: fn (buf: *Buffer #maybe_unused, cmd: Command) bool {
	assert(workspace.active_editor == workspace.command_editor);
	assert(editors[workspace.active_editor].buffer_index == buf.index);

	target_buf, target_editor :: get_last_active_buffer_and_editor();

	subject     : string_view : search.last_subject;
	replacement : string_view = search.last_replacement;

	using Command;
	switch cmd {
		MOVE_UP   { prev_match(target_buf, target_editor); }
		MOVE_DOWN { next_match(target_buf, target_editor); }

		INSERT_NEW_LINE {
			if is_replacing {
				assert(subject.len > 0);

				start :: get_cursor_position(target_buf, target_editor.cursor_index);
				end   :: start + subject.len;

				last_replacement_position = start;

				batch_begin(target_buf);
				delete_range(target_buf, start, end);
				if replacement.len > 0 { // Empty is valid!
					insert_string(target_buf, start, replacement);
				}
				batch_end(target_buf);

				diff :: cast(s32) (replacement.len - subject.len);
				loop i := search.result_index; i < search.results.len; i += 1 {
					r :: &search.results[i];
					r.start += diff;
					r.end   += diff;
					// @Incomplete: Adjust col and row???
				}

				array_erase_keep_order(&search.results, search.result_index);
				if search.result_index >= search.results.len {
					search.result_index = 0;
				}

				// Jumps to next one since previous entry was deleted.
				if !focus_current_search_result() {
					// Last match
					set_mode(Mode.TEXT_EDIT);
					print_info("All replaced.");
				}
			} else {
				commit_current_replacement();
				is_replacing = true;
			}
		}

		SELECT_ALL {
			if !is_replacing {
				replacement  = commit_current_replacement();
				is_replacing = true;
			}
			assert(subject.len > 0);
			diff :: cast(s32) (replacement.len - subject.len);
			loop i := 0; i < search.results.len; i += 1 {
				r :: &search.results[i];
				start :: r.start + diff * i;
				end   :: r.end   + diff * i;
				batch_begin(target_buf);
				delete_range(target_buf, start, end);
				if replacement.len > 0 { // Empty is valid!
					insert_string(target_buf, start, replacement);
				}
				batch_end(target_buf);
				if i + 1 == search.results.len {
					set_cursor_position(target_buf, target_editor.cursor_index, start + replacement.len);
				}
			}
			search.results.len = 0;
			set_mode(Mode.TEXT_EDIT);
			print_info("All replaced.");
		}

		CENTER_VIEW { center_view(target_editor); }

		default { return false; }
	}

	return true;
}

#scope_private

is_replacing: bool;
last_replacement_position: s64;

commit_current_replacement :: fn () string_view #inline {
	buf :: get_active_buffer_and_editor();
	replacement :: peek_row(buf, 0);
	search.last_replacement.len = 0;

	if replacement.len > 0 {
		str_append(&search.last_replacement, replacement);
	}

	return search.last_replacement;
}
