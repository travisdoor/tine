LSP_PULL_DIAGNOSTICS_EACH_S :: 2.0;

LspRequest :: struct #base msq.Message {
	data: Variant(union {
			initialize: struct {
				root_directory: string;
				flavor:         LspFlavor;
			};
			document_open: struct {
				filepath: string;
				src:      string;
				version:  s32;
			};
			document_change: struct {
				filepath: string;
				src:      string;
				version:  s32;
				cursor:   Cursor;
			};
			document_save: struct {
				filepath: string;
			};
			document_close: struct {
				filepath: string;
			};
			goto: struct {
				kind:                LspGotoKind;
				filepath:            string;
				cursor:              Cursor;
				buffer_index:        s32;
				open_in_other_split: bool;
			};
			switch_header_source: struct {
				filepath:            string;
				buffer_index:        s32;
				open_in_other_split: bool;
			};
			completion: struct {
				filepath:     string;
				cursor:       Cursor;
				buffer_index: s32;
			};
			find_references: struct {
				filepath:     string;
				cursor:       Cursor;
				buffer_index: s32;
			};
			solution_open: struct {
				filepath:     string;
			};
			pull_diagnostics: struct {
				filepath: string;
				version:  s32;
			};
			signature_help: struct {
				filepath:     string;
				cursor:       Cursor;
				buffer_index: s32;
			};
		});
}

LspRequestKind :: LspRequest.data.kind;
LspGotoKind :: enum { DECLARATION; DEFINITION; }

LspResponse :: struct #base msq.Message {
	data: Variant(union {
			initialize: struct {
				server_name: string;
				features:    LspFeatures;
			};
			goto: struct {
				cursor:              Cursor;
				filepath:            string;
				buffer_index:        s32;
				open_in_other_split: bool;
			};
			switch_header_source: struct {
				filepath:            string;
				buffer_index:        s32;
				open_in_other_split: bool;
			};
			publish_diagnostics: struct {
				filepath:     string;
				version:      s32;
				items:    [..]ErrorLocation;
			};
			completion: struct {
				buffer_index: s32;
				is_complete:  bool;
				cursor:       Cursor;
				items:    [..]CompletionItem;
			};
			find_references: struct {
				buffer_index: s32;
				subject:      string;
				result:       string;
			};
			signature_help: struct {
				overloads: [..]string;
				cursor:        Cursor;
				buffer_index:  s32;
			};
		});
}

LspFlavor :: enum {
	GENERIC;
	CLANGD;
	ROSLYN;
}

LspServerDefaultName :: [auto type_utils.enum_variant_count(LspFlavor)]string_view.{
	"generic",
	"clangd",
	"roslyn",
};

LspFeatures :: struct {
	document_open_close: bool;
	document_sync_kind:  LspTextDocumentSyncKind;
	goto_declaration:    bool;
	goto_definition:     bool;
	find_references:     bool;
	clang_header_switch: bool;
	auto_diagnostics:    bool;
}

LSP_MAX_DIAG_MESSAGE_COUNT :: 1000;

LSP_COMPLETION_ITEM_KIND_TEXT :: 1;
LSP_COMPLETION_ITEM_KIND_METHOD :: 2;
LSP_COMPLETION_ITEM_KIND_FUNCTION :: 3;
LSP_COMPLETION_ITEM_KIND_CONSTRUCTOR :: 4;
LSP_COMPLETION_ITEM_KIND_FIELD :: 5;
LSP_COMPLETION_ITEM_KIND_VARIABLE :: 6;
LSP_COMPLETION_ITEM_KIND_CLASS :: 7;
LSP_COMPLETION_ITEM_KIND_INTERFACE :: 8;
LSP_COMPLETION_ITEM_KIND_MODULE :: 9;
LSP_COMPLETION_ITEM_KIND_PROPERTY :: 10;
LSP_COMPLETION_ITEM_KIND_UNIT :: 11;
LSP_COMPLETION_ITEM_KIND_VALUE :: 12;
LSP_COMPLETION_ITEM_KIND_ENUM :: 13;
LSP_COMPLETION_ITEM_KIND_KEYWORD :: 14;
LSP_COMPLETION_ITEM_KIND_SNIPPET :: 15;
LSP_COMPLETION_ITEM_KIND_COLOR :: 16;
LSP_COMPLETION_ITEM_KIND_FILE :: 17;
LSP_COMPLETION_ITEM_KIND_REFERENCE :: 18;
LSP_COMPLETION_ITEM_KIND_FOLDER :: 19;
LSP_COMPLETION_ITEM_KIND_ENUMMEMBER :: 20;
LSP_COMPLETION_ITEM_KIND_CONSTANT :: 21;
LSP_COMPLETION_ITEM_KIND_STRUCT :: 22;
LSP_COMPLETION_ITEM_KIND_EVENT :: 23;
LSP_COMPLETION_ITEM_KIND_OPERATOR :: 24;
LSP_COMPLETION_ITEM_KIND_TYPEPARAMETER :: 25;

LSP_COMPLETION_ITEM_KIND_SETTING :: -1;
LSP_COMPLETION_ITEM_KIND_COMMAND :: -2;

lsp: struct {
	job_index:   s32;
	initialized: bool;
	server_name: string;
	features:    LspFeatures;

	roslyn_solution_load_in_progress: bool;
}

lsp_init :: fn () {
	lsp.job_index = -1;
}

lsp_terminate :: fn () {
	str_terminate(&lsp.server_name);
}

start_lsp_server :: fn () Error {
	using msq;

	print_info("LSP: Starting server.");
	lsp.job_index   = start_async_job(.LSP, "lsp", &worker);
	lsp.initialized = false;
	lsp.roslyn_solution_load_in_progress = false;

	job :: get_job(lsp.job_index);

	request :: make_message(LspRequest, &job.main_to_worker);
	set_variant(&request.data, .initialize, .{
			root_directory = sprint_with_allocator(request.allocator, "%/", get_project_main_directory()),
			flavor         = settings.lsp_flavor,
		});

	post(request) catch {
		terminate_message(request);
		return error("LSP: Failed to post message.");
	};
	return OK;
}

lsp_roslyn_solution_open :: fn () Error {
	using msq;
	assert(check_running_and_initialized() == OK);

	if settings.lsp_roslyn_solution.len == 0 {
		print_warn("LSP: Solution file not set in 'lsp_roslyn_solution'. Functionality might be limited.");
		return OK;
	}

	job :: get_job(lsp.job_index);

	request :: make_message(LspRequest, &job.main_to_worker);
	set_variant(&request.data, .solution_open, .{
			filepath = str_make(settings.lsp_roslyn_solution, request.allocator),
		});
	post(request) catch {
		terminate_message(request);
		return error("LSP: Failed to post message.");
	};
	lsp.roslyn_solution_load_in_progress = true;
	return OK;
}

#scope_private
reset_dia_timeout :: fn (buf: *Buffer) #inline {
	assert(check_running_and_initialized() == OK);
	assert(!lsp.features.auto_diagnostics);

	buf.lsp.last_dia_pull_time = get_ticks();
}
#scope_public

lsp_pull_diagnostics_update :: fn (buf: *Buffer) {
	if !(is_lsp_running() && lsp.initialized) then return;
	if lsp.features.auto_diagnostics          then return;
	if !lsp_is_supported_document_type(buf)   then return;
	if mode == Mode.COMPLETION                then return;
	if buf.lsp.pending_dia                    then return;

	job :: get_job(lsp.job_index);

	// Other requests should have priority over diagnostics.
	if msq.get_pending_message_count(&job.main_to_worker) > 0 then return;

	current_time :: get_ticks();
	if current_time - buf.lsp.last_dia_pull_time > LSP_PULL_DIAGNOSTICS_EACH_S {
		lsp_pull_diagnostics(buf) catch $;
	}
}

lsp_pull_diagnostics :: fn (buf: *Buffer) Error {
	using msq;
	check_running_and_initialized() catch return $;
	assert(lsp_is_supported_document_type(buf));

	job :: get_job(lsp.job_index);

	request :: make_message(LspRequest, &job.main_to_worker);
	set_variant(&request.data, .pull_diagnostics, .{
			filepath = str_make(buf.filepath, request.allocator),
			version  = buf.lsp.version,
		});
	post(request) catch {
		terminate_message(request);
		return error("LSP: Failed to post message.");
	};

	buf.lsp.pending_dia = true;
	reset_dia_timeout(buf);
	return OK;
}

lsp_pull_signature_help :: fn (editor: *Editor, buf: *Buffer) Error {
	using msq;
	check_running_and_initialized() catch return $;
	assert(lsp_is_supported_document_type(buf));

	job :: get_job(lsp.job_index);

	request :: make_message(LspRequest, &job.main_to_worker);
	set_variant(&request.data, .signature_help, .{
			filepath     = str_make(buf.filepath, request.allocator),
			cursor       = get_cursor(buf, editor.cursor_index),
			buffer_index = buf.index,
		});
	post(request) catch {
		terminate_message(request);
		return error("LSP: Failed to post message.");
	};
	return OK;
}

kill_lsp_server :: fn () {
	if !is_lsp_running() then return;

	assert(lsp.job_index >= 0 && lsp.job_index < jobs.len);
	assert(jobs[lsp.job_index].kind == JobKind.LSP);
	remove_async_job(lsp.job_index);
}

restart_lsp_server :: fn () {
	if lsp.job_index != -1 {
		kill_lsp_server();
	}
	assert(lsp.job_index == -1);
	start_lsp_server() catch print_err("LSP: %", $);
}

lsp_is_supported_document_type :: fn (buf: *Buffer) bool #inline {
	if settings.lsp_file_type == .TEXT {
		print_warn("LSP: Missing or invalid 'lsp_file_type' in settings, no files will be added to LSP.");
		return false;
	}

	return buf.file_type == settings.lsp_file_type;
}

lsp_open_document :: fn (buf: *Buffer) Error {
	using msq;
	check_running_and_initialized() catch return $;
	if !lsp.features.document_open_close then return OK;

	assert(lsp_is_supported_document_type(buf));

	print_log("LSP: Add file '%'.", buf.name);
	buf.lsp.version += 1;
	buf.lsp.last_known_end = get_cursor_for_position(buf, get_last_position_in_buffer(buf));

	job :: get_job(lsp.job_index);

	request :: make_message(LspRequest, &job.main_to_worker);
	set_variant(&request.data, .document_open, .{
			filepath = str_make(buf.filepath, request.allocator),
			src      = str_make(buf.bytes, request.allocator), // @Performance
			version  = buf.lsp.version,
		});

	post(request) catch {
		terminate_message(request);
		return error("LSP: Failed to post message.");
	};

	if !lsp.features.auto_diagnostics {
		lsp_pull_diagnostics(buf) catch $;
	}

	return OK;
}

lsp_change_document :: fn (buf: *Buffer) Error {
	using msq;
	check_running_and_initialized() catch return $;
	assert(lsp_is_supported_document_type(buf));
	if lsp.features.document_sync_kind == .NONE then return OK;

	print_log("LSP: File '%' changed.", buf.name);
	buf.lsp.version       += 1;
	buf.lsp.published_top  = buf.undo_top;

	job :: get_job(lsp.job_index);

	request :: make_message(LspRequest, &job.main_to_worker);
	set_variant(&request.data, .document_change, .{
			filepath  = str_make(buf.filepath, request.allocator),
			src       = str_make(buf.bytes, request.allocator),
			version   = buf.lsp.version,
			cursor    = buf.lsp.last_known_end,
		});

	buf.lsp.last_known_end = get_cursor_for_position(buf, get_last_position_in_buffer(buf));
	post(request) catch {
		terminate_message(request);
		return error("LSP: Failed to post message.");
	};

	if !lsp.features.auto_diagnostics {
		reset_dia_timeout(buf);
	}

	return OK;
}

lsp_save_document :: fn (buf: *Buffer) Error {
	using msq;
	check_running_and_initialized() catch return $;
	assert(lsp_is_supported_document_type(buf));
	print_log("LSP: Save file '%'.", buf.name);

	job :: get_job(lsp.job_index);

	request :: make_message(LspRequest, &job.main_to_worker);
	set_variant(&request.data, .document_save, .{
			filepath = str_make(buf.filepath, request.allocator),
		});
	post(request) catch {
		terminate_message(request);
		return error("LSP: Failed to post message.");
	};
	return OK;
}

lsp_close_document :: fn (buf: *Buffer) Error {
	using msq;
	check_running_and_initialized() catch return $;
	if !lsp.features.document_open_close then return OK;
	assert(lsp_is_supported_document_type(buf));

	job :: get_job(lsp.job_index);

	request :: make_message(LspRequest, &job.main_to_worker);
	set_variant(&request.data, .document_close, .{
			filepath = str_make(buf.filepath, request.allocator),
		});
	post(request) catch {
		terminate_message(request);
		return error("LSP: Failed to post message.");
	};
	return OK;
}

lsp_goto_declaration :: fn (editor: *Editor, buf: *Buffer, open_in_other_split := false) Error {
	return  goto(editor, buf, .DECLARATION, open_in_other_split);
}

lsp_goto_definition :: fn (editor: *Editor, buf: *Buffer, open_in_other_split := false) Error {
	return goto(editor, buf, .DEFINITION, open_in_other_split);
}

#scope_private
goto :: fn (editor: *Editor, buf: *Buffer, kind: LspGotoKind, open_in_other_split: bool) Error {
	using msq;
	check_running_and_initialized() catch return $;
	if !lsp_is_supported_document_type(buf) {
		print_warn("LSP: Buffer type not supported.");
		return OK;
	}
	if !check_roslyn_solution_load_in_progress() then return OK;

	switch kind {
		.DECLARATION {
			if !lsp.features.goto_declaration {
				print_warn("LSP: Goto declaration feature is not supported by the LSP server.");
				return OK;
			}
		}
		.DEFINITION {
			if !lsp.features.goto_definition {
				print_warn("LSP: Goto definition feature is not supported by the LSP server.");
				return OK;
			}
		}
	}

	job :: get_job(lsp.job_index);

	request :: make_message(LspRequest, &job.main_to_worker);
	set_variant(&request.data, .goto, .{
			kind                = kind,
			cursor              = get_cursor(buf, editor.cursor_index),
			filepath            = str_make(buf.filepath, request.allocator),
			buffer_index        = buf.index,
			open_in_other_split = open_in_other_split,
		});

	post(request) catch {
		terminate_message(request);
		return error("LSP: Failed to post message.");
	};
	return OK;
}
#scope_public

lsp_switch_header_source :: fn (buf: *Buffer, open_in_other_split := false) Error {
	using msq;
	check_running_and_initialized() catch return $;
	if !lsp_is_supported_document_type(buf) {
		print_warn("LSP: Buffer type not supported.");
		return OK;
	}
	if !lsp.features.clang_header_switch {
		print_warn("LSP: Switch header-source feature is not supported by the LSP server.");
		return OK;
	}

	job :: get_job(lsp.job_index);

	request :: make_message(LspRequest, &job.main_to_worker);
	set_variant(&request.data, .switch_header_source, .{
			filepath            = str_make(buf.filepath, request.allocator),
			buffer_index        = buf.index,
			open_in_other_split = open_in_other_split,
		});
	post(request) catch {
		terminate_message(request);
		return error("LSP: Failed to post message.");
	};

	return OK;
}

lsp_completion :: fn (editor: *Editor, buf: *Buffer) Error {
	using msq;
	print_log("LSP: Request completion");

	check_running_and_initialized() catch return $;
	if !lsp_is_supported_document_type(buf) {
		print_warn("LSP: Buffer type not supported.");
		return OK;
	}
	if !check_roslyn_solution_load_in_progress() then return OK;

	if lsp_buffer_needs_update(buf) {
		lsp_change_document(buf) catch return $;
	}

	job :: get_job(lsp.job_index);

	request :: make_message(LspRequest, &job.main_to_worker);
	set_variant(&request.data, .completion, .{
			filepath     = str_make(buf.filepath, request.allocator),
			cursor       = get_cursor(buf, editor.cursor_index),
			buffer_index = buf.index,
		});

	post(request) catch {
		terminate_message(request);
		return error("LSP: Failed to post message.");
	};
	lsp_pull_signature_help(editor, buf);
	return OK;
}

lsp_find_references :: fn (editor: *Editor, buf: *Buffer) Error {
	using msq;
	check_running_and_initialized() catch return $;
	if !lsp_is_supported_document_type(buf) {
		print_warn("LSP: Buffer type not supported.");
		return OK;
	}
	if !lsp.features.find_references {
		print_warn("LSP: Find references feature is not supported by the LSP server.");
		return OK;
	}
	if !check_roslyn_solution_load_in_progress() then return OK;

	job :: get_job(lsp.job_index);

	request :: make_message(LspRequest, &job.main_to_worker);
	set_variant(&request.data, .find_references, .{
			filepath     = str_make(buf.filepath, request.allocator),
			cursor       = get_cursor(buf, editor.cursor_index),
			buffer_index = buf.index,
		});
	post(request) catch {
		terminate_message(request);
		return error("LSP: Failed to post message.");
	};
	return OK;
}

apply_lsp :: fn (response: *LspResponse) Error {
	check_main_thread();
	switch response.data.kind {
		.initialize {
			data :: &response.data.initialize;
			lsp.server_name.len = 0;
			str_append(&lsp.server_name, data.server_name);
			lsp.features = data.features;
			print_log("LSP: Features: %", lsp.features);

			lsp.initialized = true;
			print_info("LSP: Server initialized.");

			if settings.lsp_flavor == .ROSLYN {
				// configuration_change();
				lsp_roslyn_solution_open();
			}

			add_all_supported_buffers_to_lsp();
		}

		.goto {
			data :: &response.data.goto;
			buf :: get_active_buffer_and_editor();
			if data.buffer_index != buf.index then return OK;
			split :: if data.open_in_other_split then get_other_split() else get_active_split();
			open_location(data.filepath, data.cursor.row, data.cursor.col, split) catch {
				print_err("LSP: %", $);
			};
		}

		.switch_header_source {
			data :: &response.data.switch_header_source;
			buf :: get_active_buffer_and_editor();
			if data.buffer_index != buf.index then return OK;
			split :: if data.open_in_other_split then get_other_split() else get_active_split();
			open(data.filepath, split) catch {
				print_err("LSP: %", $);
			};
		}

		.publish_diagnostics {
			data :: &response.data.publish_diagnostics;
			buf :: get_buffer_by_filepath(data.filepath);
			if !buf {
				// This might be simple caused by the user closing the buffer before publishing.
				return OK;
			}
			buf.lsp.pending_dia = false;
			if data.version < buf.lsp.version || mode == Mode.COMPLETION {
				// New version of the document was pushed already for processing so current results might be outdated.
				return OK;
			}

			reset_buffer_diagnostics(buf);

			loop i := 0; i < data.items.len; i += 1 {
				add_buffer_dia_entry(buf, &data.items[i]);
			}
		}

		.completion {
			data :: &response.data.completion;
			buf, editor :: get_active_buffer_and_editor();
			if data.buffer_index != buf.index then return OK;
			current_position :: get_cursor_position(buf, editor.cursor_index);
			if data.cursor.position != current_position then return OK;

			items :: data.items;
			if items.len == 0 {
				print_warn("No completion available.");
			} else {
				show_completion_popup_for_active_editor(items, data.is_complete);
			}
		}

		.find_references {
			data :: &response.data.find_references;
			buf :: get_active_buffer_and_editor();
			if data.buffer_index != buf.index then return OK;

			search.last_subject.len = 0;
			str_append(&search.last_subject, data.subject);
			refs : string_view : data.result;

			if refs.len == 0 then return OK;

			results_buf, results_editor :: activate_search_editor();
			clear_buffer(results_buf);

			append_readonly_buffer(results_buf, refs);
			set_cursor_position(results_buf, results_editor.cursor_index, 0);
		}

		.signature_help {
			data :: &response.data.signature_help;
			overloads : []string : data.overloads;
			if overloads.len == 0 then return OK;

			buf, editor :: get_active_buffer_and_editor();
			if data.buffer_index != buf.index then return OK;
			current_position :: get_cursor_position(buf, editor.cursor_index);
			if data.cursor.position != current_position then return OK;

			show_signature_help_for_active_editor(overloads);
		}
	}

	return OK;
}

is_lsp_running :: fn () bool #inline {
	return lsp.job_index != -1;
}

add_all_supported_buffers_to_lsp :: fn () {
	loop i := 0; i < buffers.len; i += 1 {
		buf :: &buffers[i];
		if buf.is_removed then continue;
		if !lsp_is_supported_document_type(buf) then continue;
		assert(buf.lsp.version == 0, "Buffer not removed from previous session.");
		lsp_open_document(buf);
	}
}

remove_all_buffers_from_lsp :: fn () {
	loop i := 0; i < buffers.len; i += 1 {
		buf :: &buffers[i];
		if buf.is_removed then continue;
		if !lsp_is_supported_document_type(buf) then continue;
		buf.lsp.version = 0;
		reset_buffer_diagnostics(buf);
	}
}

lsp_buffer_needs_update :: fn (buf: *Buffer) bool #inline {
	assert(buf.lsp.version > 0, "Buffer not tracked by LSP!");
	return buf.lsp.published_top != buf.undo_top;
}

get_icon_for_lsp_completion_kind :: fn (kind: s32) string_view {
	switch kind {
		LSP_COMPLETION_ITEM_KIND_SNIPPET,
		LSP_COMPLETION_ITEM_KIND_EVENT,
		LSP_COMPLETION_ITEM_KIND_TEXT { return icon(ICON_CODE_TEXT); }

		LSP_COMPLETION_ITEM_KIND_OPERATOR { return icon(ICON_CODE_OPERATOR); }

		LSP_COMPLETION_ITEM_KIND_KEYWORD { return icon(ICON_CODE_KEYWORD); }

		LSP_COMPLETION_ITEM_KIND_CONSTRUCTOR,
		LSP_COMPLETION_ITEM_KIND_METHOD,
		LSP_COMPLETION_ITEM_KIND_FUNCTION { return icon(ICON_CODE_FUNCTION); }

		LSP_COMPLETION_ITEM_KIND_FIELD,
		LSP_COMPLETION_ITEM_KIND_CONSTANT,
		LSP_COMPLETION_ITEM_KIND_PROPERTY,
		LSP_COMPLETION_ITEM_KIND_VALUE,
		LSP_COMPLETION_ITEM_KIND_REFERENCE,
		LSP_COMPLETION_ITEM_KIND_VARIABLE { return icon(ICON_CODE_VARIABLE); }

		LSP_COMPLETION_ITEM_KIND_STRUCT,
		LSP_COMPLETION_ITEM_KIND_CLASS { return icon(ICON_CODE_CLASS); }
		LSP_COMPLETION_ITEM_KIND_INTERFACE { return icon(ICON_CODE_INTERFACE); }

		LSP_COMPLETION_ITEM_KIND_FILE { return icon(ICON_FILE); }
		LSP_COMPLETION_ITEM_KIND_FOLDER { return icon(ICON_FOLDER); }

		LSP_COMPLETION_ITEM_KIND_TYPEPARAMETER { return icon(ICON_CODE_TYPE); }

		LSP_COMPLETION_ITEM_KIND_ENUM,
		LSP_COMPLETION_ITEM_KIND_ENUMMEMBER { return icon(ICON_CODE_ENUM); }

		LSP_COMPLETION_ITEM_KIND_MODULE,
		LSP_COMPLETION_ITEM_KIND_UNIT { return icon(ICON_CODE_MODULE); }

		LSP_COMPLETION_ITEM_KIND_SETTING { return icon(ICON_CODE_SETTING); }
		LSP_COMPLETION_ITEM_KIND_COLOR   { return icon(ICON_CODE_COLOR);   }
		LSP_COMPLETION_ITEM_KIND_COMMAND { return icon(ICON_CODE_COMMAND); }
	}

	return icon(ICON_CODE_TEXT);
}

#scope_private

get_lsp_executable :: fn () string_view {
	if settings.lsp_executable.len > 0 then return settings.lsp_executable;
	// @Deprecated 2026-02-08
	if settings.clangd_executable.len > 0 then return settings.clangd_executable;
	print_warn("LSP: LSP server executable not set in the 'lsp_executable' setting, defaulting to clangd.");
	#if PLATFORM == .WINDOWS {
		return "clangd.exe";
	} else {
		return "clangd";
	}
}

is_notification :: fn (kind: LspRequestKind) bool #inline {
	switch kind {
		.document_open,
		.document_close,
		.document_change,
		.document_save {
			return true;
		}
		default;
	}
	return false;
}

check_running_and_initialized :: fn () Error #inline {
	if !is_lsp_running() {
		return error("Server is not running.");
	}
	if !lsp.initialized {
		return error("Server is running but not properly initialized.");
	}

	return OK;
}

check_roslyn_solution_load_in_progress :: fn () bool #inline {
	assert(is_lsp_running());
	assert(lsp.initialized);
	if lsp.roslyn_solution_load_in_progress {
		print_warn("LSP: Solution load in progress.");
		return false;
	}

	return true;
}

worker_context: struct {
	pending:      Table(s32, *LspRequest);
	next_id:      s32;
	frame_buffer: string;
} #thread_local;

terminate_worker_context :: fn () {
	loop i := 0; i < worker_context.pending.len; i += 1 {
		msq.terminate_message(worker_context.pending.values[i]);
	}
	tbl_terminate(&worker_context.pending);
	str_terminate(&worker_context.frame_buffer);
}

next_request_id :: fn () s32 #inline {
	worker_context.next_id += 1;
	return worker_context.next_id;
}

worker :: fn (job: *Job) s32 {
	defer terminate_worker_context();

	allocator :: application_context.temporary_allocator;

	executable :: get_lsp_executable();
	args       := split_command_line_arguments(&settings.lsp_args, allocator);
	// @Deprecated 2026-02-08
	if args.len == 0 then args = split_command_line_arguments(&settings.clangd_args, allocator);

	print_info("Execute '%' with arguments: %", executable, args);

	start_process(job, executable, args, false /* separate stderr */) catch {
		if $.code == ERR_NOT_FOUND {
			job_error(job, "LSP: Cannot find '%' executable. Please use a valid path or set the executable in your PATH environment variable.", executable);
		} else {
			job_error(job, "LSP: Cannot execute '%' with error: %", executable, $);
		}
		return 1;
	};

	defer stop_process(job);

	loop !atomic.load(&job.kill) {
		set_job_progress_indicator(job, worker_context.pending.len > 0);

		request: *LspRequest;
		if msq.poll_as(&job.main_to_worker, &request) {
			if is_notification(request.data.kind) {
				// Notification.
				defer msq.terminate_message(request);
				send_notification(job, request) catch {
					print_err("LSP: Notification failed with error: %", $);
				};
			} else {
				// Request.
				send_request(job, request) catch {
					msq.terminate_message(request);
					print_err("LSP: Request failed with error: %", $);
				};
			}
		}

		json :: next_frame(job) catch {
			job_error(job, "LSP: The '%' failed with error: %", executable, $);
			return 1;
		};

		if json.bytes.ptr {
			switch peek_rpc_kind(json) {
				.UNKNOWN {
					job_error(job, "LSP: Request failed with unknown message from server.");
					return 1;
				}

				.ERROR {
					recv_error(json) catch {
						job_error(job, $);
						return 1;
					};
					continue;
				}

				.NOTIFICATION {
					recv_notification(job, json) catch print_err($);
					continue;
				}

				.REQUEST {
					// Not handled.
					continue;
				}

				.RESPONSE {
					recv_response(job, json) catch print_err($);
					continue;
				}
			}
		}

		os_sleep_ms(16);
		temporary_reset();
	}

	atomic.store(&job.state, .KILLED);
	return 0;
}

send_notification :: fn (job: *Job, request: *LspRequest) Error {
	err: Error;
	switch request.data.kind {
		.document_open {
			data :: &request.data.document_open;
			uri_filepath :: new_url_from_filepath(data.filepath) catch return $;
			defer str_terminate(&uri_filepath);

			params :: LspDidOpenTextDocumentParams.{
				textDocument = LspTextDocumentItem.{
					uri        = uri_filepath,
					languageId = FILE_TYPE[auto settings.lsp_file_type].lsp_language_id,
					text       = data.src,
					version    = data.version,
				},
			};
			err = write_notification(job, "textDocument/didOpen", params);
		}

		.document_change {
			data :: &request.data.document_change;
			uri_filepath :: new_url_from_filepath(data.filepath) catch return $;
			defer str_terminate(&uri_filepath);

			switch lsp.features.document_sync_kind {
				.NONE { assert(false); }
				.FULL {
					changes :: [_]LspTextDocumentContentChangeEventFull.{
						.{ text = data.src },
					};

					params :: LspDidChangeTextDocumentParamsFull.{
						textDocument = LspVersionedTextDocumentIdentifier.{
							uri     = uri_filepath,
							version = data.version,
						},
						contentChanges = changes,
					};
					err = write_notification(job, "textDocument/didChange", params);
				}
				.INCREMENTAL {
					changes: [1]LspTextDocumentContentChangeEventIncremental #noinit;
					changes[0].range = .{
						start = .{},
						end   = .{ line = data.cursor.row, character = data.cursor.col },
					};
					changes[0].text = data.src;

					params :: LspDidChangeTextDocumentParamsIncremental.{
						textDocument = LspVersionedTextDocumentIdentifier.{
							uri     = uri_filepath,
							version = data.version,
						},
						contentChanges = changes,
					};
					err = write_notification(job, "textDocument/didChange", params);
				}
			}
		}

		.document_save {
			data :: &request.data.document_save;
			uri_filepath :: new_url_from_filepath(data.filepath) catch return $;
			defer str_terminate(&uri_filepath);

			params :: LspDidSaveTextDocumentParams.{
				textDocument   = LspTextDocumentIdentifier.{
					uri = uri_filepath,
				},
			};
			err = write_notification(job, "textDocument/didSave", params);
		}

		.document_close {
			data :: &request.data.document_close;
			uri_filepath :: new_url_from_filepath(data.filepath) catch return $;
			defer str_terminate(&uri_filepath);

			params :: LspDidCloseTextDocumentParams.{
				textDocument = LspTextDocumentIdentifier.{
					uri = uri_filepath,
				},
			};
			err = write_notification(job, "textDocument/didClose", params);
		}

		default { print_warn("Unknown notification."); }
	}

	return err;
}

send_request :: fn (job: *Job, request: *LspRequest) Error {
	id :: next_request_id();

	err: Error;
	switch request.data.kind {
		.initialize {
			data :: &request.data.initialize;
			uri_root_directory :: new_url_from_filepath(data.root_directory) catch return $;
			defer str_terminate(&uri_root_directory);

			extra_options := "{}";
			if data.flavor == .ROSLYN {
				extra_options = ROSLYN_EXTRA_OPTIONS2;
			}

			err = write_request(job, "initialize", id, LspInitialize.{
					rootUri      = uri_root_directory,
					capabilities = .{
						textDocument = .{
							diagnostic = .{
								dynamicRegistration = true,
							},
						},
						workspace = .{
							didChangeConfiguration = .{
								dynamicRegistration = true,
							},
							configuration = true,
						},
					},
					initializationOptions = extra_options,
				});
		}

		.goto {
			data :: &request.data.goto;
			uri_filepath :: new_url_from_filepath(data.filepath) catch return $;
			defer str_terminate(&uri_filepath);

			params :: LspTextDocumentPositionParams.{
				textDocument = LspTextDocumentIdentifier.{ uri = uri_filepath },
				position     = LspPosition.{
					line      = data.cursor.row,
					character = data.cursor.col,
				},
			};
			err = write_request(job, if data.kind == .DECLARATION then "textDocument/declaration" else "textDocument/definition", id, params);
		}

		.switch_header_source {
			data :: &request.data.switch_header_source;
			uri_filepath :: new_url_from_filepath(data.filepath) catch return $;
			defer str_terminate(&uri_filepath);

			params :: LspTextDocumentIdentifier.{
				uri = uri_filepath,
			};
			err = write_request(job, "textDocument/switchSourceHeader", id, params);
		}

		.completion {
			data :: &request.data.completion;
			uri_filepath :: new_url_from_filepath(data.filepath) catch return $;
			defer str_terminate(&uri_filepath);

			params :: LpsCompletionParams.{
				textDocument = .{
					uri = uri_filepath,
				},
				position = .{
					line      = data.cursor.row,
					character = data.cursor.col,
				},
				context = .{
					triggerKind = LSP_COMPLETION_KIND_INVOKED,
				}
			};
			err = write_request(job, "textDocument/completion", id, params);
		}

		.find_references {
			data :: &request.data.find_references;
			uri_filepath :: new_url_from_filepath(data.filepath) catch return $;
			defer str_terminate(&uri_filepath);

			params :: LpsReferencesParams.{
				textDocument = .{
					uri = uri_filepath,
				},
				position = .{
					line      = data.cursor.row,
					character = data.cursor.col,
				},
				context = .{
					includeDeclaration = true
				}
			};
			err = write_request(job, "textDocument/references", id, params);
		}

		.solution_open {
			data :: &request.data.solution_open;
			uri_filepath :: new_url_from_filepath(data.filepath) catch return $;
			defer str_terminate(&uri_filepath);

			err = write_request(job, "solution/open", id, LspSolutionOpenParams.{
					solution = uri_filepath,
				});
		}

		.pull_diagnostics {
			data :: &request.data.pull_diagnostics;
			uri_filepath :: new_url_from_filepath(data.filepath) catch return $;
			defer str_terminate(&uri_filepath);

			err = write_request(job, "textDocument/diagnostic", id, LspDocumentDiagnosticParams.{
					textDocument = .{
						uri = uri_filepath,
					},
				});
		}

		.signature_help {
			data :: &request.data.signature_help;
			uri_filepath :: new_url_from_filepath(data.filepath) catch return $;
			defer str_terminate(&uri_filepath);

			err = write_request(job, "textDocument/signatureHelp", id, LspSignatureHelpParams.{
					textDocument = .{
						uri = uri_filepath,
					},
					position = .{
						line      = data.cursor.row,
						character = data.cursor.col,
					},
				});
		}

		default {
			print_warn("Unknown request.");
			return OK;
		}
	}

	if !err {
		tbl_insert(&worker_context.pending, id, request);
	}

	return err;
}


PeekRpcKind :: enum { UNKNOWN; REQUEST; RESPONSE; NOTIFICATION; ERROR; }

peek_rpc_kind :: fn (json: JsonTokenizer) PeekRpcKind {
	tok :: next_token(&json);
	if tok.kind != .OBJECT_BEGIN then return .UNKNOWN;

	Flags :: enum #flags { HAS_ID; HAS_METHOD; HAS_ERROR; };
	using Flags;
	flags: Flags;

	loop {
		tok :: next_token(&json);
		if tok.kind == .OBJECT_END then break;
		if tok.kind != .STRING then break;

		if str_match(tok.as.str, "id") {
			flags |= HAS_ID;
		} else if str_match(tok.as.str, "method") {
			flags |= HAS_METHOD;
		} else if str_match(tok.as.str, "error") {
			flags |= HAS_ERROR;
		}

		val :: next_token(&json);
		if val.kind == .OBJECT_BEGIN then ignore_object(&json);
		if val.kind == .ARRAY_BEGIN  then ignore_array(&json);
	}

	if is_flag(flags, HAS_METHOD | HAS_ID) {
		return .REQUEST;
	}

	if is_flag(flags, HAS_METHOD) {
		return .NOTIFICATION;
	}

	if is_flag(flags, HAS_ERROR) {
		return .ERROR;
	}

	if is_flag(flags, HAS_ID) {
		return .RESPONSE;
	}

	return .UNKNOWN;
}

next_frame :: fn (job: *Job) (json: JsonTokenizer, err: Error) {
	MAX_FRAME_SIZE :: 1024*1024*32; // 32MB

	pipe_state :: poll_process(job) catch return .{}, $;
	if is_flag(pipe_state, .CLOSED) then return .{}, error("Pipe closed.");

	if is_flag(pipe_state, .READ_STDOUT) {

		buffer :: &worker_context.frame_buffer;
		read_pipe(job.stdout, buffer) catch return .{}, $;
		header_end :: str_find(@buffer, "\r\n\r\n");
		if header_end == -1 {
			return .{}, OK; // Wait
		}

		content_size : s64 = -1;
		{ // Parse header.
			data := Tokenizer.{ bytes = @buffer };
			property, value: string_view;
			if str_split_by_first(eat_line_and_trim_eol(&data), ' ', &property, &value) {
				if str_match(property, "Content-Length:") {
					content_size = strtos64(value) catch {
						return .{}, error("Cannot parse content size of the LSP response message!");
					};
				}
			}
			if content_size < 1 {
				return .{}, error("Invalid size of LSP response content!");
			}
		}

		content_offset :: header_end+4;
		frame_size     :: content_offset + content_size;
		if frame_size > MAX_FRAME_SIZE {
			return .{}, error("Maximum LSP response frame size %B reached!", MAX_FRAME_SIZE);
		}

		if buffer.len < frame_size {
			return .{}, OK; // Wait
		}

		// Chop the processed frame from the buffer.
		remaining :: buffer.len - frame_size;
		if remaining > 0 then memmove(buffer.ptr, &(@buffer)[frame_size], auto remaining);
		buffer.len = remaining;

		json :: JsonTokenizer.{
			bytes = .{ content_size, &(@buffer)[content_offset] }
		};

		return json, OK;
	}

	if is_flag(pipe_state, .READ_STDERR) {
		allocator :: application_context.temporary_allocator;
		buffer :: str_make(1024*8, allocator);

		read_pipe(job.stderr, &buffer) catch return .{}, $;
		print_err("LSP: %", buffer);
	}

	return .{}, OK;
}

write_request :: fn (job: *Job, method: string_view, id: s32, params: ?TParams) Error {
	rpc: RpcRequest(TParams) #noinit;
	rpc.jsonrpc = "2.0";
	rpc.id      = id;
	rpc.method  = method;
	rpc.params  = params;

	allocator :: application_context.temporary_allocator;
	json :: str_make(1024*8, allocator);
	serialize_object(rpc, &json);

	// print_log("LSP: >> %", json);
	write_pipe(job.stdin, tprint("Content-Length: %\r\n\r\n", json.len)) catch return $;
	return write_pipe(job.stdin, json);
}

write_notification :: fn (job: *Job, method: string_view, params: ?TParams) Error {
	rpc: RpcNotification(TParams) #noinit;
	rpc.jsonrpc = "2.0";
	rpc.method  = method;
	rpc.params  = params;

	allocator :: application_context.temporary_allocator;
	json :: str_make(1024*8, allocator);
	serialize_object(rpc, &json);

	// print_log("LSP: >> %", json);
	write_pipe(job.stdin, tprint("Content-Length: %\r\n\r\n", json.len)) catch return $;
	return write_pipe(job.stdin, json);
}

recv_response :: fn (job: *Job, json: JsonTokenizer) Error {
	header: struct { id: s32; };
	deserialize_object(header, json) catch return $;

	request, found :: tbl_lookup(&worker_context.pending, header.id);
	if !found {
		print_warn("LSP: Received response with unknown ID.");
		return OK;
	}

	defer msq.terminate_message(request);
	defer tbl_erase(&worker_context.pending, header.id);

	allocator :: application_context.temporary_allocator;

	switch request.data.kind {
		.initialize {
			initialize_result: RpcResponse(LspInitializeResult);
			deserialize_object(initialize_result, json) catch return $;

			flavor :: request.data.initialize.flavor;
			capabilities :: &initialize_result.result.capabilities;

			// @Incomplete 2026-02-10: Read available features from init response.
			features: LspFeatures;
			switch capabilities.textDocumentSync.kind {
				.options {
					opt :: &capabilities.textDocumentSync.options;
					features.document_open_close = opt.openClose;
					features.document_sync_kind  = opt.change;
				}
				.sync_kind {
					features.document_sync_kind = capabilities.textDocumentSync.sync_kind;
				}
			}

			switch capabilities.declarationProvider.kind {
				.boolean {
					features.goto_declaration = capabilities.declarationProvider.boolean;
				}
				.options {
					features.goto_declaration = capabilities.declarationProvider.options.workDoneProgress;
				}
			}

			switch capabilities.definitionProvider.kind {
				.boolean {
					features.goto_definition = capabilities.definitionProvider.boolean;
				}
				.options {
					features.goto_definition = capabilities.definitionProvider.options.workDoneProgress;
				}
			}

			switch capabilities.referencesProvider.kind {
				.boolean {
					features.find_references = capabilities.referencesProvider.boolean;
				}
				.options {
					features.find_references = capabilities.referencesProvider.options.workDoneProgress;
				}
			}


			switch flavor {
				.GENERIC {
				}
				.CLANGD {
					features.clang_header_switch = true;
					features.auto_diagnostics    = true;
				}
				.ROSLYN {
				}
			}

			response :: msq.make_message(LspResponse, job.worker_to_main);
			server_name :: str_make(initialize_result.result.serverInfo.name, response.allocator);
			if server_name.len == 0 {
				str_append(&server_name, LspServerDefaultName[auto flavor]);
			}

			set_variant(&response.data, .initialize, .{
					server_name = server_name,
					features    = features,
				});
			msq.post(response) catch {
				msq.terminate_message(response);
				return error("LSP: Failed to post message.");
			};
			print_log("LSP: Initialized with: %", initialize_result);
		}

		.goto {
			// Again, there are ofc multiple ways this shit can be represented, we currently support only
			// single value and array... Trying the array first...

			first_location: LspLocation;

			{
				goto_result: RpcResponse([]LspLocation);
				err := deserialize_object(goto_result, json);
				reset_json(&json);
				if err {
					goto_result: RpcResponse(LspLocation);
					err            = deserialize_object(goto_result, json);
					first_location = goto_result.result;
				} else if goto_result.result.len > 0 {
					first_location = goto_result.result[0];
				}
				if err then return err;
			}


			if first_location.uri.len == 0 {
				print_warn("LSP: Declaration not found.");
			} else {
				response :: msq.make_message(LspResponse, job.worker_to_main);
				filepath :: new_filepath_from_url(first_location.uri, response.allocator) catch {
					msq.terminate_message(response);
					return $;
				};

				set_variant(&response.data, .goto, .{
						cursor              = Cursor.{ row = first_location.range.start.line, col = first_location.range.start.character },
						filepath            = filepath,
						buffer_index        = request.data.goto.buffer_index,
						open_in_other_split = request.data.goto.open_in_other_split,
					});
				msq.post(response) catch {
					msq.terminate_message(request);
					return error("LSP: Failed to post message.");
				};
			}
		}

		.switch_header_source {
			switch_result: RpcResponse(string_view);
			deserialize_object(switch_result, json) catch return $;

			if switch_result.result.len == 0 {
				print_warn("LSP: Other file not found.");
			} else {
				response :: msq.make_message(LspResponse, job.worker_to_main);
				filepath :: new_filepath_from_url(switch_result.result, response.allocator) catch {
					msq.terminate_message(response);
					return $;
				};

				set_variant(&response.data, .switch_header_source, .{
						filepath            = filepath,
						buffer_index        = request.data.switch_header_source.buffer_index,
						open_in_other_split = request.data.switch_header_source.open_in_other_split,
					});
				msq.post(response) catch {
					msq.terminate_message(request);
					return error("LSP: Failed to post message.");
				};
			}
		}

		.completion {
			items: []LspCompletionItem;
			is_complete := true;

			// This is again MS bullshit, ill defined API...
			{
				completion_result: RpcResponse(LspCompletionList);
				err := deserialize_object(completion_result, json);
				reset_json(&json);

				if err {
					completion_result: RpcResponse([]LspCompletionItem);
					err        = deserialize_object(completion_result, json);
					items      = completion_result.result;
					reset_json(&json);
				} else {
					items       = completion_result.result.items;
					is_complete = completion_result.result.isComplete;
				}

				if err then return err;
			}

			response :: msq.make_message(LspResponse, job.worker_to_main);

			response_items: [..]CompletionItem;
			array_init(&response_items, 64, response.allocator);

			loop i := 0; i < items.len; i += 1 {
				item :: &items[i];
				symbol := item.filterText;
				if symbol.len == 0 then symbol = item.label;
				if symbol.len == 0 then continue;

				if symbol.len > 0 {
					response_item :: array_push(&response_items);
					title :: str_make(symbol.len, response.allocator);
					json_source_to_str(&title, trim_left(symbol, " "));

					response_item.symbol = title;
					response_item.kind   = item.kind;
				}
			}

			set_variant(&response.data, .completion, .{
					buffer_index = request.data.completion.buffer_index,
					items        = response_items,
					cursor       = request.data.completion.cursor,
					is_complete  = is_complete,
				});

			msq.post(response) catch {
				msq.terminate_message(request);
				return error("LSP: Failed to post message.");
			};
		}

		.find_references {
			references_response: RpcResponse([]LspLocation);
			deserialize_object(references_response, json) catch return $;

			if references_response.result.len < 1 {
				print_warn("Symbol not found.");
				return OK;
			}

			sort(references_response.result, &fn (a: *LspLocation, b: *LspLocation) bool {
					uri_cmp :: str_compare(a.uri, b.uri);
					if uri_cmp != 0 then return uri_cmp < 0;

					// same file -> sort by position
					if a.range.start.line != b.range.start.line {
						return a.range.start.line > b.range.start.line;
					}
					return a.range.start.character > b.range.start.character;
				});

			// Temporary pool to handle file contents.
			pool :: pool_make();
			defer release_allocator(&pool);

			prev_file_uri: string_view;
			text: string_view;
			index := 0;
			line  := 0;

			cwd :: get_cwd();
			defer str_terminate(&cwd);

			response :: msq.make_message(LspResponse, job.worker_to_main);
			result :: str_make(1024*8, response.allocator);

			filepath: string;

			loop i := 0; i < references_response.result.len; i += 1 {
				hit :: &references_response.result[i];
				target_line :: hit.range.start.line;

				if !str_match(prev_file_uri, hit.uri) {
					prev_file_uri = hit.uri;

					f :: new_filepath_from_url(hit.uri, allocator) catch continue;
					filepath = f;

					reset_allocator(&pool);
					t :: read_entire_file(filepath, &pool) catch continue; // @Performance
					text  = t;
					index = 0;
					line  = 0;
				}

				loop ; index < text.len; index += get_character_len(text[index]) {
					if text[index] == '\n' then line += 1;
					if line > target_line {
						break;
					}
				}

				code :: expand_position_to_whole_line(text, index, 250);
				relative_path :: absolute_path_to_relative(filepath, cwd);
				str_concat(&result, relative_path, ":" , hit.range.start.line+1, ":", hit.range.start.character+1, ":\t", code, "\n");

				index += get_character_len(text[index]);
			}

			set_variant(&response.data, .find_references, .{
					buffer_index = request.data.find_references.buffer_index,
					result       = result,
				});

			msq.post(response) catch {
				msq.terminate_message(request);
				return error("LSP: Failed to post message.");
			};
		}

		.solution_open {
			lsp.roslyn_solution_load_in_progress = false;
		}

		.pull_diagnostics {
			diag_result: RpcResponse(LspFullDocumentDiagnosticReport);
			deserialize_object(diag_result, json) catch return $;

			if str_match(diag_result.result.kind, "full") {
				push_diagnostic_response(job, request.data.pull_diagnostics.filepath, diag_result.result.items, request.data.pull_diagnostics.version) catch {
					return $;
				};
			}
		}

		.signature_help {
			help: RpcResponse(LspSignatureHelp);
			deserialize_object(help, json) catch return $;

			response   :: msq.make_message(LspResponse, job.worker_to_main);
			signatures :: help.result.signatures;

			overloads: [..]string;
			array_init(&overloads, signatures.len, response.allocator);

			// signature_index :: help.result.activeSignature;

			loop i := 0; i < signatures.len; i += 1 {
				overload :: str_make(signatures[i].label.len, response.allocator);
				json_source_to_str(&overload, signatures[i].label);
				array_push(&overloads, overload);
			}

			set_variant(&response.data, .signature_help, .{
					overloads    = overloads,
					buffer_index = request.data.signature_help.buffer_index,
					cursor       = request.data.signature_help.cursor,
				});
			msq.post(response) catch {
				msq.terminate_message(request);
				return error("LSP: Failed to post message.");
			};
		}

		default {
			assert(false, "Unhandled LSP response kind!");
		}
	}

	return OK;
}

recv_notification :: fn (job: *Job, json: JsonTokenizer) Error {
	header: struct { method: string_view; };
	deserialize_object(header, json) catch return $;

	allocator :: application_context.temporary_allocator;

	switch str_hash(header.method) {
		str_hash#("textDocument/publishDiagnostics") {
			if !settings.show_lsp_inline_diagnostics then return OK;

			dia_result: RpcRequest(LspPublishDiagnosticsParams);
			deserialize_object(dia_result, json) catch return $;

			filepath :: new_filepath_from_url(dia_result.params.uri, allocator) catch return $;
			push_diagnostic_response(job, filepath, dia_result.params.diagnostics, dia_result.params.version) catch return $;
			return OK;
		}

		str_hash#("window/logMessage") {
			log_message: RpcRequest(LspLogMessage);
			deserialize_object(log_message, json) catch return $;

			switch log_message.params.type {
				1 { print_warn("LSP: %", log_message.params.message); } // Print errors as warnings.
				2 { print_warn("LSP: %", log_message.params.message); }
				3 { print_info("LSP: %", log_message.params.message); }
				default {
					print_log("LSP: %", log_message.params.message);
				}
			}
		}

		default; // Unsupported, maybe report?
	}

	return OK;
}

recv_error :: fn (json: JsonTokenizer) Error {
	lsp_error: LspError;
	deserialize_object(lsp_error, json) catch {
		print_err("LSP: %", $);
		return OK;
	};

	print_err("LSP: %", lsp_error.error.message);

	request, found :: tbl_lookup(&worker_context.pending, lsp_error.id);
	if !found then return OK;

	defer msq.terminate_message(request);
	defer tbl_erase(&worker_context.pending, lsp_error.id);

	// Return errors only when they are fatal...
	switch request.data.kind {
		.initialize {
			return error("LSP: Initialization failed. Process will stop. See the messages for more info.");
		}
		.solution_open {
			lsp.roslyn_solution_load_in_progress = false;
		}
		default;
	}

	return OK;
}

push_diagnostic_response :: fn (job: *Job, filepath: string_view, items: []LspDiagnostic, file_version: s32) Error {
	using msq;
	response :: make_message(LspResponse, job.worker_to_main);

	result: [..]ErrorLocation;
	array_init(&result, LSP_MAX_DIAG_MESSAGE_COUNT, response.allocator);

	loop i := 0; i < items.len; i += 1 {
		d :: &items[i];

		// Limit to some maximum value...
		if result.len+1 > LSP_MAX_DIAG_MESSAGE_COUNT then break;

		kind: ErrorLocation.kind;
		if d.severity == 1 {
			kind = .ERROR;
		} else if d.severity == 2 {
			kind = .WARNING;
		} else {
			continue;
		}

		message :: str_make(d.message.len, response.allocator);
		json_source_to_str(&message, d.message);

		array_push(&result, .{
				kind    = kind,
				message = message,
				line    = d.range.start.line,
				col     = d.range.start.character,
			});
	}

	set_variant(&response.data, .publish_diagnostics, .{
			filepath  = str_make(filepath, response.allocator),
			version   = file_version,
			items     = result,
		});

	post(response) catch {
		terminate_message(response);
		return error("LSP: Failed to post message.");
	};
	return OK;
}

//
// JSON bullshit
//

TAG_JSON_ENCODE       : u64 : 1<<0;
TAG_JSON_EMPTY_OBJECT : u64 : 1<<1;
TAG_JSON_POLY         : u64 : 1<<2;
TAG_JSON_INLINE       : u64 : 1<<3;

serialize_object :: fn (obj: Any, json: *string) {
	info :: cast(*TypeInfoStruct) obj.type_info;
	assert(info.kind == TypeKind.STRUCT);

	str_append(json, "{");
	loop i := 0; i < info.members.len; i += 1 {
		m :: &info.members[i];
		src :: ptr_shift_bytes(obj.data, m.offset_bytes);

		str_append(json, "\"");
		str_append(json, m.name);
		str_append(json, "\":");

		if m.tag == TAG_JSON_EMPTY_OBJECT {
			str_append(json, "{}");
			if i + 1 < info.members.len then str_append(json, ",");
			continue;
		}

		if m.base_type == typeinfo(s32) {
			tmp :: cast(*s32) src;
			str_append(json, @tmp);
		} else if m.base_type == typeinfo(string_view) {
			tmp :: @(cast(*string_view) src);

			if is_flag(m.tag, TAG_JSON_INLINE) {
				str_append(json, tmp);
			} else {
				str_append(json, "\"");
				if (m.tag & TAG_JSON_ENCODE) == TAG_JSON_ENCODE {
					// This is crazy bullshit, thank you json...
					start := 0;
					len   := 0;
					loop j := 0; j < tmp.len; j += 1 {
						c :: tmp[j];
						replacement: string_view;
						switch c {
							'\n' { replacement = "\\n";  }
							'\r' { replacement = "\\r";  }
							'\"' { replacement = "\\\""; }
							'\t' { replacement = "\\t";  }
							'\\' { replacement = "\\\\"; }
							default;
						}
						if replacement.len > 0 {
							str_append(json, string_view.{ len, &tmp[start] });
							str_append(json, replacement);
							start = j + 1;
							len   = 0;
							continue;
						}
						len += 1;
					}

					if len > 0 { str_append(json, string_view.{ len, &tmp[start] }); }
				} else {
					str_append(json, tmp);
				}
				str_append(json, "\"");
			}
		} else if m.base_type == typeinfo(bool) {
			tmp :: @(cast(*bool) src);
			if tmp { str_append(json, "true"); }
			else { str_append(json, "false");  }
		} else if m.base_type.kind == TypeKind.STRUCT {
			info :: cast(*TypeInfoStruct) m.base_type;
			if info.is_slice {
				arr :: cast(*[]u8) src;
				elem_type_ptr :: cast(*TypeInfoPtr) info.members[1].base_type;
				assert(elem_type_ptr.kind == TypeKind.PTR);
				elem_type :: elem_type_ptr.pointee_type;
				elem_size :: elem_type.size_bytes;

				str_append(json, "[");
				loop i := 0; i < arr.len; i += 1 {
					tmp :: Any.{ elem_type, ptr_shift_bytes(arr.ptr, cast(s64) elem_size * cast(s64) i) };
					serialize_object(tmp, json);
					if i + 1 < arr.len { str_append(json, ","); }
				}
				str_append(json, "]");

			} else {
				tmp :: Any.{ m.base_type, src };
				serialize_object(tmp, json);
			}
		} else {
			panic("Unsupported type for JSON serialization: %.", @m.base_type);
		}
		if i + 1 < info.members.len then str_append(json, ",");
	}
	str_append(json, "}");
}

Tokenizer     :: TokenizerBase;
JsonTokenizer :: TokenizerBase;

Token :: struct {
	kind: enum {
		EOF;
		INVALID;

		STRING;
		NUMBER;
		FLOAT;
		BOOL;
		ARRAY_BEGIN;
		ARRAY_END;
		OBJECT_BEGIN;
		OBJECT_END;

		NULL;
	};

	as: union {
		n:   s32;
		f:   f32;
		str: string_view;
		b:   bool;
	};
}

reset_json :: fn (json: *JsonTokenizer) #inline {
	json.index = 0;
}

// Use temporary allocator to hold data.
deserialize_object :: fn (obj: Any, json: JsonTokenizer) Error #inline {
	return _deserialize_object(obj, &json, true);
}

// We suppose the input json is valid!
_deserialize_object :: fn (obj: Any, json: *JsonTokenizer, top_level := true) Error {
	using Token.kind;

	find_member :: fn (base_ptr: *u8, info: *TypeInfoStruct, name: string_view) (info: *TypeInfoStructMember, ptr: *u8) #inline {
		member: *TypeInfoStructMember;
		loop i := 0; i < info.members.len; i += 1 {
			m :: &info.members[i];
			if str_match(m.name, name) {
				member = m;
				break;
			}
		}
		if !member { return null, null; }
		return member, ptr_shift_bytes(base_ptr, member.offset_bytes);
	};

	info :: cast(*TypeInfoStruct) obj.type_info;
	if (info.kind != TypeKind.STRUCT || info.is_slice == true) then return error("Not an object.");

	if top_level {
		tok_obj_start :: next_token(json);
		if tok_obj_start.kind != OBJECT_BEGIN {
			return error("Expected begin of the object got '%'!", tok_obj_start.kind);
		}
	}

	loop {
		ident: string_view;
		tok_ident :: next_token(json);
		switch tok_ident.kind {
			OBJECT_END { break; }
			STRING     { ident = tok_ident.as.str; }
			default    { return error("Expected value identificator got '%'!", tok_ident.kind); }
		}

		member_info, member_ptr :: find_member(obj.data, info, ident);
		tmp: Any;

		if member_info && is_flag(member_info.tag, TAG_JSON_POLY) {
			assert(member_info.base_type.kind == .STRUCT);
			variants, kind_offset :: get_poly_variant_types(member_info.base_type);

			json_restore :: @json;
			variant_index := 0;

			loop ; variant_index < variants.len; variant_index += 1 {
				@json = json_restore;
				tmp = .{
					type_info = variants[variant_index].base_type,
					data      = member_ptr,
				};

				deserialize_value(ident, tmp, json) catch continue;
				kind_ptr :: cast(*s32)(cast(usize)member_ptr + kind_offset);
				@kind_ptr = variant_index;
				break;
			}
			if variant_index == variants.len then return error("No suitable poly variant type found for '%'.", ident);
			continue;
		}

		if member_info {
			tmp.type_info = member_info.base_type;
			tmp.data      = member_ptr;
		}

		deserialize_value(ident, tmp, json) catch return $;
	}

	return OK;
}

deserialize_array :: fn (ident: string_view, arr: Any, json: *JsonTokenizer) Error {
	ARRAY_CHUNK_SIZE : usize : 64;
	allocator :: application_context.temporary_allocator;

	using Token.kind;
	info :: cast(*TypeInfoStruct) arr.type_info;
	if !(info.kind == TypeKind.STRUCT && info.is_slice == true) then return error("Not an array.");

	elem_type_ptr :: cast(*TypeInfoPtr) info.members[1].base_type;
	assert(elem_type_ptr.kind == TypeKind.PTR);

	elem_type      :: elem_type_ptr.pointee_type;
	elem_size      :: elem_type.size_bytes;
	elem_alignment :: elem_type.alignment;

	dest := cast(*[]u8) arr.data;
	assert(dest.len == 0);

	allocated : usize = 0;

	loop i : usize = 0;; i += 1 {
		if i == allocated {
			new_allocated :: math.max(ARRAY_CHUNK_SIZE, allocated * 2);
			mem, err :: realloc(dest.ptr, elem_size * new_allocated, elem_alignment, allocator);
			if err { return err; }
			allocated = new_allocated;
			dest.ptr = mem;
		}

		tmp :: Any.{ elem_type, ptr_shift_bytes(dest.ptr, auto (elem_size * cast(usize) i)) };
		zeromem(tmp.data, elem_size);
		is_arr_end :: deserialize_value(ident, tmp, json, true) catch return $;
		if is_arr_end { break; }
		dest.len += 1;
	}
	return OK;
}

deserialize_value :: fn (ident: string_view, val: Any, json: *JsonTokenizer, is_array := false) (is_end_of_array: bool, err: Error) {
	using Token.kind;

	tok_value :: next_token(json);
	member_info :: val.type_info;
	member_ptr  :: val.data;

	switch tok_value.kind {
		STRING {
			if member_info {
				if member_info != typeinfo(string_view) { return false, error("Invalid type of '%' value, expected string got %.", ident, member_info.kind); }
				memcpy(member_ptr, auto &tok_value.as.str, sizeof(string_view));
			}
		}
		BOOL {
			if member_info {
				if member_info != typeinfo(bool) { return false, error("Invalid type of '%' value, expected boolean got %.", ident, member_info.kind); }
				memcpy(member_ptr, auto &tok_value.as.b, sizeof(bool));
			}
		}

		NUMBER {
			if member_info {
				if member_info.kind != .ENUM && member_info != typeinfo(s32) {
					return false, error("Invalid type of '%' value, expected number got %.", ident, member_info.kind);
				}
				memcpy(member_ptr, auto &tok_value.as.n, sizeof(s32));
			}
		}

		FLOAT {
			if member_info {
				if member_info != typeinfo(f32) { return false, error("Invalid type of '%' value, expected float got %.", ident, member_info.kind); }
				memcpy(member_ptr, auto &tok_value.as.f, sizeof(f32));
			}
		}

		OBJECT_BEGIN {
			if !member_info {
				ignore_object(json) catch return false, $;
			} else {
				tmp :: Any.{ member_info, member_ptr };
				_deserialize_object(tmp, json, false) catch {
					return false, error("Parsing of member '%' failed.", ident);
				};
			}
		}
		ARRAY_BEGIN {
			if !member_info {
				ignore_array(json) catch return false, $;
			} else {
				tmp :: Any.{ member_info, member_ptr };
				deserialize_array(ident, tmp, json) catch return false, $;
			}
		}
		ARRAY_END {
			if !is_array { return false, error("Unexpected array end!"); }
			return true, OK;
		}

		NULL {}

		default {
			return false, error("Expected value of the entry '%' got '%'!", ident, tok_value.kind);
		}
	}

	return false, OK;
}

get_poly_variant_types :: fn (info: *TypeInfo) (variants: []TypeInfoStructMember, kind_offset: usize) #inline {
	assert(info.kind == .STRUCT);
	poly_info  :: cast(*TypeInfoStruct) info;
	members    :: poly_info.members;
	union_info :: cast(*TypeInfoStruct) members[0].base_type;
	return union_info.members, auto members[1].offset_bytes;
}

ignore_object :: fn (json: *JsonTokenizer) Error {
	using Token.kind;
	nesting := 1;
	loop {
		tok :: next_token(json);
		switch tok.kind {
			OBJECT_BEGIN { nesting += 1; }
			OBJECT_END {
				nesting -= 1;
				if nesting == 0 { break; }
			}
			EOF { return error("Unterminated object!"); }
			default;
		}
	}
	return OK;
}

ignore_array :: fn (json: *JsonTokenizer) Error {
	using Token.kind;
	nesting := 1;
	loop {
		tok :: next_token(json);
		switch tok.kind {
			ARRAY_BEGIN { nesting += 1; }
			ARRAY_END {
				nesting -= 1;
				if nesting == 0 { break; }
			}
			EOF { return error("Unterminated array!"); }
			default;
		}
	}
	return OK;
}

next_token :: fn (job: *JsonTokenizer) Token {
	using Token.kind;

	parse_bool :: fn (job: *JsonTokenizer, t: *Token) bool {
		if str_match(string_view.{ 4, &job.bytes[job.index] }, "true") {
			t.kind     = Token.kind.BOOL;
			t.as.b   = true;
			job.index += 4;
			return true;
		}
		if str_match(string_view.{ 5, &job.bytes[job.index] }, "false") {
			t.kind     = Token.kind.BOOL;
			t.as.b   = false;
			job.index += 5;
			return true;
		}
		return false;
	};

	parse_null :: fn (job: *JsonTokenizer, t: *Token) bool {
		if str_match(string_view.{ 4, &job.bytes[job.index] }, "null") {
			t.kind     = Token.kind.NULL;
			job.index += 4;
			return true;
		}
		return false;
	};

	parse_number :: fn (job: *JsonTokenizer, t: *Token) bool {
		using Token.kind;
		start_index :: job.index;
		len := 0;
		is_float := false;
		loop ; job.index < job.bytes.len; job.index += 1 {
			c :: job.bytes[job.index];
			if is_digit(c) == false && c != '-' && c != '.' {
				break;
			}
			if c == '.' {
				is_float = true;
			}
			len += 1;
		}

		if len == 0 { return false; }
		if is_float {
			t.kind = FLOAT;
			f, err :: strtof64(string_view.{ len, &job.bytes[start_index] });
			if !err {
				t.as.f = auto f;
			}
		} else {
			t.kind = NUMBER;
			n, err :: strtos64(string_view.{ len, &job.bytes[start_index] });
			if !err {
				t.as.n = auto n;
			}
		}

		return true;
	};

	loop job.index < job.bytes.len {
		eat_whitespace(job);
		t := Token.{
			kind  = INVALID,
		};

		c :: job.bytes[job.index];
		if c == ',' || c == ':' || c == '\n' || c == '\r' {
			job.index += 1;
			continue;
		}
		if c == '{' {
			t.kind = OBJECT_BEGIN;
			job.index += 1;
			return t;
		}
		if c == '}' {
			t.kind = OBJECT_END;
			job.index += 1;
			return t;
		}
		if c == '[' {
			t.kind = ARRAY_BEGIN;
			job.index += 1;
			return t;
		}
		if c == ']' {
			t.kind = ARRAY_END;
			job.index += 1;
			return t;
		}
		if c == '\"' {
			t.kind = STRING;
			str :: eat_string_in_quotes(job, true);
			t.as.str = str;
			return t;
		}
		if parse_bool(job, &t)   { return t; }
		if parse_number(job, &t) { return t; }
		if parse_null(job, &t)   { return t; }

		return t;
	}

	return Token.{ kind = EOF };
}

json_source_to_str :: fn (dest: *string, src: string_view) {
	if src.len == 0 then return;

	start := 0;
	len   := 0;

	str_reserve(dest, src.len);
	loop j := 0; j < src.len; {
		replacement: u8;
		sub :: string_view.{ 2, &src[j] };
		if str_match(sub, "\\n") {
			replacement = '\n';
		} else if str_match(sub, "\\r") {
			replacement = '\r';
		} else if str_match(sub, "\\\"") {
			replacement = '\"';
		} else if str_match(sub, "\\t") {
			replacement = '\t';
		} else if str_match(sub, "\\\\") {
			replacement = '\\';
		}

		if replacement != 0 {
			str_append(dest, string_view.{ len, &src[start] });
			str_append(dest, string_view.{ 1, &replacement });
			j += 2;
			start = j;
			len   = 0;
			continue;
		}

		// Unicode escape: \uXXXX
		if j + 5 < src.len && src[j] == '\\' && src[j+1] == 'u' {
			code :: slice_range(src, j+2, j+6);
			n, err :: strtos64(code, FmtIntBase.HEX);
			if !err {
				code :: cast(u32) n;
				str_append(dest, string_view.{ len, &src[start] });
				str_append(dest, unicode_char_to_utf8_with_fallback(code, ""));
				j    += 6;
				start = j;
				len   = 0;
			}
		}

		len += 1;
		j   += 1;
	}

	if len > 0 { str_append(dest, string_view.{ len, &src[start] }); }
}

//
// LSP Objects
//

LspDiagnosticClientCapabilities :: struct {
	dynamicRegistration: bool;
}

LspTextDocumentClientCapabilities :: struct {
	diagnostic: LspDiagnosticClientCapabilities;
}

LspDidChangeConfigurationClientCapabilities :: struct {
	dynamicRegistration: bool;
}

LspClientCapabilities :: struct {
	textDocument: LspTextDocumentClientCapabilities;
	workspace: struct {
		configuration: bool;
		didChangeConfiguration: LspDidChangeConfigurationClientCapabilities;
	};
}

LspInitialize :: struct {
	rootUri: string_view;
	capabilities: LspClientCapabilities;
	initializationOptions: string_view #tag TAG_JSON_INLINE;
}

LspTextDocumentItem :: struct {
	uri:        string_view;
	languageId: string_view;
	version:    s32;
	text:       string_view #tag TAG_JSON_ENCODE;
}

LspDidOpenTextDocumentParams :: struct {
	textDocument: LspTextDocumentItem;
}

LspDidCloseTextDocumentParams :: struct {
	textDocument: LspTextDocumentIdentifier;
}

LspTextDocumentIdentifier :: struct {
	uri: string_view;
}

LspVersionedTextDocumentIdentifier :: struct {
	uri: string_view;
	version: s32;
}

LspDidChangeTextDocumentParamsIncremental :: struct {
	textDocument:     LspVersionedTextDocumentIdentifier;
	contentChanges: []LspTextDocumentContentChangeEventIncremental;
}

LspDidChangeTextDocumentParamsFull :: struct {
	textDocument:     LspVersionedTextDocumentIdentifier;
	contentChanges: []LspTextDocumentContentChangeEventFull;
}

LspDidSaveTextDocumentParams :: struct {
	textDocument: LspTextDocumentIdentifier;
}

LspTextDocumentContentChangeEventIncremental :: struct {
	range: LspRange;
	text:  string_view #tag TAG_JSON_ENCODE;
}

LspTextDocumentContentChangeEventFull :: struct {
	text:  string_view #tag TAG_JSON_ENCODE;
}

LspPosition :: struct {
	line: s32;
	character: s32;
}

LspRange :: struct {
	end:   LspPosition;
	start: LspPosition;
}

LspLocation :: struct {
	uri: string_view;
	range: LspRange;
}

LspTextDocumentPositionParams :: struct {
	textDocument: LspTextDocumentIdentifier;
	position:     LspPosition;
}

LSP_COMPLETION_KIND_INVOKED :: 1 #maybe_unused;
LSP_COMPLETION_KIND_TRIGGER_CHARACTER :: 2 #maybe_unused;

LspCompletionContext :: struct {
	triggerKind:  s32;
}

LpsCompletionParams :: struct {
	textDocument: LspTextDocumentIdentifier;
	position:     LspPosition;
	context:      LspCompletionContext;
}

LpsReferencesParams :: struct {
	textDocument: LspTextDocumentIdentifier;
	position:     LspPosition;
	context:      LspReferenceContext;
}

RpcResponse :: fn (TResponse: type #comptime) type #comptime {
	return struct {
		jsonrpc: string_view;
		id:      s32;
		result:  TResponse;
	};
}

RpcRequest :: fn (TParams: type #comptime) type #comptime {
	return struct {
		jsonrpc: string_view;
		id:      s32;
		method:  string_view;
		params:  TParams;
	};
}

RpcNotification :: fn (TParams: type #comptime) type #comptime {
	return struct {
		jsonrpc: string_view;
		method:  string_view;
		params:  TParams;
	};
}

LspInitializeResult :: struct {
	capabilities: LspServerCapabilities;
	serverInfo: struct {
		name:    string_view;
		version: string_view;
	}
}

LspTextDocumentSyncKind :: enum {
	NONE        = 0;
	FULL        = 1;
	INCREMENTAL = 2;
}

LspTextDocumentSyncOptions :: struct {
	openClose: bool;
	change: LspTextDocumentSyncKind;
}

LspDeclarationOptions :: struct {
	workDoneProgress: bool;
}

LspDefinitionOptions :: struct {
	workDoneProgress: bool;
}

LspReferenceOptions :: struct {
	workDoneProgress: bool;
}

LspServerCapabilities :: struct {
	completionProvider:  LspCompletionOptions;
	referencesProvider:  Variant(union {
			boolean: bool;
			options: LspReferenceOptions;
		}) #tag TAG_JSON_POLY;
	textDocumentSync:    Variant(union {
			sync_kind: LspTextDocumentSyncKind;
			options:   LspTextDocumentSyncOptions;
		}) #tag TAG_JSON_POLY;
	declarationProvider: Variant(union {
			boolean: bool;
			options: LspDeclarationOptions;
		}) #tag TAG_JSON_POLY;
	definitionProvider: Variant(union {
			boolean: bool;
			options: LspDefinitionOptions;
		}) #tag TAG_JSON_POLY;
}

LspCompletionOptions :: struct {
	triggerCharacters: []string_view;
	resolveProvider:   bool;
}

LspDiagnostic :: struct {
	code:     string_view;
	message:  string_view;
	range:    LspRange;
	severity: s32;
	source:   string_view;
}

LspPublishDiagnosticsParams :: struct {
	diagnostics: []LspDiagnostic;
	uri:           string_view;
	version:       s32;
}

LspFullDocumentDiagnosticReport :: struct {
	kind: string_view;
	items: []LspDiagnostic;
}

LspError :: struct {
	jsonrpc: string_view;
	id:      s32;
	error: struct {
		code:    s32;
		message: string_view;
	};
}

LspTextEdit :: struct {
	range:   LspRange;
	newText: string_view;
}

LspCompletionItem :: struct {
	detail:           string_view;
	filterText:       string_view;
	insertText:       string_view;
	insertTextFormat: s32;
	kind:             s32;
	label:            string_view;
	score:            f32;
	textEdit:         LspTextEdit;
}

LspCompletionList :: struct {
	isComplete: bool;
	items:    []LspCompletionItem;
}

LspLogMessage :: struct {
	type: s32;
	message: string_view;
}

LspReferenceContext :: struct {
	includeDeclaration: bool;
}

LspMarkupContent :: struct {
	kind:  string_view;
	value: string_view;
}

LspDocumentDiagnosticParams :: struct {
	textDocument: LspTextDocumentIdentifier;
}

LspSignatureHelpParams :: struct {
	textDocument: LspTextDocumentIdentifier;
	position:     LspPosition;
}

LspSolutionOpenParams :: struct {
	solution: string_view;
}

LspSignatureInformation :: struct {
	label:         string_view;
	documentation: Variant(union { text: string_view; markup: LspMarkupContent }) #tag TAG_JSON_POLY;
}

LspSignatureHelp :: struct {
	signatures:    []LspSignatureInformation;
	activeSignature: s32;
	activeParameter: s32;
}

