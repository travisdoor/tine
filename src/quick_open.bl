quick_open_mode_init :: fn () {
	activate_command_editor();
	buf :: get_active_buffer_and_editor();
	clear_buffer(buf);

	input_mode               = InputMode.TEXT;
	notify_changes_to_buffer = buf.index;

	warn_if_no_project_open();

	list_project();
}

quick_open_mode_terminate :: fn () {}

draw_quick_open_mode :: fn () {
	if atomic.load(&project.is_indexing) {
		print_warn(PROJECT_IS_INDEXING_MESSAGE);
		set_mode(Mode.TEXT_EDIT);
		return;
	}

	clicked := false;

	search_list_begin(.{}); {

		draw_search_command_editor(.{
				title = "Search file...",
			});

		clicked = draw_search_simple_list();

		draw_search_hints([_]PanelHint.{
				.{
					command = .INSERT_NEW_LINE,
					info    = "open"
				},
				.{
					command = .CANCEL_MODE,
					info    = "cancel"
				},
				.{
					command = .MOVE_DOWN,
					info    = "next",
				},
				.{
					command = .MOVE_UP,
					info    = "prev",
				},
			});

	} search_list_end();

	if clicked then commit();
}

//
// Commands
//

invoke_command_quick_open_mode :: fn (buf: *Buffer #maybe_unused, cmd: Command) bool {
	assert(workspace.active_editor == workspace.command_editor);
	assert(editors[workspace.active_editor].buffer_index == buf.index);

	using Command;

	switch cmd {
		INSERT_NEW_LINE { commit(); }

		MOVE_UP   { list_item_up();   }
		MOVE_DOWN { list_item_down(); }

		// Not handled.
		default { return false; }
	}

	return true;
}

quick_open_cmd_changed :: fn () {
	buf :: get_active_buffer_and_editor();
	user_path :: peek_row(buf, 0);
	if user_path.len == 0 {
		clear_list_filters();
		return;
	}

	filter_list(user_path);
}

#scope_private

commit :: fn () {
	item :: get_selected_item_in_list();
	if !item { return; }

	set_mode(Mode.TEXT_EDIT);
	if item.index != 0 {
		activate_buffer_editor(item.index, get_active_split());
	} else {
		path :: tprint("%/%", item.hint, item.title);
		err :: open(path, get_active_split());
		if err { print_err(err); }
	}
}
