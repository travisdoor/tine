draw_cheat_sheet_mode :: fn () {
	list :: [_]SectionOrCommand.{
		make_section("General"),
		make_command(.RUN_COMMAND),
		make_command(.CHEAT_SHEET),
		make_command(.CANCEL_MODE),
		make_command(.OTHER_SPLIT),
		make_section("File navigation"),
		make_command(.OPEN_FILE),
		make_command(.OPEN_PROJECT),
		make_command(.QUICK_OPEN),
		make_command(.PREV_LOCATION),
		make_command(.NEXT_LOCATION),
		make_section("Edditing"),
		make_command(.SMART_SELECTION),
		make_command(.CENTER_VIEW),
		make_command(.TOGGLE_COMMENT),
		make_command(.UNDO),
		make_command(.REDO),
		make_section("Search"),
		make_command(.SEARCH_FILE),
		make_command(.SEARCH_IN_PROJECT),
		make_section("LSP"),
		make_command(.LSP_COMPLETION),
		make_command(.LSP_REFERENCES),
		make_command(.LSP_GOTO_DEFINITION),
	};

	draw_body(list);
}

#private

SectionOrCommand :: Variant(union {
		section: string_view;
		command: Command;
	});

make_section :: fn (text: string_view) SectionOrCommand #inline {
	item: SectionOrCommand;
	set_variant(&item, .section, text);
	return item;
}

make_command :: fn (cmd: Command) SectionOrCommand #inline {
	item: SectionOrCommand;
	set_variant(&item, .command, cmd);
	return item;
}

draw_body :: fn (list: []SectionOrCommand) {
	padding_x   :: metrics.item_spacing;
	rounding    :: metrics.corner_rounding_panel;
	line_height :: metrics.line_ui_height * 2.f;
	padding_y   :: math.round(padding_x * 0.5f);

	w :: math.round(math.min(font_ui.height * 45.f, cast(f32) WINDOW_WIDTH * 0.8f));
	h := padding_y * 2.f;

	loop i := 0; i < list.len; i += 1 {
		h += line_height;
	}

	x :: math.round((cast(f32) WINDOW_WIDTH  - w) * 0.5f);
	y :: math.round((cast(f32) WINDOW_HEIGHT - h) * 0.5f);

	draw_panel_body(x, y, w, h, rounding);

	tx := x + padding_x;
	ty := y + padding_y;
	tw :: w - padding_x * 2.f;

	loop i := 0; i < list.len; i += 1 {
		item :: &list[i];
		switch item.kind {
			.section {
				draw.set_scissor(x, y, tw, h);
				defer draw.clear_scissor();
				defer draw.flush();

				draw.set_shader_font(&font_ui_b);
				draw.text(tx, ty + font_centered_in(line_height, &font_ui_b), item.section, colors.foreground);
			}

			.command {
				draw_command_panel_hint(tx, ty, tw, line_height, .{
						key_mapping = get_keybinding_for_command(item.command),
						info        = COMMAND_HELP[auto item.command]
					});
			}
		}

		ty += line_height;
	}
}
