highlight_syntax_csharp :: fn (buf: *Buffer) {
	reset_buffer_syntax(buf);

	ctx :: Tokenizer.{
		base = TokenizerBase.{
			bytes = buf.bytes,
		},
	};

	insert_all(&ctx.keyword_table,   KEYWORDS);
	insert_all(&ctx.directive_table, DIRECTIVES);

	indentation_nesting := 0;

	loop {
		using Token.kind;

		token :: next_token(&ctx);
		switch token.kind {
			EOF { break; }
			LB  {
				indentation_nesting += 1;
				array_push(&buf.indent, Indent.{ .OPEN, token.index, indentation_nesting });
			}
			RB  {
				indentation_nesting -= 1;
				array_push(&buf.indent, Indent.{ .CLOSE, token.index, indentation_nesting });
			}

			default;
		}

		if token.len > 0 {
			memset(&buf.colors[token.index], kind_to_color(token.kind), auto token.len);
		}
	}

	tbl_terminate(&ctx.keyword_table);
	tbl_terminate(&ctx.directive_table);
}

#scope_private

kind_to_color :: fn (kind: Token.kind) u8 #inline {
	using Token.kind;
	switch kind {
		INVALID   { return CODE_COLOR_INVALID_INDEX;   }
		IDENT     { return CODE_COLOR_DEFAULT_INDEX;   }
		KEYWORD   { return CODE_COLOR_KEYWORD_INDEX;   }
		COMMENT   { return CODE_COLOR_COMMENT_INDEX;   }
		DIRECTIVE { return CODE_COLOR_DIRECTIVE_INDEX; }
		STRING    { return CODE_COLOR_STRING_INDEX;    }
		NUMBER    { return CODE_COLOR_NUMBER_INDEX;    }
		LB, RB    { return CODE_COLOR_KEYWORD_INDEX;   }
		default;
	}
	return CODE_COLOR_DEFAULT_INDEX;
}

Tokenizer :: struct #base TokenizerBase {
	keyword_table:   Table(string_view, u8); // We need set!
	directive_table: Table(string_view, u8);
}

Token :: struct {
	kind: enum u8 {
		EOF = -1;

		INVALID;
		IDENT;
		KEYWORD;
		COMMENT;
		DIRECTIVE;
		STRING;
		NUMBER;
		LB;
		RB;
	};

	index: s32;
	len:   s32;
}

KEYWORDS :: [123]string_view.{
	// Reserved keywords
	"abstract","as","base","bool","break","byte","case","catch","char","checked","class","const",
	"continue","decimal","default","delegate","do","double","else","enum","event","explicit","extern",
	"false","finally","fixed","float","for","foreach","goto","if","implicit","in","int","interface",
	"internal","is","lock","long","namespace","new","null","object","operator","out","override","params",
	"private","protected","public","readonly","ref","return","sbyte","sealed","short","sizeof","stackalloc",
	"static","string","struct","switch","this","throw","true","try","typeof","uint","ulong","unchecked",
	"unsafe","ushort","using","virtual","void","volatile","while",

	// Contextual keywords
	"add","allows","alias","and","ascending","args","async","await","by","descending","dynamic","equals",
	"extension","field","file","from","get","global","group","init","into","join","let","managed","nameof",
	"nint","not","notnull","nuint","on","or","orderby","partial","record","remove","required","scoped",
	"select","set","unmanaged","value","var","when","where","with","yield"
};

KEYWORDS_MAX_LEN :: max_len#(KEYWORDS.ptr, KEYWORDS.len);

DIRECTIVES :: [13]string_view.{
	"define", "undef", "if", "elif", "else", "endif", "warning", "error", "line", "region", "endregion", "pragma", "nullable"
};

DIRECTIVES_MAX_LEN :: max_len#(DIRECTIVES.ptr, DIRECTIVES.len);

next_token :: fn (ctx: *Tokenizer) Token {
	using Token.kind;

	loop ctx.index < ctx.bytes.len {
		eat_whitespace(ctx);
		t :: Token.{
			kind  = EOF,
			index = ctx.index,
		};

		if parse_block(ctx, &t, '{', .LB) then return t;
		if parse_block(ctx, &t, '}', .RB) then return t;
		if parse_block(ctx, &t, '(', .LB) then return t;
		if parse_block(ctx, &t, ')', .RB) then return t;
		if parse_c_like_comment(ctx, &t) then return t;
		if parse_c_like_string(ctx, &t, '\"') then return t;
		if parse_c_like_string(ctx, &t, '\'') then return t;
		if parse_c_like_directive(ctx, &t, '#', &ctx.directive_table, DIRECTIVES_MAX_LEN, .DIRECTIVE, .IDENT) then return t;
		if parse_c_like_keyword(ctx, &t, &ctx.keyword_table, KEYWORDS_MAX_LEN, .KEYWORD, .IDENT) then return t;
		if parse_c_like_number(ctx, &t) then return t;

		ctx.index += 1;
	}

	return Token.{ kind = EOF };
}

