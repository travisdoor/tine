highlight_syntax_jai :: fn (buf: *Buffer) {
	reset_buffer_syntax(buf);

	ctx :: Tokenizer.{
		base = TokenizerBase.{
			bytes = buf.bytes,
		},
	};

	insert_all(&ctx.keyword_table,  KEYWORDS);
	insert_all(&ctx.typename_table, TYPENAMES);
	insert_all(&ctx.builtin_table,  BUILTINS);

	indentation_nesting := 0;

	loop {
		using Token.kind;

		token :: next_token(&ctx);
		switch token.kind {
			EOF { break; }
			LB  {
				indentation_nesting += 1;
				array_push(&buf.indent, Indent.{ .OPEN, token.index, indentation_nesting });
			}
			RB  {
				indentation_nesting -= 1;
				array_push(&buf.indent, Indent.{ .CLOSE, token.index, indentation_nesting });
			}

			default;
		}

		if token.len > 0 {
			memset(&buf.colors[token.index], kind_to_color(token.kind), auto token.len);
		}
	}

	tbl_terminate(&ctx.keyword_table);
	tbl_terminate(&ctx.typename_table);
	tbl_terminate(&ctx.builtin_table);
}

#scope_private

kind_to_color :: fn (kind: Token.kind) u8 #inline {
	using Token.kind;
	switch kind {
		INVALID   { return CODE_COLOR_INVALID_INDEX;   }
		IDENT     { return CODE_COLOR_DEFAULT_INDEX;   }
		KEYWORD   { return CODE_COLOR_KEYWORD_INDEX;   }
		TYPENAME  { return CODE_COLOR_KEYWORD_INDEX;   }
		BUILTIN   { return CODE_COLOR_DEFAULT_INDEX;   }
		COMMENT   { return CODE_COLOR_COMMENT_INDEX;   }
		DIRECTIVE { return CODE_COLOR_DIRECTIVE_INDEX; }
		NOTE      { return CODE_COLOR_DIRECTIVE_INDEX; }
		STRING    { return CODE_COLOR_STRING_INDEX;    }
		CONST     { return CODE_COLOR_NUMBER_INDEX;    }
		NUMBER    { return CODE_COLOR_NUMBER_INDEX;    }
		LB, RB    { return CODE_COLOR_KEYWORD_INDEX;   }
		default;
	}
	return CODE_COLOR_DEFAULT_INDEX;
}

Tokenizer :: struct #base TokenizerBase {
	keyword_table:  Table(string_view, u8);
	typename_table: Table(string_view, u8);
	builtin_table:  Table(string_view, u8);
}

Token :: struct {
	kind: enum u8 {
		EOF = -1;

		INVALID;
		IDENT;
		KEYWORD;
		TYPENAME;
		BUILTIN;
		COMMENT;
		DIRECTIVE;
		NOTE;
		STRING;
		CONST;
		NUMBER;
		LB;
		RB;
	};

	index: s32;
	len:   s32;
}

KEYWORDS :: [_]string_view.{
	"if", "ifx", "else", "then", "while", "for", "switch", "case", "struct", "enum",
	"return", "remove", "continue", "break", "defer", "inline", "no_inline",
	"using", "code_of", "initializer_of", "size_of", "type_of", "cast", "type_info",
	"null", "true", "false", "xx", "context", "operator", "push_context", "is_constant",
	"enum_flags", "union", "interface"
};
KEYWORDS_MAX_LEN :: max_len#(KEYWORDS.ptr, KEYWORDS.len);

TYPENAMES :: [_]string_view.{
	"int", "u64", "u32", "u16", "u8",
	"s64", "s32", "s16", "s8", "float",
	"float32", "float64", "string", "bool"
};
TYPENAMES_MAX_LEN :: max_len#(TYPENAMES.ptr, TYPENAMES.len);

BUILTINS :: [_]string_view.{ "it", "it_index" };
BUILTINS_MAX_LEN :: max_len#(BUILTINS.ptr, BUILTINS.len);

next_token :: fn (ctx: *Tokenizer) Token {
	loop ctx.index < ctx.bytes.len {
		eat_whitespace(ctx);
		t :: Token.{
			kind  = .EOF,
			index = ctx.index,
		};

		c :: ctx.bytes[ctx.index];
		if c == '{'         && parse_left_brace  (ctx, &t) { return t; }
		if c == '}'         && parse_right_brace (ctx, &t) { return t; }
		if c == '/'         && parse_comment     (ctx, &t) { return t; }
		if c == '#'         && parse_directive   (ctx, &t) { return t; }
		if c == '@'         && parse_note        (ctx, &t) { return t; }
		if c == '\"'        && parse_string      (ctx, &t) { return t; }
		if c == '-'         && parse_uninit      (ctx, &t) { return t; }
		if c == '\''        && parse_const_char  (ctx, &t) { return t; }
		if parse_identifier_or_keyword           (ctx, &t) { return t; }
		if parse_number                          (ctx, &t) { return t; }

		ctx.index += 1;
	}

	return Token.{ kind = .EOF };
}

parse_left_brace :: fn (ctx: *Tokenizer, t: *Token) bool {
	ctx.index += 1;
	t.kind = .LB;
	t.len  = 1;
	return true;
}

parse_right_brace :: fn (ctx: *Tokenizer, t: *Token) bool {
	ctx.index += 1;
	t.kind = .RB;
	t.len  = 1;
	return true;
}

parse_comment :: fn (ctx: *Tokenizer, t: *Token) bool {
	ctx.index += 1;

	c := ctx.bytes[ctx.index];
	switch c {
		'/' {
			ctx.index += 1;
			loop ctx.index < ctx.bytes.len {
				c = ctx.bytes[ctx.index];
				if c == '\n' || c == 0 then break;
				t.len     += 1;
				ctx.index += 1;
			}
			t.len += 2; // '//'
		}
		'*' {
			ctx.index += 1;
			t.len     += 2;

			depth := 1;
			loop ctx.index < ctx.bytes.len && depth > 0 {
				c = ctx.bytes[ctx.index];
				if c == 0 then break;

				if c == '/' && ctx.index+1 < ctx.bytes.len && ctx.bytes[ctx.index+1] == '*' {
					depth     += 1;
					t.len     += 2;
					ctx.index += 2;
					continue;
				}

				if c == '*' && ctx.index+1 < ctx.bytes.len && ctx.bytes[ctx.index+1] == '/' {
					depth     -= 1;
					t.len     += 2;
					ctx.index += 2;
					continue;
				}

				t.len     += 1;
				ctx.index += 1;
			}
		}
		default {
			ctx.index -= 1;
			return false;
		}
	}

	t.kind = .COMMENT;
	return true;
}

parse_string :: fn (ctx: *Tokenizer, t: *Token) bool {
	if ctx.index > 0 && ctx.bytes[ctx.index-1] == '\\' { return false; }
	t.kind     = .STRING;
	t.len     += 1; // "
	ctx.index += 1;

	pc := '0';

	in_string := true;
	loop in_string && ctx.index < ctx.bytes.len {
		c :: ctx.bytes[ctx.index];
		if c == '\"' && (pc != '\\') {
			in_string = false;
		}
		t.len     += 1;
		ctx.index += 1;
		pc = c;
	}

	return true;
}

parse_directive :: fn (ctx: *Tokenizer, t: *Token) bool {
	ctx.index += 1;
	t.len  = 1;

	loop ctx.index < ctx.bytes.len {
		c :: ctx.bytes[ctx.index];
		if c != '_' && is_alpha(c) == false { break; }
		t.len     += 1;
		ctx.index += 1;
	}

	if t.len == 1 {
		ctx.index -= 1;
		t.len     -= 1;
		return false;
	}

	t.kind = .DIRECTIVE;
	return true;
}

parse_note :: fn (ctx: *Tokenizer, t: *Token) bool {
	ctx.index += 1;
	t.len  = 1;

	loop ctx.index < ctx.bytes.len {
		c :: ctx.bytes[ctx.index];
		if c != '_' && is_alpha(c) == false { break; }
		t.len     += 1;
		ctx.index += 1;
	}

	if t.len == 1 {
		ctx.index -= 1;
		t.len     -= 1;
		return false;
	}

	t.kind = .NOTE;
	return true;
}

parse_uninit :: fn (ctx: *Tokenizer, t: *Token) bool {
	if ctx.index+2 >= ctx.bytes.len { return false; }
	if ctx.bytes[ctx.index+1] != '-' || ctx.bytes[ctx.index+2] != '-' { return false; }

	t.kind     = .CONST;
	t.len      = 3;
	ctx.index += 3;
	return true;
}

parse_const_char :: fn (ctx: *Tokenizer, t: *Token) bool {
	if ctx.index+1 >= ctx.bytes.len { return false; }

	c :: ctx.bytes[ctx.index+1];
	if c != '_' && is_alpha(c) == false { return false; }

	t.kind     = .CONST;
	t.len      = 1;
	ctx.index += 1;

	loop ctx.index < ctx.bytes.len {
		cc :: ctx.bytes[ctx.index];
		if cc != '_' && is_alpha(cc) == false && is_digit(cc) == false { break; }
		t.len     += 1;
		ctx.index += 1;
	}

	return true;
}

parse_identifier_or_keyword :: fn (ctx: *Tokenizer, t: *Token) bool {
	is_type_sigil := false;
	if ctx.bytes[ctx.index] == '^' || ctx.bytes[ctx.index] == '$' {
		is_type_sigil = true;
		t.len     += 1;
		ctx.index += 1;
	}

	loop ctx.index < ctx.bytes.len {
		c :: ctx.bytes[ctx.index];
		if c == '_' || is_alpha(c) || (t.len > 0 && is_digit(c)) {
			t.len     += 1;
			ctx.index += 1;
		} else {
			break;
		}
	}

	if t.len == 0 { return false; }
	if is_type_sigil && t.len == 1 {
		t.kind = .TYPENAME;
		return true;
	}

	if is_type_sigil {
		t.kind = .TYPENAME;
		return true;
	}

	maybe_keyword :: string_view.{ t.len, &ctx.bytes[t.index] };
	if maybe_keyword.len <= KEYWORDS_MAX_LEN && tbl_contains(&ctx.keyword_table, maybe_keyword) {
		t.kind = .KEYWORD;
	} else if maybe_keyword.len <= TYPENAMES_MAX_LEN && tbl_contains(&ctx.typename_table, maybe_keyword) {
		t.kind = .TYPENAME;
	} else if maybe_keyword.len <= BUILTINS_MAX_LEN && tbl_contains(&ctx.builtin_table, maybe_keyword) {
		t.kind = .BUILTIN;
	} else {
		t.kind = .IDENT;
	}
	return true;
}

parse_number :: fn (ctx: *Tokenizer, t: *Token) bool {
	c    := ctx.bytes[ctx.index];
	dot  := false;
	base := FmtIntBase.DEC;

	if c != '-' && is_digit(c) == false { return false; }
	t.kind = .NUMBER;

	if c == '-' {
		if ctx.index+1 >= ctx.bytes.len {
			return false;
		}
		if is_digit(ctx.bytes[ctx.index+1]) == false {
			return false;
		}
		t.len     += 1;
		ctx.index += 1;
	}

	c = ctx.bytes[ctx.index];
	if c == '0' {
		base = .OCT;

		ctx.index += 1;
		t.len     += 1;

		if ctx.index < ctx.bytes.len {
			c = ctx.bytes[ctx.index];
			switch c {
				'b' { base = .BIN; ctx.index += 1; t.len += 1; }
				'x', 'h' { base = .HEX; ctx.index += 1; t.len += 1; }
				default;
			}
		}
	}

	loop ctx.index < ctx.bytes.len {
		c = ctx.bytes[ctx.index];

		if c == '_' { // digit separator
			t.len     += 1;
			ctx.index += 1;
			continue;
		}

		if dot == false && c == '.' {
			dot        = true;
			t.len     += 1;
			ctx.index += 1;
			continue;
		}

		if !is_digit(c, base) {
			break;
		}
		t.len     += 1;
		ctx.index += 1;
	}

	return true;
}