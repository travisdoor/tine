shell_run_mode_init :: fn () {
	activate_command_editor();

	buf :: get_active_buffer_and_editor();
	clear_buffer(buf);

	input_mode               = InputMode.TEXT;
	notify_changes_to_buffer = buf.index;

	list_shell_entries();
}

shell_run_mode_terminate :: fn () {
	str_terminate(&run_item_hint);
}

draw_shell_run_mode :: fn () {
	clicked := false;

	search_list_begin(); {
		draw_search_command_editor(.{
				title = "Run shell command...",
				icon  = icon(ICON_SHELL),
			});

		clicked = draw_search_simple_list();

		draw_search_hints([_]PanelHint.{
				.{
					command = .INSERT_NEW_LINE,
					info    = "run"
				},
				.{
					command = .CANCEL_MODE,
					info    = "cancel"
				},
				.{
					command = .MOVE_DOWN,
					info    = "next",
				},
				.{
					command = .MOVE_UP,
					info    = "prev",
				},
				.{
					command = .BUILD,
					info    = "insert build command",
				},
			});
	} search_list_end();

	if clicked {
		set_current_item_as_caption();
		commit();
	}
}

//
// Commands
//

invoke_command_shell_run_mode :: fn (buf: *Buffer #maybe_unused, cmd: Command) bool {
	assert(workspace.active_editor == workspace.command_editor);
	assert(editors[workspace.active_editor].buffer_index == buf.index);

	using Command;

	switch cmd {
		INSERT_NEW_LINE { commit(); }

		MOVE_UP   {
			if is_current_selected_same_as_command() then list_item_up();
			set_current_item_as_caption();
		}

		MOVE_DOWN {
			if is_current_selected_same_as_command() then list_item_down();
			set_current_item_as_caption();
		}

		BUILD {
			if !warn_build_command_missing() {
				clear_buffer(buf);
				insert_string(buf, 0, settings.build_command);
			}
		}

		default { return false; }
	}

	return true;
}

shell_run_cmd_changed :: fn () {
	buf :: get_active_buffer_and_editor();
	cmd :: peek_row(buf, 0);
	if cmd.len == 0 {
		clear_list_filters();
		return;
	}

	run_item_hint.len = 0;
	str_append(&run_item_hint, cmd);

	implicit_items :: [1]ListItem.{
		.{
			title = "Run",
			hint  = run_item_hint,
			icon  = icon(ICON_PLAY),
			index = RUN_ITEM_INDEX,
			flags = .HIGHLIGHT,
		},
	};

	filter_list(cmd, implicit_items);
}

#scope_private

RUN_ITEM_INDEX :: -1;

run_item: ListItem;
run_item_hint: string;

commit :: fn () {
	buf :: get_active_buffer_and_editor();

	item :: get_selected_item_in_list();
	if !item then return;
	set_mode(Mode.TEXT_EDIT);

	cmd := peek_row(buf, 0).text;
	if cmd.len == 0 {
		cmd = item.title;
	}

	trim_chars :: " \t";
	cmd = trim_right(trim_left(cmd, trim_chars), trim_chars);
	if cmd.len == 0 then return;

	request_shell_execute(cmd) catch {
		print_err($);
		return;
	};

	add_shell_entry(cmd);
}

is_current_selected_same_as_command :: fn () bool {
	item :: get_selected_item_in_list();
	if !item then return false;

	if item.index == RUN_ITEM_INDEX {
		return true;
	}

	buf :: get_active_buffer_and_editor();
	current_cmd := peek_row(buf, 0);

	cmd :: item.title;
	return str_match(current_cmd, cmd);
}

set_current_item_as_caption :: fn () {
	item :: get_selected_item_in_list();
	if !item then return;

	cmd := item.title;
	if item.index == RUN_ITEM_INDEX {
		cmd = item.hint;
	}

	buf :: get_active_buffer_and_editor();
	notify_changes_to_buffer = -1;
	clear_buffer(buf);
	insert_string(buf, 0, cmd);
	notify_changes_to_buffer = buf.index;
}

