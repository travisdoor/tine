open_project_mode_init :: fn () {
	activate_command_editor();

	buf :: get_active_buffer_and_editor();
	clear_buffer(buf);

	input_mode               = InputMode.TEXT;
	notify_changes_to_buffer = buf.index;

	list_projects();
}

open_project_mode_terminate :: fn () {}

draw_open_project_mode :: fn () {
	clicked := false;

	search_list_begin(.{}); {

		draw_search_command_editor(.{
				title = "Search project...",
			});

		clicked = draw_search_simple_list();

		draw_search_hints([_]PanelHint.{
				.{
					command = .INSERT_NEW_LINE,
					info    = "open"
				},
				.{
					command = .CANCEL_MODE,
					info    = "cancel"
				},
				.{
					command = .MOVE_DOWN,
					info    = "next",
				},
				.{
					command = .MOVE_UP,
					info    = "prev",
				},
			});

	} search_list_end();

	if clicked then commit();
}

//
// Commands
//

invoke_command_open_project_mode :: fn (buf: *Buffer #maybe_unused, cmd: Command) bool {
	assert(workspace.active_editor == workspace.command_editor);
	assert(editors[workspace.active_editor].buffer_index == buf.index);

	using Command;

	switch cmd {
		INSERT_NEW_LINE { commit(); }

		MOVE_UP   { list_item_up();   }
		MOVE_DOWN { list_item_down(); }

		default { return false; }
	}

	return true;
}

open_project_cmd_changed :: fn () {
	buf :: get_active_buffer_and_editor();
	cmd :: peek_row(buf, 0);
	if cmd.len == 0 {
		clear_list_filters();
		return;
	}

	filter_list(cmd);
}

#scope_private

commit :: fn () {
	item :: get_selected_item_in_list();
	if !item { return; }

	set_mode(Mode.TEXT_EDIT);
	err :: open_project(tprint("%/%/%.proj", data_dir, PROJECTS_DIRECTORY, item.title));
	if err { print_err(err); }
}

