# Default configuration file for Tine text editor.

# This configuration is used as a default "project" file in case no other project is loaded. The
# actual user/project configuration files might override some of these settings.
#
# The configuration is split into sections, each section starts by ;section-name tag.
#----------------------------------------------------------------------------------------------------
;include
#----------------------------------------------------------------------------------------------------
# List of directories included into the project. The first one is supposed to be a project root and
# is used as a current working directory.
# Each directory path entry is supposed to be on a separate line and may contain spaces.
#
# Example:
#   C:/my/project/root

#----------------------------------------------------------------------------------------------------
;exclude
#----------------------------------------------------------------------------------------------------
# List of directories excluded from the project.
# Each directory path entry is supposed to be on a separate line and may contains spaces.
# .svn
# .git
# .cache
# .vs
# .vscode

#----------------------------------------------------------------------------------------------------
;include_file_extensions
#----------------------------------------------------------------------------------------------------
# Files with these extensions will be included into the project as editable ones and visible
# in a quick file search. Each extension is supposed to be separated by space and starting
# with '.' character.
#
# Example:
#   .bl .txt .cpp .h

#----------------------------------------------------------------------------------------------------
;settings
#----------------------------------------------------------------------------------------------------
font_size                              13
font_ui_size                           12

# Line spacing as a percentage of the current font size. Supported range is <80, 200>.
line_spacing                           100

# Customize editor font, default system font location is used for lookup of the ttf font
# files. Full path can be used too.
# font                                   font-name.ttf

# Customize path to clang-format executable, otherwise editor tries to search the executable in
# system PATH.
# clang_format_executable                C:/Program Files/LLVM/bin/clang-format.exe

# Enable word wrap by default.
word_wrap true

#----------------------------------------------------------------------------------------------------
# LSP
#----------------------------------------------------------------------------------------------------

# Start LSP server automatically if available.
use_lsp                                false

# Show inline hints from the LSP diagnostics.
show_lsp_inline_diagnostics            true

# Customize path to LSP server executable, otherwise editor tries to search the executable in system PATH.
# lsp_executable                         clangd.exe

# Customize arguments passed into 'lsp_executable'.
# lsp_args                               -j=8 -background-index --log=error --enable-config --offset-encoding=utf-32 --header-insertion=never --function-arg-placeholders=true

# LSP server kind specification, possible values are: generic, clangd, roslyn. This value is used to handle server-specific requirements.
# lsp_flavor                             clangd

# Specify file type used by LSP. Possible values are: bl, c (same for c++), proj, md, glsl, asm, csharp, blm, zig, jai.
# lsp_file_type                          c

# Can be used with roslyn LSP to specify path to C# solution file. Must be used together with 'lsp_flavor' set to 'roslyn'.
# lsp_roslyn_solution                    solution.sln

# Example LSP setup for C/C++
# use_lsp                                true
# lsp_executable                         clangd.exe
# lsp_args                               -j=8 -background-index --log=error --enable-config --offset-encoding=utf-32 --header-insertion=never --function-arg-placeholders=true
# lsp_file_type                          c
# lsp_flavor                             clangd

# Example LSP setup for C#
# use_lsp                                true
# lsp_executable                         "C:/Users/<your name>/.vscode/extensions/ms-dotnettools.csharp-2.140.9-win32-x64/.roslyn/Microsoft.CodeAnalysis.LanguageServer.exe"
# lsp_args                               --stdio --logLevel Information --autoLoadProjects
# lsp_file_type                          csharp
# lsp_flavor                             roslyn
# lsp_roslyn_solution                    C:/path/foo.sln

#----------------------------------------------------------------------------------------------------
# Shell
#----------------------------------------------------------------------------------------------------

# Customize shell command. Command line arguments including the shell executable used when 'shell' or
# 'build' editor commands are invoked.
# The shell executable (or full path) should be the first followed by optional arguments passed directly
# to the shell.
# Requested shell command is later passed into the running shell via pipe.
#
# Default values are:
# - Windows: CMD.exe
# - MacOS:   /bin/zsh
# - Linux:   /bin/bash
#
# Examples:
# shell                                  pwsh -c "-"
# shell                                  CMD.exe /Q /K prompt $
# shell                                  C:/Program\ Files/Git/bin/bash.exe
# shell                                  /bin/fish
# shell                                  /bin/bash --login

# Enable internal parsing of clang/cl or similar error and warning locations in shell output. All file
# locations parsed from the output are available later in error list for quick navigation (used with
# 'next-error' and 'prev-error' commands).
shell_parse_error_locations            true

# Enable ANSI color codes in shell output.
shell_enable_ansi_colors               true

# Enable additional error or warning highlight in the shell output. This feature requires
# shell_parse_error_locations enabled.
shell_enable_error_location_colors     false

# Build command used when 'build' editor command is invoked, this entry is appended to the content of
# shell variable.
#
# Default values are:
# - Windows: build.bat
# - Other:   build.sh
#
# Examples:
# build_command                          make -j4
# build_command                          blc -build
# build_command                          ./build.ps1

#----------------------------------------------------------------------------------------------------
# MISC
#----------------------------------------------------------------------------------------------------

# Visual size of the tab character as if it was replaced by spaces. In case the
# 'insert_spaces_instead_tabs' is false this value is used as a count of spaces for
# indentation.
tab_size                               4

insert_spaces_instead_tabs             false

# Removes all trailing white spaces from the file on save.
trim_trailing_whitespace_on_save       false

# Enables auto indentation of pasted text.
indent_on_paste                        true

# Indents current line or selection when insert-tab command is executed; works as usual in
# case the current line is empty.
indent_on_tab                          true

# Insert indentation spaces to the buffer when new line is created.
indent_on_new_line                     true

# Applied for move-up and move-down commands; in case the cursor ends up in the indentation
# space of the current line, we try to move it right to the first non-whitespace character.
# This might reduce movement required to get the cursor to the useful content of the line.
vertical_move_tries_follow_indentation true

# Use large block caret when true.
block_caret                            true
# Change the caret in case the current editor is in selection mode.
change_caret_on_selection              true
# When enabled, selection becomes modal (similar to Emacs), you don't need to hold shift,
# you activate selection mode instead by 'set-selection-marker' or 'smart-selection' commands.
modal_selection                        false
maximize_on_start                      false
save_all_before_build                  true
# Focus the shell buffer automatically when build command is invoked. Otherwise compilation
# runs in background.
focus_shell_on_build                   true

# Enable smooth animated navigation.
smooth_movement                        true

# Line numbers
show_line_numbers                      false

# Allows a slightly modified behavior of the 'search-file' command. When the current editor is in
# selection mode, the selection is empty, and 'search-command' is activated, it starts in "quick"
# mode. In this mode, any character typed that exists in the file is immediately used for the
# search, the next match is accepted as a new cursor position, and search mode is automatically
# deactivated. This enables quick selection from the current cursor position to a desired character.
enable_quick_search                    true

# Recognize following file extensions as source files of given type.
c_extensions                           .c .cpp .h .hpp .cc
glsl_extensions                        .glsl
asm_extensions                         .asm

# Following regular expressions are used in various buffers to parse out file links which can
# be directly opened in the editor.
#
# Expected format is 'filepath[:line[:column]]'.
#
# In case file_link_regex has match, the file_location_regex is applied on the rest. The
# file_location_regex should contain two capture groups; first for the line number and optionally
# second for the column number.
parse_file_links    true
file_link_regex     (([a-zA-Z]:[\\\/]|\/|\.\/|\.\\|\.\.\/|[\w_]+\/)(?:[^\\\n]+\\)*[^\\\n^:]+(?:\.[a-zA-Z0-9]+))
file_location_regex :([0-9]*)(?::([0-9]*))?

# Files bigger than this limit will be excluded from the 'search-in-project'. Zero means no limit.
#search_size_limit_bytes 1048576
search_size_limit_bytes 0

# When enabled, file paths shown in search results are displayed relative to the project root (root directory
# itself is shown as "."). When disabled, full absolute paths are shown instead.
chop_root_dir_from_search_paths false

# Ctrl+Mouse Wheel change editor font size when enabled.
resize_font_by_scrolling true

# Vertical document scroll speed in range <1, 100>.
scroll_speed 10

#----------------------------------------------------------------------------------------------------
;keys
#----------------------------------------------------------------------------------------------------
# This section contains shortcuts for various commands in the editor.
# Expected format is:
#   command-name binding-one binding-two ... binding-N
#
# Examples:
#   open-project Ctrl+Shift+O Ctrl+O
#   copy         Alt+C
#   build        F4
#   delete-line  Ctrl+Backspace
#
# Default shortcuts are specified in the 'default.proj' file placed next to the editor executable.
# Each project can override shortcuts or unbind the command shortcut completely by leaving the
# key-combination section empty.
#
# Following example unbinds all shortcuts for command 'open-project':
#   open-project
#
# By default, list of all available commands in the editor can be shown by pressing Alt+X.

#----------------------------------------------------------------------------------------------------
# Navigation
#----------------------------------------------------------------------------------------------------
# Text navigation is based around JKL; keys (the home position on the keyboard).
move-right           ArrowRight      Ctrl+Semicolon     Shift+ArrowRight
move-left            ArrowLeft       Ctrl+J             Shift+ArrowLeft
move-down            ArrowDown       Ctrl+K             Shift+ArrowDown
move-up              ArrowUp         Ctrl+L             Shift+ArrowUp
jump-next-word       Ctrl+ArrowRight Ctrl+Alt+Semicolon Alt+Semicolon    Ctrl+Shift+ArrowRight
jump-prev-word       Ctrl+ArrowLeft  Ctrl+Alt+J         Alt+J            Ctrl+Shift+ArrowLeft
jump-next-paragraph  Ctrl+ArrowDown  Ctrl+Alt+K         Alt+K            Ctrl+Shift+ArrowDown
jump-prev-paragraph  Ctrl+ArrowUp    Ctrl+Alt+L         Alt+L            Ctrl+Shift+ArrowUp
jump-line-end        End             Ctrl+E             Shift+End
jump-indent-begin    Home            Ctrl+I             Shift+Home
jump-line-begin      Ctrl+B
jump-begin           Ctrl+Home       Ctrl+Alt+B         Alt+B            Ctrl+Shift+Home
jump-end             Ctrl+End        Ctrl+Alt+E         Alt+E            Ctrl+Shift+End
jump-page-up         PageUp          Shift+PageUp
jump-page-down       PageDown        Shift+PageDown
center-view          Ctrl+M
next-error           Ctrl+.
prev-error           Ctrl+,
next-location        Ctrl+]
prev-location        Ctrl+[
jump-next-block      Ctrl+Alt+]
jump-prev-block      Ctrl+Alt+[

#----------------------------------------------------------------------------------------------------
# Editing
#----------------------------------------------------------------------------------------------------
insert-new-line      Enter
insert-tab           Tab
delete-char-left     Backspace      Shift+Backspace
delete-char-right    Delete         Shift+Delete
delete-line          Ctrl+D
delete-word-left     Ctrl+Backspace Alt+Backspace
toggle-comment       Ctrl+/
duplicate-line       Ctrl+Shift+D

set-selection-marker
smart-selection      Alt+Space
copy                 Ctrl+C
paste                Ctrl+V
cut                  Ctrl+X
select-all           Ctrl+A

# Split
other-split          Alt+`
close-split          Alt+W
close-other-split    Ctrl+Alt+W

close-buffer         Ctrl+Q
close-editor         Alt+Q
force-close-buffer   Ctrl+Shift+Q
close-all-buffers
close-buffers-without-editor

save                 Ctrl+S
new-buffer           Ctrl+Alt+N
open-file            Ctrl+O
open-project         Ctrl+Shift+O

open-messages
open-shell           Ctrl+`
cheat-sheet          F1
help

quick-open           Ctrl+P
save-as              Ctrl+Shift+S
save-all             # No mapping
goto-line            Ctrl+G Alt+G
run-command          Alt+X
cancel-mode          Escape

search-file          Ctrl+F
search-in-project    Ctrl+Shift+F

# Works in the scope of search modes. Replace mode for the last search is activated.
search-replace       Ctrl+H

# Works in the scope of search modes. Opens search results in separate file buffer.
search-to-buffer     Ctrl+Enter

increase-font-size   Ctrl+=
decrease-font-size   Ctrl+-
undo                 Ctrl+Z
redo                 Ctrl+Y

clang-format          F3
build                 F4
open-in-visual-studio F5

# Remedy debugger support https://remedybg.itch.io/remedybg
debug-in-remedybg
open-in-remedybg
break-in-remedybg

# RAD Debugger support https://github.com/EpicGamesExt/raddebugger
debug-in-raddbg
open-in-raddbg
break-in-raddbg

peek-error            Alt+/
list-functions        Alt+F

# Macros
toggle-macro-recording Alt+R
replay-macro           F11

increase-number Alt+PageUp
decrease-number Alt+PageDown

# Repeat command mode is activated directly in case following modifier key is pressed in
# combination with number.
repeat Ctrl

shell Alt+C

# Toggle word wrapping.
toggle-wrap Alt+Z

toggle-line-numbers

# Quit the editor.
quit

#----------------------------------------------------------------------------------------------------
# LSP
#----------------------------------------------------------------------------------------------------

lsp-goto-definition              F12
lsp-references                   Shift+F12
lsp-goto-definition-other-split  Alt+F12
lsp-goto-declaration
lsp-goto-declaration-other-split
lsp-other-file                   Alt+O
lsp-other-file-other-split       Ctrl+Alt+O
lsp-completion                   Ctrl+Space

#----------------------------------------------------------------------------------------------------
