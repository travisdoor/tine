#scope_module

_Session :: struct {
	tty: C.pid_t;
	pid: C.pid_t;
}

_start :: fn (session: *Session, executable: string_view) Error {
	tty_path :: spawn_tty(session) catch return $;
	print_log("DBG: Terminal started.");

	launch_debuggee(session, tty_path, executable) catch return $;
	print_log("DBG: Debuggee started on pid: %.", session.pid);

	wait_for_stop(session) catch {
		_stop(session);
		return $;
	};

	regs :: get_regs(session) catch {
		_stop(session);
		return $;
	};

	print_log("Regs: %", regs);

	continue_execution(session) catch {
		_stop(session);
		return $;
	};

	return OK;
}

_stop :: fn (session: *Session) {
	C.kill(session.pid, C.SIGKILL);
	C.kill(session.tty, C.SIGKILL);
	session.pid = 0; // @Incomplete 2026-08-20: Maybe -1?
	session.tty = 0;
}

#scope_private

C  :: #import "libc";
io :: #import "std/io";
#import "os/linux/sys/ptrace"
#import "std/string"
#import "std/print"
#import "std/fs"

spawn_tty :: fn (session: *Session) (tty: string_view, err: Error) {
	dbg_tty_path :: get_fifo_name();
	if mkfifo(auto dbg_tty_path.ptr, 0600) == -1 {
		return "", os_get_last_error2();
	}
	defer C.unlink(auto dbg_tty_path.ptr);

	cmd :: tprint("tty > '%'; exec sleep infinity", dbg_tty_path);
	print_log("DBG: %", cmd);

	pid :: C.fork();
	if pid == -1 {
		return "", os_get_last_error2();
	}
	if pid == 0 {
		// child
		cargs: [6]*C.char;
		cargs[0] = strtoc("xterm"); // @Incomplete
		cargs[1] = strtoc("-e");
		cargs[2] = strtoc("sh");
		cargs[3] = strtoc("-c");
		cargs[4] = strtoc(cmd);
		cargs[5] = null;

		C.execv(strtoc("/usr/bin/xterm"), cargs.ptr);
		C.exit(127);
	}

	tty_file :: open_file(dbg_tty_path) catch {
		C.kill(pid, C.SIGTERM);
		return "", $;
	};
	defer close_file(&tty_file);

	tty := new_slice(u8, 256, true, application_context.temporary_allocator) catch {
		C.kill(pid, C.SIGTERM);
		return "", $;
	};
	tty.len = io.read(&tty_file, tty.ptr, tty.len) catch {
		C.kill(pid, C.SIGTERM);
		return "", $;
	};
	if tty.len > 0 && tty[tty.len-1] == '\n' then tty.len -= 1;
	if tty.len < 1 then {
		C.kill(pid, C.SIGTERM);
		return "", error("Cannot get tty file descriptor.");
	}

	session.tty = pid;

	print_log("DBG: Fifo pipe: %", tty);
	return tty, OK;
}

launch_debuggee :: fn (session: *Session, tty_path: string_view, executable: string_view) Error {
	pid :: C.fork();
	if pid == -1 {
		return os_get_last_error2();
	}
	if (pid == 0) {
		// child

		tty_file :: open_file(tty_path, OpenFileMode.READ | OpenFileMode.WRITE) catch C.exit(1);
		defer close_file(&tty_file);

		tty_fd :: tty_file.handle;

		setsid();
		C.ioctl(tty_fd, TIOCSCTTY, 0);
		tcsetpgrp(tty_fd, getpgrp());

		C.dup2(tty_fd, C.STDIN);
		C.dup2(tty_fd, C.STDOUT);
		C.dup2(tty_fd, C.STDERR);
		if tty_fd > 2 then close_file(&tty_file);

		cargs: [2]*C.char;
		cargs[0] = strtoc("Tine-Debug"); // @Incomplete
		cargs[1] = null;

		if ptrace(.PTRACE_TRACEME) == -1 {
			C.exit(1);
		}
		C.execv(strtoc(executable), cargs.ptr);
		C.exit(127);
	}

	session.pid = pid;
	return OK;
}

wait_for_stop :: fn (session: *Session) (status: s32, err: Error) {
	st: s32;
	if C.waitpid(session.pid, &st, 0) == -1 {
		return 0, os_get_last_error2();
	}
	return st, OK;
}

continue_execution :: fn (session: *Session) Error {
	if ptrace(.PTRACE_CONT, session.pid, 0, 0) == -1 {
		return os_get_last_error2();
	}
	return OK;
}

get_regs :: fn (session: *Session) (regs: UserRegs, err: Error) {
	regs: UserRegs;
	if ptrace(.PTRACE_GETREGS, session.pid, 0, auto &regs) == -1 {
		return regs, os_get_last_error2();
	}
	return regs, OK;
}

set_regs :: fn (session: *Session, regs: *UserRegs) Error {
	if ptrace(.PTRACE_SETREGS, session.pid, 0, auto regs) == -1 {
		return os_get_last_error2();
	}
	return OK;
}

// Utils

get_fifo_name :: fn () string_view {
	dbg_tty_path := str_make_temporary("/tmp/tine_dbg_tty_XXXXXX\0");
	dbg_tty_path.len -= 1;
	fd :: mkstemp(auto dbg_tty_path.ptr);
	C.close(fd);
	C.unlink(auto dbg_tty_path.ptr);

	return dbg_tty_path;
}

// Linux stuff...

// should match /usr/include/sys/user.h
UserRegs :: struct {
	r15: u64;
	r14: u64;
	r13: u64;
	r12: u64;
	rbp: u64;
	rbx: u64;
	r11: u64;
	r10: u64;
	r9: u64;
	r8: u64;
	rax: u64;
	rcx: u64;
	rdx: u64;
	rsi: u64;
	rdi: u64;
	orig_rax: u64;
	rip: u64;
	cs: u64;
	eflags: u64;
	rsp: u64;
	ss: u64;
	fs_base: u64;
	gs_base: u64;
	ds: u64;
	es: u64;
	fs: u64;
	gs: u64;
};

TIOCSCTTY :: 0x540E;

setsid  :: fn () C.pid_t #extern;
mkstemp :: fn (template: *C.char) C.pid_t #extern;
mkfifo :: fn (path: *C.char, mode: u16) s32 #extern;
tcsetpgrp :: fn (fd: s32, pgrp: C.pid_t) s32 #extern;
getpgrp :: fn () C.pid_t #extern;