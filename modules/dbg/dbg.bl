Session :: struct #base _Session {
	queue:      msg.Queue;
	thread:    *threading.Thread;
	thread_id:  u64;
};

session_start :: fn (session: *Session) #inline {
	zeroinit(session);

	msg.init(&session.queue);
	session.thread    = threading.spawn_with_context(session, &worker) catch panic($);
	session.thread_id = threading.get_thread_id(session.thread);
}

session_stop :: fn (session: *Session) #inline {
	message :: msg.make_message(Message, &session.queue);
	message.kind = .QUIT;
	msg.post_message(session.thread_id, message);

	threading.join(session.thread) catch panic($);
	threading.destroy(session.thread);
	msg.terminate(&session.queue);

	zeroinit(session);
}

start_process :: fn (session: *Session, executable: string_view) #inline {
	message :: msg.make_message(Message, &session.queue);
	message.kind = .START_PROCESS;
	message.as.start_process = .{
		executable = str_make(executable, message.allocator),
	};

	msg.post_message(session.thread_id, message);
}

stop_process :: fn (session: *Session) #inline {
	message :: msg.make_message(Message, &session.queue);
	message.kind = .STOP_PROCESS;
	msg.post_message(session.thread_id, message);
}

#scope_module

msg       :: #import "std/message_queue";
threading :: #import "std/thread2";

#import "std/string"

MessageKind :: enum {
	UNKNOWN;
	START_PROCESS;
	STOP_PROCESS;
	QUIT;
}

Message  :: struct #base msg.Message {
	kind: MessageKind;
	as: union {
		start_process: struct {
			executable: string_view;
		};
	};
}

worker :: fn (session: *Session) s32 {
	loop {
		message: *Message #noinit;
		if msg.poll_message_as(&session.queue, &message, true) {
			defer msg.terminate_message(message);

			switch message.kind {
				.START_PROCESS {
					_start(session, message.as.start_process.executable);
				}
				.STOP_PROCESS {
					_stop(session);
				}
				.QUIT {
					break;
				}
			}
		}

		temporary_reset();
	}

	return 0;
}